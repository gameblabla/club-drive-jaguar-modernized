+/* V31 observational runtime collision attribution, opt-in emulator-side only.
+ * All events are emitted at an instruction boundary; "commit" is recorded
+ * at the next opcode after the sixth store, never at its pre-store PC.
+ * Guard all raw reads to the actual 2 MiB installed DRAM aperture. */
+extern uint32_t V31GetAlternateReg(int n);
+static const char *v31_events_path;
+static FILE *v31_events_file;
+static unsigned long long v31_event_id;
+static struct {
+   bool pending;
+   uint64_t event_id;
+   uint32_t player,band,polygon,force_addr;
+   int32_t values[6];
+} v31_pending[3];
+static uint16_t v31_word(uint32_t a) {
+   if (a >= 0x200000u || a > 0x1FFFFEu) return 0;
+   return ((uint16_t)jaguarMainRAM[a]<<8)|jaguarMainRAM[a+1];
+}
+static uint32_t v31_long(uint32_t a) {
+   if (a >= 0x200000u || a > 0x1FFFFCu) return 0;
+   return ((uint32_t)jaguarMainRAM[a]<<24)|((uint32_t)jaguarMainRAM[a+1]<<16)|((uint32_t)jaguarMainRAM[a+2]<<8)|jaguarMainRAM[a+3];
+}
+static int v31_valid(uint32_t a, uint32_t size) {
+   return a < 0x200000u && size <= 0x200000u - a;
+}
+/* The native band layout (bndhead.inc): flags at +0, SURF_LIST at +48,
+ * SURFS_END at +52. Polygon CP header: flags|edge count, divider, refs,
+ * final material/color word. No camera/draw-tree traversal is assumed. */
+static void v31_event(const char *kind, int mode, uint32_t pc, uint64_t id,
+                      uint32_t player, uint32_t band, uint32_t poly,
+                      uint32_t force, const int32_t xyz[6], int ram_matches) {
+   uint32_t band_flags=0, surface=0,end=0,flags=0,divider=0,material=0, edges=0;
+   int poly_in_band=-1;
+   if (v31_valid(band,56)) {
+      band_flags=v31_long(band);
+      surface=v31_long(band+48);end=v31_long(band+52);
+      if(v31_valid(poly,6)) poly_in_band=(poly>=surface && poly<end &&
+          v31_valid(surface,2) && v31_valid(end,0));
+   }
+   if (v31_valid(poly,6)) {
+      flags=v31_word(poly);edges=flags&15;divider=v31_word(poly+2);
+      if (edges>0 && edges<=15 && v31_valid(poly,6+2*edges))
+         material=v31_word(poly+4+2*edges);
+   }
+   fprintf(v31_events_file,"%" PRIu64 ",%llu,%s,%s,0x%06X,0x%06X,0x%06X,0x%06X,0x%04X,0x%04X,%u,%u,%u,%d,0x%06X,%d,%d,%d,%d,%d,%d,%d\n",
+       fields+1,(unsigned long long)id,v30_modes[mode],kind,pc,player,band,poly,
+       band_flags,flags,edges,divider,material,poly_in_band,force,
+       xyz[0],xyz[1],xyz[2],xyz[3],xyz[4],xyz[5],ram_matches);
+}
+void V31AtPC(uint32_t pc) {
+   int k;
+   static const uint32_t end_force[3]={0xF0377Au,0xF037BAu,0xF037FAu};
+   if (!v31_events_file) return;
+   /* Match PC first; don't inspect GPU local RAM at millions of other PCs. */
+   for(k=0;k<3;k++) {
+      int edge=(pc==v30_pcs[k][5]);
+      int pre=(pc==v30_pcs[k][9]);
+      int post=(pc==end_force[k]);
+      uint32_t player,band,poly;
+      int32_t v[6]={0};
+      if(!edge && !pre && !post)continue;
+      if(v30_overlay_id()!=k) continue;
+      player=V31GetAlternateReg(30);
+      band=V31GetAlternateReg(31);
+      poly=V31GetAlternateReg(0);
+      if(edge) {
+         v31_event("edgehit",k,pc,++v31_event_id,player,band,poly,0,v,-1);
+      } else if(pre) {
+         int j;
+         uint32_t addr=GPUGetReg(29);
+         v[0]=(int32_t)GPUGetReg(2);v[1]=(int32_t)GPUGetReg(3);v[2]=(int32_t)GPUGetReg(4);
+         for(j=0;j<3;j++)v[3+j]=(int32_t)V31GetAlternateReg(10+j);
+         v31_pending[k].pending=true;
+         v31_pending[k].event_id=++v31_event_id;
+         v31_pending[k].player=player;v31_pending[k].band=band;
+         v31_pending[k].polygon=poly;v31_pending[k].force_addr=addr;
+         for(j=0;j<6;j++)v31_pending[k].values[j]=v[j];
+         v31_event("pre_store",k,pc,v31_event_id,player,band,poly,addr,v,-1);
+      } else if(v31_pending[k].pending) {
+         uint32_t addr=v31_pending[k].force_addr;
+         int j,match=v31_valid(addr,24);
+         for(j=0;j<6;j++) {
+            v[j]=match?(int32_t)v31_long(addr+4*j):0;
+            if(v[j]!=v31_pending[k].values[j])match=0;
+         }
+         v31_event("post_store",k,pc,v31_pending[k].event_id,
+                   v31_pending[k].player,v31_pending[k].band,
+                   v31_pending[k].polygon,addr,v,match);
+         v31_pending[k].pending=false;
+      }
+   }
+}
+static int v31_init(void) {
+   if (!v31_events_path) return 1;
+   v31_events_file=fopen(v31_events_path,"w");
+   if(!v31_events_file){perror("v31 contact events");return 0;}
+   fputs("field,event_id,overlay,event,pc,player,band,polygon,band_flags,polygon_flags,edges,divider,material,polygon_in_band,force_address,fx,fy,fz,tx,ty,tz,ram_matches\n",v31_events_file);
+   return 1;
+}
