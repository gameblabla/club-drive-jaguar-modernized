; END turt.gas

;
; end of the frame loop
;
;**	movei	#LOOPCNT,temp2
;**	load	(temp2),temp
;**	nop
;**	subq	#ONE_FRAME,temp
;**	store	temp,(temp2)
;**
;**	cmpq	#0,temp
	movei	#frameloop,r29
	jump		(r29) ;PL
	nop

eAllDone:
	SaveTimer	$18

	StartTimer	$00			; to measure time spent in 68K land

thatsAllFolks:	; for cutItOut
; stolen code
		movei	#G_CTRL, r29
		load		(r29), r28
		bclr #0, r28		; stop the GPU
;		bset		3, temp
		bset #1, r28		; start the cpu
		store	r28, (r29)

allGone:	jr	allGone
		nop

;----------------------------------------------------------------------------
; BEGIN subsend.gas
;
;	SUBROUTINE AREA
;
; sin, cos
; sqrt
; -----------------------------------------------------------------------
;	sine & cosine   16-bit table lookup Cosine
;
;	GIVEN:
;		temp = Angle (Binary Radians (1 BRAD = PI/1024))
;		pi2 = PI/2 ($200 in Brads)
;		sintbl = Ptr to Sine Table
;
;	RETURNS:
;		TEMP = Cos(Angle)*$4000
;
;	REGISTER USAGE:
;		temp, temp2, return
;
;
.if INTERPOLATE

cosine:
	add	r24,r28	; Cos(a) = Sin(a + pi/2)
sine:
	moveta	r0,r28
	moveta	r1,r29
;	sharq	#16,temp
	sharq	#16,r24

	move		r28, r0	; keep quadrant data in temp
	move		r28, r1
	sharq		#16,r0
	shlq		#16,r1
	shlq		#23, r0		; strip quadrant data
	shrq		#16,r1
	btst		#25, r28
	jr		EQ, _CDLOCAL_10_44
	shrq		#22, r0		; word address
		shlq	#1, r24 ; this is free
		neg	r0
		neg	r1
		add	r24, r0
		shrq	#1, r24 ; this is free
_CDLOCAL_10_44:
	add		r25, r0
	loadw	(r0), r29
	addqt	#2,r0
	loadw	(r0),r0
	sub	r29,r0
	mult	r1,r0
	shrq	#16,r0
	nop
	add	r0,r29
	movefa	r28,r0
	movefa	r29,r1
	btst		#26, r28
	jump		EQ, (r31)
	shlq	#16,r24
	jump		(r31)
	neg		r29

.else

cosine:
	add	r24,r28	; Cos(a) = Sin(a + pi/2)
sine:
	move		r28, r29	; keep quadrant data in temp
	shlq		#23, r29	; strip quadrant data
	btst		#9, r28
	jr		EQ, _CDLOCAL_10_76
	shrq		#22, r29	; word address
		shlq	#1, r24 ; this is free
		neg	r29
		add	r24, r29
		shrq	#1, r24 ; this is free
_CDLOCAL_10_76:
	add		r25, r29
	btst		#10, r28
	loadw	(r29), r29
	jump		EQ, (r31)
	nop
	jump		(r31)
	neg		r29

.endif

.if 0
; square root subroutine ------------------------------------------------
; uses 768 word long table to provide 10 bit - 3 digit accuracy
; ~20 cycles
;	args:
	; temp	- 32-bit unsigned number
;	returns:
	; temp	- square root of temp
;	munges:
	; r30

sqrt:
	normi	r28, r29
	movei	#(sqrtTabM512), r30
	addqt	#13, r29	; size to 1K max word entries
	bset		#0, r29		; shift an even amount only
	sh		r29, r28
	neg		r29		; shift amount for return flight
	add		r30, r28
	sharq	#1, r29		; return shift is half as big
	bclr		#0, r28
	addqt	#11, r29	; scale of table
	loadw	(r28), r28
	jump		(r31)
	sh		r29, r28

.endif
; END subsend.gas
; END 3dend.gas
