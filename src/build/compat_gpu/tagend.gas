	movefa	r30, r2

	; zero force vector
	movei	#CAR_FORCE, r29
	add	r2, r29
	moveq	#0, r28
	store	r28, (r29)
	addqt	#4, r29
	store	r28, (r29)
	addqt	#4, r29
	store	r28, (r29)
	; zero torque
	addqt	#4,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)

	; zero shocks
	movei	#CAR_SHOCKS,r29
	add	r2, r29
;	moveq	#0,temp
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)

	; initialize car surface properties
	movei	#CAR_SURFDATA,r29
	add	r2,r29
	movei	#$00540b16,r28	;default slipperyness
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
.if 0
; start the band counter at the beginning of the current player's list
; the player's current world model ends with a list of models to draw
	movei	#FLOOR_MODEL,r28
	add	r2,r28
	load	(r28),r28		; get the model the player is driving in
	movei	#BND_LIST,r1
	add	r28,r1		; get band list offset
.else
	movei	#BANDS,r1
.endif
	moveta	r1,r27

drvloop:
;
; get the next band element
;
	movefa	r27,r1
	nop
	load	(r1),r0
	addqt	#4,r1
	moveta	r1,r27
	moveta	r0,r31
	cmpq	#0,r0			; is the current band 0
	movei	#drvloopend,r29
	jump	EQ, (r29)
	nop

; BEGIN close.gas
;----------------------------------------------------------------------------
;	close.gas
;		Second level collision check.  Test distance to polygon center of
;	all polygons that are close in closeList and pass sucessful candidates
;	to full collision routines.
;													TP
;----------------------------------------------------------------------------

; legacy REGEQU polys => R0 ; close.gas:9
; legacy REGEQU tPolys => R1 ; close.gas:10

; legacy REGEQU xc => R2 ; close.gas:12
; legacy REGEQU yc => R3 ; close.gas:13
; legacy REGEQU zc => R4 ; close.gas:14

; legacy REGEQU xp => R5 ; close.gas:16
; legacy REGEQU yp => R6 ; close.gas:17
; legacy REGEQU zp => R7 ; close.gas:18
; legacy REGEQU closeList => R8 ; close.gas:19
; legacy REGEQU numSides => R9 ; close.gas:20
; legacy REGEQU polyRad => R10 ; close.gas:21
; legacy REGEQU carRad => R11 ; close.gas:22
; legacy REGEQU bColided => R12 ; close.gas:23
; legacy REGEQU outerLoop => R13 ; close.gas:24
; legacy REGEQU surfsend => R14 ; close.gas:25
; legacy REGEQU radius => R15 ; close.gas:26
; legacy REGEQU dist => R16 ; close.gas:27

; legacy REGEQU ee => R17 ; close.gas:29

; legacy REGEQU polyflags => R18 ; close.gas:31

; legacy REGEQU ox => R24 ; close.gas:33
; legacy REGEQU oy => R25 ; close.gas:34
; legacy REGEQU oz => R26 ; close.gas:35

; - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

DEBUGGING	EQU	0
; tabulate init

	movei	#doneclose,r13 

	movefa	r31,r29			; check for the "nocollide" flag on this band
	moveq	#BND_FLAGS,r28
	add	r29,r28
	load	(r28),r28
	btst	#0,r28
	moveta	r28,r26
	jump	NE,(r13)			; if it's set, skip all collision detection
	nop

	; load band radius
	movei	#RADIUS,r28
	add	r29,r28
	load	(r28),r15
	movei	#CAR_RADIUS,r29
	add	r29,r15

	;load car center (global coords)
	movefa	r30,r28
	nop
.if CAR_POSN
	addqt	#CAR_POSN,r28
.endif
	load		(r28), r24
	addqt	#4,r28
	load		(r28), r25
	addqt	#4,r28
	load		(r28), r26
	;load band center
	movefa	r31,r29
	addqt	#XORIG,r29
	load	(r29), r28
	addqt	#4, r29
	sub	r28,r24
	load	(r29), r28
	addqt	#4, r29
	sub	r28,r25
	load	(r29), r28
	sub	r28,r26

	move	r24,r2
	move	r25,r3
	move	r26,r4

	sharq	#12,r2			; convert to integer
	sharq	#12,r3
	sharq	#12,r4

	move	r2,r28
	move	r3,r29
	abs	r28
	abs	r29
	or	r29,r28
	move	r4,r29
	abs	r29
	or	r29,r28

	movei	#$8000,r29		; is any component of the difference > $8000?
	cmp	r29,r28
	jump	PL,(r13)		; if yes, then the car is far away

	; see if the car is far away from the band
	imultn	r2,r2
	imacn	r3,r3
	imacn	r4,r4
	resmac	r16
	nop

	cmp	r16,r15		; compare the band center's distance to the car
	jump	MI,(r13)		; with the band radius; if it's farther away, we don't need to check collisions
	nop

	movefa	r31,r29
	movei	#SURF_LIST, r28
	add	r29,r28
	load		(r28), r0
	movei	#tPOLYS, r1
	add	r29, r1
	load	(r1),r1
	movei	#SURFS_END,r14
	add	r29,r14
	load	(r14),r14

	movei	#closetop,r13
	movei	#enterclose,r28
	jump	(r28)
	nop

closetop:
		move	r24,r2
		move	r25,r3
		move	r26,r4

		;shift to band scale
		sharq	#12, r2
		sharq	#12, r3
		sharq	#12, r4

		movefa	r31,r29
		movei	#tCLOSE_LIST, r8
		add	r29,r8
		load	(r8),r8
		movei	#CAR_RADIUS, r11
		movei	#colided,r12
		movei	#closeLp,r13

closeLp:
		; should we ignore collisions?
		btst	#6,r18		; is ignore collide flag set?
		jump	NE,(r12)		; yes -- no collision
		nop

		; check closeList
		addqt	#2, r0
		loadw	(r0), r28		; divider num
		subqt	#2, r0			; put it back

		shlq		#1, r28			; word array
		add		r8, r28
		loadw	(r28), r29
		cmp		r29, r11
		jump		MI, (r12)
		nop

		;load poly info - center, radius
		move		r1, r28		; cuz the end of the loop doesn't know if we were here
		loadw		(r28),r10
		addqt	#2,r28
		shlq	#16, r10
;		add	carRad,polyRad
		loadw		(r28),r29
		addqt	#2,r28
		or	r29,r10
		loadw		(r28), r5		; and yp
		addqt	#2,r28
		loadw	(r28),r6
		addqt	#2,r28
		loadw	(r28), r7

		sub		r2, r5			; distance to center of poly
		sub		r3, r6
		sub		r4, r7

		imultn	r5, r5	;	distance^2
		imacn	r6, r6	;
		imacn	r7, r7	;
		resmac	r5		;

		cmp		r5,r10
		jump		MI, (r12)
		nop

; BEGIN crash.gas
;
; Check for car collision with a polygon
;
; how it works:
; we're passed 2 pointers to a polygon; one (in
; "poly1") points to the traditional world coordinate
; system; the other (in "poly2") points to additional
; information like the radius of the polygon, its center,
; and a list of edge normals
; We assume that the radius and other "cheap" tests have already
; been performed; we do the expensive processing here,
; checking the car control lines against the polygon. If the
; endpoints of a line are on opposite sides of the polygon,
; and if the line's intersection is inside the polygon (as
; determined by the edge normals of the poly), then we have
; a collision, and the CAR_FORCE and CAR_TORQUE variables
; are updated accordingly

; set THROWOUT to 1 if cars should be violently ejected from inside polygons
THROWOUT EQU 1

; set TORQUE to 1 if we should calculate torques
TORQUE	EQU 1
cMOI	EQU 1

; to convert a 16.16 to 20.12, shift right by this much

	CAR_RSHFT	EQU	4

; each subsequent edge intersection contributes this much less to the force
; so the larger the number, the less elasticity: use at least 1
	FORCE_RSHFT	EQU	2
	INIT_FSHFT	EQU	4

; legacy REGEQU poly1 => R0 ; crash.gas:35
; legacy REGEQU poly2 => R1 ; crash.gas:36
; legacy REGEQU ae => R0 ; crash.gas:37
; legacy REGEQU be => R1 ; crash.gas:38

; legacy REGEQU ax => R2 ; crash.gas:40
; legacy REGEQU ay => R3 ; crash.gas:41
; legacy REGEQU az => R4 ; crash.gas:42

; legacy REGEQU bx => R5 ; crash.gas:44
; legacy REGEQU by => R6 ; crash.gas:45
; legacy REGEQU bz => R7 ; crash.gas:46

; legacy REGEQU nx => R8 ; crash.gas:48
; legacy REGEQU ny => R9 ; crash.gas:49
; legacy REGEQU nz => R10 ; crash.gas:50

; legacy REGEQU an => R11 ; crash.gas:52
; legacy REGEQU bn => R12 ; crash.gas:53

; legacy REGEQU edgenorms => R13 ; crash.gas:55
; legacy REGEQU divider => R14 ; crash.gas:56
; legacy REGEQU adjust => R14 ; crash.gas:57
; legacy REGEQU vectors => R15 ; crash.gas:58

