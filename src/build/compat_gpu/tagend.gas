;;	nop
;;	addqt	#16, return
;;	store	flr, (return)
;;	nop
;;	addqt	#16, return
;;	store	flrs, (return)
;;	nop
;;	nop
;				chkEx:
;					loadw	(flr), pnt
;					; load point
;					mult		six, pnt
;					add		points, pnt
;					loadw	(pnt), t2x
;					addqt	#2, pnt	; to y
