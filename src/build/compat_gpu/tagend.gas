; GASM REGUNDEF tempx ; drive.gas:906
; GASM REGUNDEF tempy ; drive.gas:907
; GASM REGUNDEF tempz ; drive.gas:908

; GASM REGUNDEF LA ; drive.gas:910
; GASM REGUNDEF nf ; drive.gas:911
; GASM REGUNDEF wheel ; drive.gas:912
; GASM REGUNDEF wx ; drive.gas:913
; GASM REGUNDEF wy ; drive.gas:914
; GASM REGUNDEF wz ; drive.gas:915
; GASM REGUNDEF le ; drive.gas:916
; GASM REGUNDEF FA ; drive.gas:917

; GASM REGUNDEF groundProp ; drive.gas:919
; GASM REGUNDEF t2x ; drive.gas:920
; GASM REGUNDEF t2y ; drive.gas:921
; GASM REGUNDEF t2z ; drive.gas:922

; GASM REGUNDEF ta1 ; drive.gas:924
; GASM REGUNDEF ta2 ; drive.gas:925
; GASM REGUNDEF ta3 ; drive.gas:926
; GASM REGUNDEF ta4 ; drive.gas:927
; GASM REGUNDEF ta5 ; drive.gas:928
; GASM REGUNDEF thePlayer ; drive.gas:929
; GASM REGUNDEF thrust ; drive.gas:930
; GASM REGUNDEF brakePower ; drive.gas:931

; heap ----------------------------
		; add gravity
		
		; compute steer vector
		
		; sum tire forces
			; crash force?
;		movei	#(PLAYER1 + CAR_VELOCITY + 8), temp
			; compute normal force scalar
			; compute gription vector
			; add normal force

		; sum body point forces
			; crash force?
			; add normal force
			; drag gription vector

;		; fill jump address registers
;		movei	#fndFlr, temp
;		moveta	temp, ta1	; ta1 contains fndflr:
;		movei	#chkEx, temp
;		moveta	temp, ta2
;		movei	#doCrash, temp
;		moveta	temp, ta3
;		movei	#nextCPoint, temp
;		moveta	temp, ta4
;		movei	#sumPnts, temp
;		moveta	temp, ta5
;
;		moveq	#4, temp ;#CAR_NUM_PNTS, temp
;		moveta	temp, numCPpoints
;		movei	#(PLAYER1 + CAR_POSNS), temp
;		movei	#(PLAYER1 + FLOOR_PTR), flrs
;		sumPnts:
;			; load point coord
;			loadw	(temp), tempx
