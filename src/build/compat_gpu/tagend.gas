;*                            ALL RIGHTS RESERVED.                      *
;*                                                                      *
;*======================================================================*

;
;	COMMON EQUATES
;

;DEBUG_ON	EQU	0
.if 1
ORTHOGONALIZE	EQU	1		; set to 1 for gram-schmidt matrix orthogonalization
CLAMP		EQU	0		; set to a nonzero value to round small values off to 0 -- we used 15 before
.else
ORTHOGONALIZE	EQU	0
CLAMP		EQU	0
.endif

;
;PTRSIZE		EQU	(1*4)		; 1 LONG
;INPUT6		EQU	G_ENDRAM-PTRSIZE
;INPUT5		EQU	INPUT6-PTRSIZE
;INPUT4		EQU	INPUT5-PTRSIZE
;INPUT3		EQU	INPUT4-PTRSIZE
;INPUT2		EQU	INPUT3-PTRSIZE
;INPUT1		EQU	INPUT2-PTRSIZE
;
;	NOLIST
;
;	include "..\include\jaguar.inc"
;	include "blit.inc"
;	include "gpu.inc"
;	include "macros.inc"
;	include "3dds.inc"
;
;	LIST
;

;
;	GLOBAL REGISTER EQUATES
;
;temp		REGEQU	r0
;temp2	REGEQU	r1
; legacy REGEQU ptr => r2 ; turt.gas:54

; legacy REGEQU pitch => r3 ; turt.gas:56
; legacy REGEQU yaw => r4 ; turt.gas:57
; legacy REGEQU roll => r5 ; turt.gas:58
; legacy REGEQU velocity => r6 ; turt.gas:59

; legacy REGEQU half => r7 ; turt.gas:61

; legacy REGEQU xrite => r10 ; turt.gas:63
; legacy REGEQU yrite => r11 ; turt.gas:64
; legacy REGEQU zrite => r12 ; turt.gas:65
; legacy REGEQU xdown => r13 ; turt.gas:66
; legacy REGEQU ydown => r14 ; turt.gas:67
; legacy REGEQU zdown => r15 ; turt.gas:68
; legacy REGEQU xhead => r16 ; turt.gas:69
; legacy REGEQU yhead => r17 ; turt.gas:70
; legacy REGEQU zhead => r18 ; turt.gas:71
; legacy REGEQU xposn => r19 ; turt.gas:72
; legacy REGEQU yposn => r20 ; turt.gas:73
; legacy REGEQU zposn => r21 ; turt.gas:74

; legacy REGEQU sin => r22 ; turt.gas:76
; legacy REGEQU cos => r23 ; turt.gas:77
; legacy REGEQU pi2 => r24 ; turt.gas:78
; legacy REGEQU sintbl => r25 ; turt.gas:79
; legacy REGEQU cosRout => r26 ; turt.gas:80
; legacy REGEQU sinRout => r1 ; turt.gas:81
;returnR	REGEQU	r0


;
;	LOCAL MACROS
;

;XREF sn

MACRO	JSR_SIN
		move	PC,r31
		jump	(r1)
		addq	#6,r31	; Determine Return Address
ENDM

MACRO	JSR_COS
		move	PC,r31
		jump	(r26)
		addq	#6,r31	; Determine Return Address
ENDM

MACRO	Clampit
	move	\1,r28
	shlq	#16,r28
	sharq	#16,r28
	abs	r28
	cmp	r29,r28
	jr	PL,notbig_@@
	nop
		moveq	#0,\1
notbig_@@:
	nop
ENDM

MACRO	ROUND_TEMP
	add	r7,r28
ENDM

;
;	CODE SEGMENT
;

;
;	System Initialization
;
;	DEBUG_INIT

		moveq	#1,r7
		movei	#sine,r1
		shlq		#13,r7		; Half of One ($2000)
		movei	#cosine,r26
		moveq	#4,r24
		movei	#sn,r25
		shlq		#7,r24			; RPI2 = Pi/2 ($40 in Brads)
.if INTERPOLATE
		shlq		#16,r24
.endif
		; load player pointers
		movefa	r30, r28
		movei	#CAR_OMEGA, r29	; wx
		add		r28, r29		; temp2 <= CAR_OMEGA
		addqt	#CAR_MATRIX, r28	; temp  <= CAR_MATRIX

		load		(r29), r3
		addqt	#4, r29
.if INTERPOLATE = 0
		sharq	#16, r3
.endif
		load		(r29), r4
		addqt	#4, r29
.if INTERPOLATE = 0
		sharq	#16, r4
.endif
		load		(r29), r5
.if INTERPOLATE = 0
		sharq	#16, r5
.endif
		neg r5

		loadw	(r28),r10		; Fetch Turtle into registers
		addq		#2,r28
		loadw	(r28),r13
		addq		#2,r28
		loadw	(r28),r16
		addq		#2,r28
		loadw	(r28),r11
		addq		#2,r28
		loadw	(r28),r14
		addq		#2,r28
		loadw	(r28),r17
		addq		#2,r28
		loadw	(r28),r12
		addq		#2,r28
		loadw	(r28),r15
		addq		#2,r28
		loadw	(r28),r18

;		loadw	(temp),xrite		; Fetch Turtle into registers
;		addq		#2,temp
;		loadw	(temp),yrite
;		addq		#2,temp
;		loadw	(temp),zrite
;		addq		#2,temp
;		loadw	(temp),xdown
;		addq		#2,temp
;		loadw	(temp),ydown
;		addq		#2,temp
;		loadw	(temp),zdown
;		addq		#2,temp
;		loadw	(temp),xhead
;		addq		#2,temp
;		loadw	(temp),yhead
;		addq		#2,temp
;		loadw	(temp),zhead
;	; PLAYER1 fixup
;	movei	#player, temp2
;	load		(temp2), temp
;	movei	#PLAYER1, temp2	; 
;	cmp		temp, temp2
;	jr		NE, pl2
;	nop
;		moveq	#0, roll
;		moveq	#0, pitch
;pl2:
;
;	PITCH (Rotation about the X-Axis)
;
		cmpq		#0,r3
		movei	#iyaw,r28
		jump		EQ, (r28)
ipitch:					; IF (Pitch <> 0) THEN Pitch the Turtle
		move		r3,r28
		JSR_SIN
		move		r29,r22		; SIN = SINE(Pitch)
;		move		pitch,temp
		JSR_COS
		move		r29,r23		; COS = COSINE(Pitch)

;																	nop
;																	movei	#$11070, temp2
;																	store	sin, (temp2)
;																	addqt	#4, temp2
;																	store	cos, (temp2)
;																	addqt	#4, temp2
;																	store	temp, (temp2)
;																	nop
		move		r23,r28

		move		r22,r29
		imult	r13,r28		; TEMP = xdown*cos(a)
		imult	r16,r29
		sub		r29,r28		; TEMP = xdown*cos(a) - xhead*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r13,r29		; TEMP2 = xdown*sin(a)
		move		r28,r13		; XDOWN = xdown*cos(a) - xhead*sin(a)
		move		r23,r28
		imult	r16,r28
		add		r29,r28		; TEMP = xhead*cos(a) + xdown*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r16		; XHEAD = xhead*cos(a) + xdown*sin(a)

		move		r23,r28
		move		r22,r29
		imult	r14,r28		; TEMP = ydown*cos(a)
		imult	r17,r29
		sub		r29,r28		; TEMP = ydown*cos(a) - yhead*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r14,r29		; TEMP2 = ydown*sin(a)
		move		r28,r14		; YDOWN = ydown*cos(a) - yhead*sin(a)
		move		r23,r28
		imult	r17,r28
		add		r29,r28		; TEMP = yhead*cos(a) + ydown*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r17		; YHEAD = yhead*cos(a) + ydown*sin(a)

		move		r23,r28
		move		r22,r29
		imult	r15,r28		; TEMP = zdown*cos(a)
		imult	r18,r29
		sub		r29,r28		; TEMP = zdown*cos(a) - zhead*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r15,r29		; TEMP2 = zdown*sin(a)
		move		r28,r15		; ZDOWN = zdown*cos(a) - zhead*sin(a)
		move		r23,r28
		imult	r18,r28
		add		r29,r28		; TEMP = zhead*cos(a) + zdown*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r18		; ZHEAD = zhead*cos(a) + zdown*sin(a)

;
;	YAW (Rotation about the Y-Axis)
;
iyaw:
		movei	#doYaw,r28
		cmpq		#0,r4
		move		PC,r0
		jump		NE,(r28)
		addq		#6,r0	; Determine Return Address

;
;	ROLL (Rotation about the Z-Axis)
;
iroll:
		cmpq		#0,r5
		movei	#imove,r28
		jump		EQ,(r28)
		nop

		; IF (Roll <> 0) THEN Roll the Turtle
		move		r5,r28
		JSR_SIN
		move		r29,r22		; SIN = SINE(Roll)
;		move		roll,temp
		JSR_COS
		move		r29,r23		; COS = COSINE(Roll)

		move		r23, r28
		move		r22,r29
		imult	r10,r28		; TEMP = xrite*cos(a)
		imult	r13,r29
		sub		r29,r28		; TEMP = xrite*cos(a) - xdown*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r10,r29		; TEMP2 = xrite*sin(a)
		move		r28,r10		; XRITE = xrite*cos(a) - xdown*sin(a)
		move		r23,r28
		imult	r13,r28
		add		r29,r28		; TEMP = xdown*cos(a) + xrite*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r13		; XDOWN = xdown*cos(a) + xrite*sin(a)

		move		r23,r28
		move		r22,r29
		imult	r11,r28		; TEMP = yrite*cos(a)
		imult	r14,r29
		sub		r29,r28		; TEMP = yrite*cos(a) - ydown*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r11,r29		; TEMP2 = yrite*sin(a)
		move		r28,r11		; YRITE = yrite*cos(a) - ydown*sin(a)
		move		r23,r28
		imult	r14,r28
		add		r29,r28		; TEMP = ydown*cos(a) + yrite*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r14		; YDOWN = ydown*cos(a) + yrite*sin(a)

		move		r23,r28
		move		r22,r29
		imult	r12,r28		; TEMP = zrite*cos(a)
		imult	r15,r29
		sub		r29,r28		; TEMP = zrite*cos(a) - zdown*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r12,r29		; TEMP2 = zrite*sin(a)
		move		r28,r12		; ZRITE = zrite*cos(a) - zdown*sin(a)
		move		r23,r28
		imult	r15,r28
		add		r29,r28		; TEMP = zdown*cos(a) + zrite*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r15		; ZDOWN = zdown*cos(a) + zrite*sin(a)

;
;	MOVE (Translation along the HEAD vector)
;
imove:
;	cmpq	#0,velocity
;	move	velocity,temp
;	jr	EQ,idone
;	move	velocity,temp2		; IF (Velocity <> 0) THEN Move the Turtle
;	imult	xhead,temp
;	imult	yhead,temp2
;	add	half,temp
;	add	half,temp2
;	sharq	#14,temp
;	sharq	#14,temp2
;	add	temp,xposn		; Xpos = Xpos + Vel*Xhead
;	add	temp2,yposn		; Ypos = Ypos + Vel*Yhead
;	imult	zhead,velocity
;	add	half,velocity
;	sharq	#14,velocity
;	add	velocity,zposn		; Zpos = Zpos + Vel*Zhead

;
;	Write Final Rotated and Translated Turtle Record
;
idone:
;	neg	xdown
;	neg	xhead
;	neg	yrite
;	neg	yhead
;	neg	zrite
;	neg	zdown

		movefa	r30, r2
		nop
		addqt	#CAR_MATRIX, r2

;	movei	#ROT_MATRIX,temp
;	addqt	#12, temp
;	load	(ptr),temp		; TEMP = 68000 ptr to active Turtle

.if CLAMP
	movei	#$4000,r5		; max allowed value
	movei	#CLAMP,r29		; min allowed value
	Clampit	r10
	Clampit	r11
	Clampit	r12
	Clampit	r13
	Clampit	r14
	Clampit	r15
	Clampit	r16
	Clampit	r17
	Clampit	r18
.endif

	storew	r10,(r2)
	addq	#2,r2
	storew	r13,(r2)
	addq	#2,r2
	storew	r16,(r2)
	addq	#2,r2
	storew	r11,(r2)		; Write back turtle
	addq	#2,r2
	storew	r14,(r2)
	addq	#2,r2
	storew	r17,(r2)
	addq	#2,r2
	storew	r12,(r2)
	addq	#2,r2
	storew	r15,(r2)
	addq	#2,r2
	storew	r18,(r2)

;	storew	xrite,(ptr)
;	addq	#2,ptr
;	storew	yrite,(ptr)		; Write back turtle
;	addq	#2,ptr
;	storew	zrite,(ptr)
;	addq	#2,ptr
;	storew	xdown,(ptr)
;	addq	#2,ptr
;	storew	ydown,(ptr)
;	addq	#2,ptr
;	storew	zdown,(ptr)
;	addq	#2,ptr
;	storew	xhead,(ptr)
;	addq	#2,ptr
;	storew	yhead,(ptr)
;	addq	#2,ptr
;	storew	zhead,(ptr)

	movei	#turtOver, r28
	jump		(r28)
	; nop
;-Yaw------------------------------------------------------------------------
doYaw:
		; IF (Yaw <> 0) THEN Yaw the Turtle
		move		r4,r28
		JSR_SIN
		move		r29,r22		; SIN = SINE(Yaw)
;		move		yaw,temp
		JSR_COS
		move		r29,r23		; COS = COSINE(Yaw)
		move		r23, r28

		move		r22,r29
		imult	r16,r28		; TEMP = xhead*cos(a)
		imult	r10,r29
		sub		r29,r28		; TEMP = xhead*cos(a) - xrite*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r16,r29		; TEMP2 = xhead*sin(a)
		move		r28,r16		; XHEAD = xhead*cos(a) - xrite*sin(a)
		move		r23,r28
		imult	r10,r28
		add		r29,r28		; TEMP = xrite*cos(a) + xhead*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r10		; XRITE = xrite*cos(a) + xhead*sin(a)

		move		r23,r28
		move		r22,r29
		imult	r17,r28		; TEMP = yhead*cos(a)
		imult	r11,r29
		sub		r29,r28		; TEMP = yhead*cos(a) - yrite*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r17,r29		; TEMP2 = yhead*sin(a)
		move		r28,r17		; YHEAD = yhead*cos(a) - yrite*sin(a)
		move		r23,r28
		imult	r11,r28
		add		r29,r28		; TEMP = yrite*cos(a) + yhead*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28
		move		r28,r11		; YRITE = yrite*cos(a) + yhead*sin(a)

		move		r23,r28
		move		r22,r29
		imult	r18,r28		; TEMP = zhead*cos(a)
		imult	r12,r29
		sub		r29,r28		; TEMP = zhead*cos(a) - zrite*sin(a)
		move		r22,r29
;		add		half,temp
		ROUND_TEMP
		sharq	#14,r28
		imult	r18,r29		; TEMP2 = zhead*sin(a)
		move		r28,r18		; ZHEAD = zhead*cos(a) - zrite*sin(a)
		move		r23,r28
		imult	r12,r28
		add		r29,r28		; TEMP = zrite*cos(a) + zhead*sin(a)
;		add		half,temp
		ROUND_TEMP
	 	sharq	#14,r28

		; go home
;		movei	#iroll, temp2
		jump		(r0)
		move		r28,r12		; ZRITE = zrite*cos(a) + zhead*sin(a)
;----------------------------------------------------------------------------
turtOver:

; clean up
; GASM REGUNDEF ptr ; turt.gas:537

; GASM REGUNDEF pitch ; turt.gas:539
