; GASM REGUNDEF fx ; drive.gas:889
; GASM REGUNDEF fy ; drive.gas:890
; GASM REGUNDEF fz ; drive.gas:891
; GASM REGUNDEF tx ; drive.gas:892
; GASM REGUNDEF ty ; drive.gas:893
; GASM REGUNDEF tz ; drive.gas:894

; GASM REGUNDEF xrite ; drive.gas:896
; GASM REGUNDEF yrite ; drive.gas:897
; GASM REGUNDEF zrite ; drive.gas:898
; GASM REGUNDEF xdown ; drive.gas:899
; GASM REGUNDEF ydown ; drive.gas:900
; GASM REGUNDEF zdown ; drive.gas:901
; GASM REGUNDEF xhead ; drive.gas:902
; GASM REGUNDEF yhead ; drive.gas:903
