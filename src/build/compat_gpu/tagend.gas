; legacy REGEQU count => R23 ; crash.gas:70

;ox		REGEQU	R24	; car origin: defined in close.gas
;oy		REGEQU	R25	; 
;oz		REGEQU	R26	; 

; registers 27-29 reserved for global use
; legacy REGEQU skiploop => R30 ; crash.gas:77
; legacy REGEQU edgeloop => R31 ; crash.gas:78

; some stuff put into alternate registers (only)
; poly1		REGEQU	R0
; poly2		REGEQU	R1
; legacy REGEQU points => R2 ; crash.gas:83
; legacy REGEQU edges => R3 ; crash.gas:84
; legacy REGEQU poly_numedges => R4 ; crash.gas:85
; legacy REGEQU force_shift => R5 ; crash.gas:86
; legacy REGEQU poly_flags => R6 ; crash.gas:87

; legacy REGEQU fx => R7 ; crash.gas:89
; legacy REGEQU fy => R8 ; crash.gas:90
; legacy REGEQU fz => R9 ; crash.gas:91

; legacy REGEQU tx => R10 ; crash.gas:93
; legacy REGEQU ty => R11 ; crash.gas:94
; legacy REGEQU tz => R12 ; crash.gas:95

; legacy REGEQU vx => R13 ; crash.gas:97
; legacy REGEQU vy => R14 ; crash.gas:98
; legacy REGEQU vz => R15 ; crash.gas:99

; legacy REGEQU wx => R16 ; crash.gas:101
; legacy REGEQU wy => R17 ; crash.gas:102
; legacy REGEQU wz => R18 ; crash.gas:103

; ix		REGEQU	R19	; point of intersection
; iy		REGEQU	R20
; iz		REGEQU	R21

; legacy REGEQU dispfrac => R22 ; crash.gas:109
; legacy REGEQU portptr => R23 ; crash.gas:110

; legacy REGEQU geoband => R29 ; crash.gas:112

;
; set up 16.16 division
;
	moveta	r1,r1			;  save poly2
	moveta	r0,r0			;  save poly1

	movei	#G_DIVCTRL,r28
	moveq	#1,r29
	store	r29,(r28)

; set up various global variables
	movefa	r30,r22

	movei	#CUR_PORTAL,r28
	add	r22,r28
	moveta	r28,r23

	moveq	#(CAR_NUM_PNTS/2),r16

	movefa	r31,r29
	movei	#DIVIDER_LIST, r14
	add	r29,r14
	moveta	r29,r29

	load	(r14),r14
	moveq	#NUM_PNTS,r28
	add	r29,r28
	loadw	(r28),r28			; get number of points
	moveq	#6,r23
	mult	r23,r28			; multiply number of points by sizeof(point)
	movei	#ROTPNT_LIST, r15
	add	r29,r15
	load	(r15),r15		; get base of point list
	moveta	r15,r2			; save PNT_LIST
	add	r28,r15			; point to start of vectors

	movei	#CAR_POSNS,r17
	add	r22,r17			; "caredges" now points to the list of transformed car points

	movei	#EDGE_LIST,r28
	add	r29,r28
	load	(r28),r28
	moveta	r28,r3


	loadw	(r0),r28			; get number of edges
	addqt	#2,r0
	moveta	r28,r6			; save edges+flags
	shlq	#28,r28			; strip flags
	shrq	#28,r28
	moveta	r28,r4
	loadw	(r0),r28			; get divider number
	addqt	#2,r0			; and move poly1 to point to the edges

	shlq	#2,r28				; multiply divider number by sizeof(divider)
	add	r28,r14			; point to divider

	moveq	#6,r29
	loadw	(r14),r28			; get divider point number
	addqt	#2,r14
	mult	r29,r28			; multiply by sizeof(points) (6)
	movefa	r2,r18
	add	r28,r18
	loadw	(r14),r28			; get divider vector number
	subqt	#2,r14
	mult	r29,r28			; multiply by sizeof(vector)
	add	r28,r15			; add to vector list base

; here we want:
; (1) vectors to point to the polygon plane normal
; (2) tempptr to point to the point on the plane
	loadw	(r15),r8			; load up the polygon normal
	addqt	#2,r15
	loadw	(r15),r9
	addqt	#2,r15
	loadw	(r15),r10
	loadw	(r18),r19			; get divider point
	addqt	#2,r18
	shlq	#16,r19
	sharq	#CAR_RSHFT,r19
	loadw	(r18),r20
	addqt	#2,r18
	shlq	#16,r20
	sharq	#CAR_RSHFT,r20
	loadw	(r18),r21
	shlq	#16,r21
	sharq	#CAR_RSHFT,r21


; I contains an initial point on the plane right now: use it to calculate the D in Ax+By+Cz-D = 0
	move	r19,r29
	abs	r29
	move	r20,r28
	abs	r28
	or	r28,r29
	move	r21,r28
	abs	r28
	or	r28,r29
	normi	r29,r28			; calculate exponent for I
	addqt	#9,r28
	sha	r28,r19
	sha	r28,r20
	sha	r28,r21
	imultn	r19,r8				; calculate constant value for plane equation
	imacn	r20,r9				; (this will be 30 bits)
	imacn	r21,r10
	resmac	r14
	neg	r28
	addqt	#15,r28
	sha	r28,r14			; normalize (the normal vector is a 15 bit signed number)

;
; load up car forces and torques
;
	moveq	#(CAR_FORCE-32),r29
	addqt	#32,r29
	add	r22,r29
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r7
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r8
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r9

	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r10
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r11
	load	(r29),r28
	movei	#skipcrash,r30
	moveta	r28,r12

; load up car velocity and rotation

	move	r22,r29
	addqt	#CAR_VELOCITY,r29
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r13
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r14
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r15

	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r16
	load	(r29),r28
	addqt	#4,r29
	moveta	r28,r17
	load	(r29),r28
	movei	#crashedge,r31
	moveta	r28,r18

	movei	#crashlp,r27

	moveq	#INIT_FSHFT,r28
	moveta	r28,r5

	moveq	#0,r28
	moveta	r28,r22			; initially 0 displacement required

crashlp:
	loadw	(r17),r2			; load initial point into a
	addqt	#2,r17
	loadw	(r17),r3
	addqt	#2,r17
	loadw	(r17),r4
	addqt	#2,r17

	shlq	#16,r2
	shlq	#16,r3
	sharq	#CAR_RSHFT,r2
	sharq	#CAR_RSHFT,r3
	add	r24,r2
	add	r25,r3
	shlq	#16,r4
	sharq	#CAR_RSHFT,r4
	add	r26,r4
						; calculate exponent for a
	move	r2,r29
	abs	r29
	move	r3,r28
	abs	r28
	or	r28,r29
	move	r4,r28
	abs	r28
	or	r28,r29
	normi	r29,r0
	addqt	#9,r0
	sha	r0,r2				; normalize A
	sha	r0,r3
	sha	r0,r4

	loadw	(r17),r5
	addqt	#2,r17
	shlq	#16,r5
	sharq	#CAR_RSHFT,r5
	add	r24,r5
	loadw	(r17),r6
	addqt	#2,r17
	shlq	#16,r6
	sharq	#CAR_RSHFT,r6
	add	r25,r6
	loadw	(r17),r7
	addqt	#2,r17
	shlq	#16,r7
	sharq	#CAR_RSHFT,r7
	add	r26,r7
; calculate exponent for b
	move	r5,r29
	abs	r29
	move	r6,r28
	abs	r28
	or	r28,r29
	move	r7,r28
	abs	r28
	or	r28,r29
	normi	r29,r1
	addqt	#9,r1
	sha	r1,r5			; normalize B
	sha	r1,r6
	sha	r1,r7

	imultn	r2,r8
	imacn	r3,r9
	imacn	r4,r10
	resmac	r11

	moveq	#15,r28
	sub		r0,r28
	moveq	#15,r29
	sub		r1,r29

	sha	r28,r11

	imultn	r5,r8
	imacn	r6,r9
	imacn	r7,r10
	resmac	r12
	sha	r29,r12

	sub	r14,r11
	sub	r14,r12
	move	r11,r23
	xor	r12,r23
	btst	#31,r23
	jump	EQ,(r30)	; if A and B are on the same side of the plane, forget it
	nop
		; if A and B are on opposite sides, then A + |An|/|An+Bn| (B-A) is the point on the plane
		move	r11,r23	; save original sign of an
		abs	r12		; neat math: it doesn't matter that an and bn are 32 bit numbers, since
		abs	r11		; (an/65536)/(bn/65536) == an/bn!
		add	r11,r12
		div	r12,r11		; now an is a 16.16 unsigned number < 1
; remember, ax and bx have been normalized to 16 bits
		neg	r0
		sha	r0,r2		; un-normalize A
		sha	r0,r3
		sha	r0,r4
		neg	r1
		move	r5,r19		; un-normalize B (but store it in I, since we will want the normalized B later)
		move	r6,r20
		move	r7,r21
		sha	r1,r19
		sha	r1,r20
		sha	r1,r21

; note: an is an unsigned 16 bit fraction; since I is a signed vector, we want to do signed
; multiplication; so we turn an into a positive signed 16 bit fraction by dividing by 2 
		shrq	#1,r11		; make sure an is non-negative and in 0.15 form
		btst	#31,r23
		jr	NE, anplus
		move	r11,r1		; save the fraction "behind the plane" into be
			neg	r1
			shlq	#17,r1
			shrq	#17,r1
anplus:
		sub	r2,r19
		sub	r3,r20
		sub	r4,r21
; now normalize B-A
		move	r19,r28
		abs	r28
		move	r20,r29
		abs	r29
		or	r28,r29
		move	r21,r28
		abs	r28
		or	r28,r29
		normi	r29,r28
		addqt	#9,r28
		sha	r28,r19
		sha	r28,r20
		sha	r28,r21

		imult	r11,r19
		imult	r11,r20
		imult	r11,r21
; now unnormalize ix,iy,iz into 32 bit numbers
		neg	r28
		addqt	#15,r28		; IS 15 CORRECT?? SHOULD BE
		sha	r28,r19
		sha	r28,r20
		sha	r28,r21
		add	r2,r19
		add	r3,r20
		add	r4,r21
		moveta	r19,r19			; save I, so that we can subtract stuff from it
		moveta	r20,r20
		moveta	r21,r21
;
;	Now: for each edge normal A, see if (I - Edge point).A is positive; if not, the point is on the wrong side
;
		movefa	r1,r13			
		movefa	r4,r23
		movefa	r0,r18			; get pointer to polygon stuff
		addqt	#10,r13			; skip: radius (4 bytes), center (6 bytes)
		addqt	#4,r18			; skip number of edges and divider
	crashedge:
			movefa	r3,r28
			loadw	(r18),r29		; get polygon edge description
			addqt	#2,r18
			bclr	#15,r29		; we don't care if the edge is reversed
			shlq	#2,r29		; multiply by 4 (=sizeof(edge))
			add	r29,r28		; now "temp" points to the edge description
			loadw	(r28),r29		; get the first point in the edge
			moveq	#6,r28
			subqt	#1,r29		; points are 1 based in the edge array!
			mult	r28,r29		; multiply point number by sizeof(point)
			movefa	r2,r28
			nop
			add	r29,r28		; now temp points to the x,y,z of the edge point
			loadw	(r28),r29
			addqt	#2,r28
			shlq	#16,r29		; sign extend edge x
			sharq	#CAR_RSHFT,r29
			sub	r29,r19
			loadw	(r28),r29
			addqt	#2,r28
			shlq	#16,r29		; sign extend edge y
			sharq	#CAR_RSHFT,r29
			sub	r29,r20
			loadw	(r28),r29
			shlq	#16,r29		; sign extend edge z
			sharq	#CAR_RSHFT,r29
			sub	r29,r21

			loadw	(r13),r2		; now get the edge normal into A (it's 0.15)
			addqt	#2,r13
			loadw	(r13),r3
			addqt	#2,r13
			loadw	(r13),r4
			addqt	#2,r13

			move	r19,r28			; normalize (I-E)
			abs	r28
			move	r20,r29
			abs	r29
			or	r29,r28
			move	r21,r29
			abs	r29
			or	r29,r28
			normi	r28,r0
			addqt	#9,r0
			sha	r0,r19
			sha	r0,r20
			sha	r0,r21

			imultn	r2,r19
			imacn	r3,r20
			imacn	r4,r21
			resmac	r12
	;	neg		ae
	;	addqt	#15+10,ae
	;	sha		ae,bn
	;	addq		#16,bn
			cmpq	#0,r12
			jump	MI,(r30)		; if on wrong side of edge, abort the whole test
			nop
			movefa	r19,r19			; restore I
			movefa	r20,r20
			movefa	r21,r21
			subq	#1,r23
			jump	NZ,(r31)
			nop
	; we get here if I is inside the polygon
	; now we have to figure out force and torque on the car
	; for now, the force is just the projection of the
	; car's velocity onto the polygon's normal
	; NOTE: the last four "edges" are the car shocks, and are handled differently

	; first, note which band we are in, *if* this is a band that we can be "on" (we can't be
	; "on" moving bands, unless we are in a tag game)
		movefa	r26,r28
.if TAGGAME
		btst	#17,r28			; is this another car?
		movei	#notcar,r29
		jump	EQ,(r29)			; no, don't worry
		nop
		; at this point, we're going to bail on all further collisions
		; so we can trash reggies if we want...
		; see if the other guy can tag us
			movei	#(PLAYER1^PLAYER2),r12
			move	r12,r29
			xor	r22,r29		; now iy is the other player

			movei	#WAIT_TIME,r28
			add	r28,r29
			load	(r29),r28		; has the other guy got a timer going
			cmpq	#0,r28
			jump	NE,(r30)		; yes: no tags allowed
			nop
			movei	#itCar,r29
			load	(r29),r19		; ix now points to the taggee
			move	r19,r28
			xor	r12,r28			; flip the it car
			store	r28,(r29)		; and save it
			move	r19,r29
			addqt	#CAR_VELOCITY,r29
			moveq	#0,r28			; zero taggee's velocity
			store	r28,(r29)
			addqt	#4,r29
			store	r28,(r29)
			addqt	#4,r29
			store	r28,(r29)
			movei	#WAIT_TIME,r29
			add	r19,r29
			movei	#600,r28
			store	r28,(r29)		; make a 2 second delay for the taggee
			cmp	r22,r19			; were we the one tagged
			movei	#thatsAllFolks,r29
			jump	EQ,(r29)		; yes == time to stop everything!
			nop
			movei	#drvloop,r29		; otherwise, go check other bands
			jump	(r29)
			nop

notcar:
.endif
		btst	#16,r28
		jr	NE,noton
		nop

		movei	#NEW_FLOOR,r28
		add	r22,r28
		movefa	r29,r29
		store	r29,(r28)
noton:
	; get a pointer to the special surface structure
		movei	#notspec,r21				; NOTE: ix, iy, iz are unused at this point
		movefa	r6,r28
		movei	#mSPSURF,r29
		btst	#bSPSURF,r28
		jump	EQ,(r21)
		moveq	#0,r19
			movei	#PROP_LIST,r20
			and	r29,r28
			movefa	r29,r29
			add	r20,r29
			load	(r29),r19		; get pointer to special surface list
			shrq	#(8-5),r28		; special surface structure is 32 bytes
			add	r28,r19			; ix is now a pointer to the specific structure

			movefa	r23,r29
			load	(r19),r28	; check for a portal
			addqt	#16,r19
			cmpq	#0,r28		; is there a portal?
			jr	EQ,maybesnd
			moveq	#0,r28
				subqt	#16,r19
				store	r19,(r29)		; store the portal
				moveta	r28,r22
				moveta	r28,r7
				moveta	r28,r8
				moveta	r28,r9
				moveta	r28,r10
				moveta	r28,r11
				jump	(r30)		; we're done with collisions
				moveta	r28,r12
maybesnd:
			load	(r19),r28	; check for special sound
			addqt	#4,r19
			cmpq	#0,r28
			movei	#notspec,r21
			jump	EQ,(r21)
			addqt	#4,r29	; temp2 still contains user+CUR_PORTAL
.if RACEGAME
;
; the start line is indicated by a "sound" of -2; the finish line by a "sound" of -1
;
				movei	#plussnd,r18
				jump	PL,(r18)
				nop
					move	r29,r18
					neg	r28
					addqt	#(GAME_DATA-CUR_SOUND),r18
 					subqt	#1,r28
					loadw	(r18),r23
					nop
					move	r23,r29
					shlq	#31,r29
					shrq	#31,r29
					cmp	r29,r28
					jump	EQ,(r21)			; no: nothing more to do
					addqt	#1,r23
					storew	r23,(r18)		; save new lap number
					addqt	#(SCORE-GAME_DATA),r18
					load	(r18),r23		; get current score
					movei	#scoreinc,r28
					load	(r28),r28		; get amount to score per lap
					add	r28,r23
					store	r23,(r18)
					subqt	#(SCORE-WAIT_TIME),r18
					movei	#1500,r28		; 5 second timer delay
					jump	(r21)			; don't bother with sound (td.s does it)
					store	r28,(r18)
plussnd:
.endif
				load	(r29),r20		; currently played sound
				cmp	r28,r20			; is this sound more important?
				jump	PL,(r21)
				moveq	#1,r20			; for volume
					store	r28,(r29)
					addqt	#4,r29
					shlq	#14,r20
					subqt	#1,r20		; make iy $3fff
					store	r20,(r29)	; set sound volume
					addqt	#4,r29
					store	r20,(r29)	; set sound X coordinate
notspec:
	; now, see if it's an edge or a shock
		movei	#edgehit,r28
		cmpq	#5,r16
		jump	PL,(r28)
		nop
			movei	#CAR_SHOCKS,r28
			move	r16,r29
			subqt	#1,r29
			shlq	#2,r29		; multiply by 4
			add	r22,r28
			add	r29,r28		; keep temp2 as an index
			load	(r28),r20		; get current shock value
			cmp	r20,r11
			jump	MI,(r30)		; if larger than an, ignore this collision
			nop
				cmpq	#0,r19		; is there a special surface??
				jump	EQ,(r30)
				store	r11,(r28)
					movei	#CAR_SURFDATA,r28
					add	r22,r28
					add	r29,r28
		; we already adjust ix above, otherwise we would: addqt	#SURF_PROP,ix
					load	(r19),r19		; get surface properties
					cmpq	#0,r19		; if 0, no special properties
					jump	EQ,(r30)
					nop
					jump	(r30)
					store	r19,(r28)	; save special surface data

edgehit:
.if TORQUE
	; get the car's rotational velocity ***
		movefa	r16,r2
		movefa	r17,r3
		movefa	r18,r4
	; get the point of impact, in terms of the car
	; coordinate system
		movefa	r19,r19
		movefa	r20,r20
		movefa	r21,r21
		sub	r24,r19
		sub	r25,r20
		sub	r26,r21
		sharq	#(16-CAR_RSHFT),r19
		sharq	#(16-CAR_RSHFT),r20
		sharq	#(16-CAR_RSHFT),r21
		moveta	r19,r19		; save 0.16 car coordinates
		moveta	r20,r20
		moveta	r21,r21

	; linear velocity at this point is (rotation X point)
		rorq	#16,r2
		rorq	#16,r3
		rorq	#16,r4

		neg	r20
		imultn	r3,r21
		imacn	r4,r20
		resmac	r28

		neg	r21
		imultn	r4,r19
		imacn	r2,r21
		resmac	r29

		neg	r19
		imultn	r2,r20
		imacn	r3,r19
		resmac	r4
		neg	r4

		sharq	#1,r28
		sharq	#1,r29
		sharq	#1,r4
.endif

	; get the car's velocity
		movefa	r13,r19
		movefa	r14,r20
		movefa	r15,r21

.if TORQUE
		add	r28,r19
		add	r29,r20
		add	r4,r21
.endif

	; normalize it
		move	r19,r28
		move	r20,r29
		abs	r28
		abs	r29
		or	r28,r29
		move	r21,r28
		abs	r28
		or	r28,r29
		jump	EQ,(r30)
		nop				; skip if 0 velocity
		normi	r29,r0
		addqt	#9,r0
		sha	r0,r19
		sha	r0,r20
		sha	r0,r21
	; project onto the normal
		imultn	r8,r19
		imacn	r9,r20
		imacn	r10,r21
		resmac	r12

	; if the velocity points in the same direction as the polygon normal, no force should be added
		cmpq	#0,r12
		jump	PL,(r30)
		nop
			neg	r0
			addqt	#15,r0
			sha	r0,r12
		; find magnitude of bn
			move	r12,r28
			abs	r28
			normi	r28,r0
			addqt	#9,r0
			move	r8,r19
			move	r9,r20
			move	r10,r21
			sha	r0,r12
		; finish finding the projection of velocity onto the normal; this will be the force
			imult	r12,r19
			imult	r12,r20
			imult	r12,r21
			neg	r0
			addqt	#15,r0
		; the first intersection has full effect; subsequent intersections contribute less and less to the
		; final force on the car, so that we can control the elasticity of the collision (indeed, without
		; this adjustment collisions could be *more* than elastic!
			movefa	r5,r28
			add	r28,r0
.if INIT_FSHFT = 0
			addqt	#FORCE_RSHFT,r28
			moveta	r28,r5
.endif
			sha	r0,r19
			sha	r0,r20
			sha	r0,r21

		; now (ix,iy,iz) contains the new force
			movefa	r7,r2
			movefa	r8,r3
			movefa	r9,r4
			sub	r19,r2
			sub	r20,r3
			sub	r21,r4
			moveta	r2,r7
			moveta	r3,r8
			moveta	r4,r9
.if TORQUE
		; re-normalize force
			move	r19,r28
			move	r20,r29
			abs	r28
			abs	r29
			or	r29,r28
			move	r21,r29
			abs	r29
			or	r29,r28
			normi	r28,r0
			addqt	#9,r0

			sha	r0,r19
			sha	r0,r20
			sha	r0,r21

			neg	r0
.if cMOI
			subqt	#cMOI,r0
.endif
		; retrieve the point of intersection (in 0.16 car coordinates)
			movefa	r19,r2
			movefa	r20,r3
			movefa	r21,r4

		; torque = point X force
			movefa	r10,r29
			imultn	r3,r21
			imacn	r4,r20
			resmac	r28
			sha	r0,r28
			add	r28, r29
			movefa	r11,r28
			moveta	r29,r10

			neg	r21
			imultn	r2,r21
			imacn	r4,r19
			resmac	r29
			sha	r0,r29
			add	r29,r28
			movefa	r12,r29
			moveta	r28,r11

			imultn	r2,r20
			imacn	r3,r19
			resmac	r28
			sha	r0,r28
			add	r28,r29
			movefa	r22,r28
			moveta	r29,r12
.endif
		; see if we should play a crash
			movefa	r23,r29
			or	r29,r29
			addqt	#4,r29
			movefa	r7,r19		; get force magnitude
			movefa	r8,r20
			movefa	r9,r21
			abs	r19
			abs	r20
			abs	r21
			load	(r29),r28		; current sound
			add	r20,r19
			add	r21,r19
			cmpq	#0,r28
			jr	NE,nocrsnd
			moveq	#1,r28
				store	r28,(r29)	; crash sound
				addqt	#4,r29
				shlq	#14,r28
				subqt	#1,r28		; temp now contains 0x3fff
				shlq	#1,r19
				sat16	r19
				shrq	#1,r19
				store	r19,(r29)	; store volume
				addqt	#4,r29
				store	r28,(r29)	; store position (0x3fff)
nocrsnd:
		; finally, update the displacement fraction (current is in "be")
			cmp	r28,r1
			jr	MI,notnew
			nop
				moveta	r1,r22
notnew:

skipcrash:

	subq	#1,r16
	jump	NZ,(r27)
	nop

;
; update car forces, etc.
;
	moveq	#(CAR_FORCE-32),r29
	addqt	#32,r29
	add	r22,r29
	movefa	r7,r2
	movefa	r8,r3
	movefa	r9,r4
	store	r2,(r29)
	addqt	#4,r29
	store	r3,(r29)
	addqt	#4,r29
	store	r4,(r29)
	addqt	#4,r29
	movefa	r10,r2
	movefa	r11,r3
	movefa	r12,r4
	store	r2,(r29)
	addqt	#4,r29
	store	r3,(r29)
	addqt	#4,r29
	store	r4,(r29)

.if THROWOUT
; update car position
	movefa	r22,r28
	movei	#abortall,r29
	cmpq	#0,r28
	jump	EQ,(r29)
	nop
		shrq	#7,r28
		imult	r28,r8
		imult	r28,r9
		imult	r28,r10
		sharq	#(CAR_RSHFT+3),r8
		sharq	#(CAR_RSHFT+3),r9
		sharq	#(CAR_RSHFT+3),r10
.if CAR_POSN
		moveq	#CAR_POSN,r28
		add	r22,r28
.else
		move	r22,r28
.endif
		load	(r28),r2
		addqt	#4,r28
		load	(r28),r3
		addqt	#4,r28
		load	(r28),r4
		subqt	#8,r28
		add	r8,r2
		add	r9,r3
		add	r10,r4
		store	r2,(r28)
		addqt	#4,r28
		store	r3,(r28)
		addqt	#4,r28
		store	r4,(r28)
.endif	;; THROWOUT

abortall:
;
; cancel 16.16 division
;
	movei	#G_DIVCTRL,r28
	moveq	#0,r29
	store	r29,(r28)

	movefa	r0, r0
	movefa	r1, r1

; GASM REGUNDEF poly1 ; crash.gas:970
; GASM REGUNDEF poly2 ; crash.gas:971
; GASM REGUNDEF ax ; crash.gas:972
; GASM REGUNDEF ay ; crash.gas:973
; GASM REGUNDEF az ; crash.gas:974
; GASM REGUNDEF bx ; crash.gas:975
; GASM REGUNDEF by ; crash.gas:976
; GASM REGUNDEF bz ; crash.gas:977
; GASM REGUNDEF nx ; crash.gas:978
; GASM REGUNDEF ny ; crash.gas:979
; GASM REGUNDEF nz ; crash.gas:980
; GASM REGUNDEF an ; crash.gas:981
; GASM REGUNDEF bn ; crash.gas:982
; GASM REGUNDEF ae ; crash.gas:983
; GASM REGUNDEF be ; crash.gas:984
; GASM REGUNDEF edgenorms ; crash.gas:985
; GASM REGUNDEF divider ; crash.gas:986
; GASM REGUNDEF adjust ; crash.gas:987
; GASM REGUNDEF vectors ; crash.gas:988
; GASM REGUNDEF car_numedges ; crash.gas:989
; GASM REGUNDEF caredges ; crash.gas:990
; GASM REGUNDEF poly_numedges ; crash.gas:991
; GASM REGUNDEF ix ; crash.gas:992
; GASM REGUNDEF iy ; crash.gas:993
; GASM REGUNDEF iz ; crash.gas:994
; GASM REGUNDEF user ; crash.gas:995
; GASM REGUNDEF ox ; crash.gas:996
; GASM REGUNDEF oy ; crash.gas:997
; GASM REGUNDEF oz ; crash.gas:998
; GASM REGUNDEF count ; crash.gas:999
; GASM REGUNDEF skiploop ; crash.gas:1000
; GASM REGUNDEF edgeloop ; crash.gas:1001
; GASM REGUNDEF points ; crash.gas:1002
; GASM REGUNDEF edges ; crash.gas:1003
; GASM REGUNDEF geoband ; crash.gas:1004
; GASM REGUNDEF portptr ; crash.gas:1005
; GASM REGUNDEF dispfrac ; crash.gas:1006

; END crash.gas
		; all registers except polys and tPolys (maybee) are wiped out by now
		; restore them, as necessary
		loadw	(r0),r9
		movei	#closetop,r13
		move	r9,r18
		shlq		#28,r9		; strip flags
		movefa	r31,r29
		shrq		#27, r9		; number words to bytes (multiply by 2)
		movei	#SURFS_END,r14
		add	r29,r14
		load	(r14),r14

colided:	; increment pointers (tPolys maybee temporary)

		addqt	#6, r0
		addqt	#10,r1		; 10 for r and center
		add		r9, r0
		add		r9, r1
		add		r9, r1
		add		r9, r1
enterclose:
		; check for null		
		loadw	(r0), r9
		move	r9,r18
		shlq	#28,r9
		shrq	#27,r9
		or	r9, r9
		jump		NE, (r13)
		nop

		; It's a NULL!!!!		Is it the last one?
		addqt	#2,r0
		loadw	(r0),r9
		move	r9,r18
		shlq	#28,r9
		cmp		r14, r0
		jump		MI, (r13)
		shrq	#27,r9


;
; if we're passing through a portal, zero all collision forces
;
		movefa	r30,r28
		movei	#CUR_PORTAL,r29
		add	r28,r29
		load	(r29),r29
		movei	#doneclose,r27
		cmpq	#0,r29
		movei	#CAR_FORCE,r29
		jump	EQ,(r27)
		add	r28,r29
			moveq	#0,r28
			store	r28,(r29)
			addqt	#4,r29
			store	r28,(r29)
			addqt	#4,r29
			store	r28,(r29)

doneclose:

; GASM REGUNDEF polys ; close.gas:257
; GASM REGUNDEF tPolys ; close.gas:258
; GASM REGUNDEF xc ; close.gas:259
; GASM REGUNDEF yc ; close.gas:260
; GASM REGUNDEF zc ; close.gas:261
; GASM REGUNDEF xp ; close.gas:262
; GASM REGUNDEF yp ; close.gas:263
; GASM REGUNDEF zp ; close.gas:264
; GASM REGUNDEF closeList ; close.gas:265
; GASM REGUNDEF numSides ; close.gas:266
; GASM REGUNDEF polyRad ; close.gas:267
; GASM REGUNDEF carRad ; close.gas:268
; GASM REGUNDEF bColided ; close.gas:269
; GASM REGUNDEF outerLoop ; close.gas:270
; GASM REGUNDEF radius ; close.gas:271
; GASM REGUNDEF dist ; close.gas:272
; GASM REGUNDEF ox ; close.gas:273
; GASM REGUNDEF oy ; close.gas:274
; GASM REGUNDEF oz ; close.gas:275

; END close.gas

	movei	#drvloop,r28
	jump	(r28)
	nop

drvloopend:

; BEGIN drive.gas
; drive.gas
;
;	add forces from
;		drag: Cd * v^3
;		thrust: throttle * head
;		lateral gription: normal * mu * (velocity dot* left)
;		crash: reflect around wall normal and multiply by energy loss factor
;		normal force: K/distance from surface + hysterysis
;		gravity: mg
;	into a single force vector

; define PROACTIVE to be 0 if thrust and gravity are already done for us, 1 otherwise
PROACTIVE 	EQU	1
GRAVITY		EQU	3500
ANALOG_STEERING EQU 1

; BEGIN joypad.inc
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Header File: JOYPAD.INC
;              Jaguar Joypad Equates
;
; NOTICE: This file has been incorporated into JAGUAR.INC. This file
;         is for compatibility reasons only. You should be using
;	   JAGUAR.INC instead.
        

; END joypad.inc

	MUs	equ	22	; static coef of friction
	MUd	equ	11	; dynamic coef of friction
	MUm	equ	31	; coef of friction mask (this is max)
	MOI	equ	2	; moment of inertia	WAS 6
	BRAKE_POWER	equ	$7000	; horsePower equivalent for the brakes
	ENGINE_POWER	equ	2700 ;5400
	SPIN_THRESHOLD	equ	$4000000

;- Register defines ----------------------------------------------

; legacy REGEQU vx => R0 ; drive.gas:29
; legacy REGEQU vy => R1 ; drive.gas:30
; legacy REGEQU vz => R2 ; drive.gas:31
; legacy REGEQU horsePower => R3 ; drive.gas:32
; legacy REGEQU Cd => R3 ; drive.gas:33
; legacy REGEQU want => R3 ; drive.gas:34

; legacy REGEQU fx => R4 ; drive.gas:36
; legacy REGEQU fy => R5 ; drive.gas:37
; legacy REGEQU fz => R6 ; drive.gas:38
; legacy REGEQU tx => R7 ; drive.gas:39
; legacy REGEQU ty => R8 ; drive.gas:40
; legacy REGEQU tz => R9 ; drive.gas:41

; rotation matrix
; legacy REGEQU xrite => r10 ; drive.gas:44
; legacy REGEQU yrite => r11 ; drive.gas:45
; legacy REGEQU zrite => r12 ; drive.gas:46
; legacy REGEQU xdown => r13 ; drive.gas:47
; legacy REGEQU ydown => r14 ; drive.gas:48
; legacy REGEQU zdown => r15 ; drive.gas:49
; legacy REGEQU xhead => r16 ; drive.gas:50
; legacy REGEQU yhead => r17 ; drive.gas:51
; legacy REGEQU zhead => r18 ; drive.gas:52

; 3d temps
; legacy REGEQU tempx => R19 ; drive.gas:55
; legacy REGEQU tempy => R20 ; drive.gas:56
; legacy REGEQU tempz => R21 ; drive.gas:57

; legacy REGEQU LA => R22 ; drive.gas:59
; legacy REGEQU nf => R23 ; drive.gas:60
; legacy REGEQU wheel => R24 ; drive.gas:61

; legacy REGEQU wx => R25 ; drive.gas:63
; legacy REGEQU wy => R26 ; drive.gas:64
; legacy REGEQU wz => R27 ; drive.gas:65

; no 28, 29 - temps

; legacy REGEQU le => R30 ; drive.gas:69
; legacy REGEQU FA => R31 ; drive.gas:70

; resused
; legacy REGEQU groundProp => r7 ; drive.gas:73
; legacy REGEQU tirePtr => r8 ; drive.gas:74
; legacy REGEQU attempt => r9 ; drive.gas:75
; legacy REGEQU t2x => r13 ; drive.gas:76
; legacy REGEQU t2y => r14 ; drive.gas:77
; legacy REGEQU t2z => r15 ; drive.gas:78

; alternate register usage
; temp addresses
; legacy REGEQU ta1 => r0 ; drive.gas:82
; legacy REGEQU ta2 => r1 ; drive.gas:83
; legacy REGEQU ta3 => r2 ; drive.gas:84
; legacy REGEQU ta4 => r3 ; drive.gas:85
; legacy REGEQU ta5 => r4 ; drive.gas:86

; alternate matrix r10-r18
;db			REGEQU	r12
;xdown		REGEQU	r13
;ydown		REGEQU	r14
;zdown		REGEQU	r15
; legacy REGEQU thePlayer => r30 ; drive.gas:93
; legacy REGEQU thrust => r20 ; drive.gas:94
; legacy REGEQU brakePower => r21 ; drive.gas:95
; legacy REGEQU newTireSpd => r22 ; drive.gas:96
; legacy REGEQU plyrPtr => r28 ; drive.gas:97

.if 0
;DEBUG - put fake surfdata in player struct
		movefa	r30, r28
		movei	#CAR_SURFDATA,r29
		add		r29, r28
		movei	#$540b16, r29
		store	r29, (r28)
		addqt	#4, r28
		store	r29, (r28)
		addqt	#4, r28
		store	r29, (r28)
		addqt	#4, r28
		store	r29, (r28)
.endif

;regPlay:
		; load matrix
		movefa	r30, r28
		addqt	#CAR_MATRIX,r28	; 12 to the start of the matrix

;		loadw	(temp),xrite		; Fetch Turtle into registers
;		addq		#2,temp
;		loadw	(temp),xdown
;		addq		#2,temp
;		loadw	(temp),xhead
;		addq		#2,temp
;		loadw	(temp),yrite
;		addq		#2,temp
;		loadw	(temp),ydown
;		addq		#2,temp
;		loadw	(temp),yhead
;		addq		#2,temp
;		loadw	(temp),zrite
;		addq		#2,temp
;		loadw	(temp),zdown
;		addq		#2,temp
;		loadw	(temp),zhead

		loadw	(r28),r10		; Fetch Turtle into registers
		addq		#2,r28
		loadw	(r28),r11
		addq		#2,r28
		loadw	(r28),r12
		addq		#2,r28
		loadw	(r28),r13
		addq		#2,r28
		loadw	(r28),r14
		addq		#2,r28
		loadw	(r28),r15
		addq		#2,r28
		loadw	(r28),r16
		addq		#2,r28
		loadw	(r28),r17
		addq		#2,r28
		loadw	(r28),r18

		;load verocity vector
;		movefa	thePlayer, temp
;		addqt	#CAR_VELOCITY,temp
; RETAIL COMPAT: car-velocity base is already addressed at this point.
;		addqt	#32,temp
		addqt	#4,r28

		load		(r28), r0
		addqt	#4,r28
		load		(r28), r1
		addqt	#4,r28
		load		(r28), r2
		
		;load rotational verocity vector
;		movefa	thePlayer, temp
;		addqt	#32,temp
;		addqt	#(CAR_OMEGA-32), temp
		addqt	#(CAR_OMEGA-CAR_VELOCITY-8), r28
		load		(r28), r25
		addqt	#4,r28
		load		(r28), r26
		addqt	#4,r28
		load		(r28), r27

		;load force vector
;		movefa	thePlayer, temp
;		addqt	#32,temp
;		addqt	#(CAR_FORCE-32), temp
		addqt	#(CAR_FORCE-CAR_OMEGA-8), r28
		load		(r28), r4
		addqt	#4,r28
		load		(r28), r5
		addqt	#4,r28
		load		(r28), r6

		; check for spinout
		or		r5, r5		; ;onloy add if touching the ground
		subqt	#(CAR_FORCE+8-CAR_SPIN), r28
		jr		EQ, _CDLOCAL_10_203
		load		(r28), r19
			; add rotational total
			move		r25, r20
			abs		r20
			move		r26, r21
			abs		r21
			add		r21, r20
			move		r27, r21
			abs		r21
			add		r21, r20
			add		r20, r19
			store	r19, (r28)
		_CDLOCAL_10_203:
		movei	#SPIN_THRESHOLD, r20
		cmp		r19, r20
		jr		PL, _CDLOCAL_20_217
			; add a rotational drag
			move	r25, r7
			move	r26, r8
			move	r27, r9
			sharq	#4,r7
			sharq	#4,r8
			sharq	#4,r9
			sub	r7,r25
			sub	r8,r26
			sub	r9,r27
		_CDLOCAL_20_217:

		; load the torque vector
		addqt	#(CAR_TORQUE-CAR_SPIN), r28
;		addqt	#4,temp
		load		(r28), r7
		addqt	#4,r28
		load		(r28), r8
		addqt	#4,r28
		load		(r28), r9

		add		r7,r25
		add		r8,r26
		add		r9,r27
.if PROACTIVE
		; add gravity
		movei	#GRAVITY, r29
		add		r29, r1
.endif
		; compute drag force vector
		move		r0, r19
		move		r1, r20
		move		r2, r21
		sharq	#6, r19	; tone it down a bit
		sharq	#6, r20
		sharq	#6, r21
		neg		r19
		neg		r20
		neg		r21
		add		r19, r4
		add		r20, r5
		add		r21, r6

;		imultn	vx, vx	; magnitude squared
;		imacn	vy, vy
;		imacn	vz, vz
;		resmac	fx
;
;;		moveq	#16, Cd	; based on surface
;		sharq	#8, fx	; tone it down a bit
;		neg		fx		; drag is in the opposite direction as velocity
;;		imult	Cd, fx
;		move		fx, fy
;		move		fx, fz
;
;		imult	vx, fx
;		imult	vy, fy
;		imult	vz, fz
;		sharq	#4, fx	; tone it down a bit
;		sharq	#4, fy
;		sharq	#4, fz


		; compute steer vector (rotate rite vector)

		; sum tire forces -----------------------------------------------------

		; save some registers
		moveta	r13, r13		; used for more variables
		moveta	r14, r14
		moveta	r15, r15
		moveta	r16, r16		; store while main bank matrix is steered
		moveta	r17, r17
		moveta	r18, r18
		moveta	r10, r10
		moveta	r11, r11
		moveta	r12, r12
		; load steer amount
;		addqt	#(CAR_TURN-CAR_TORQUE), temp
;		movei	#(CAR_TURN-CAR_TORQUE),temp2
		movei	#(CAR_TURN), r28	; after last point
		movefa	r30, r29
		add		r29, r28
		moveta	r4, r9				; push r4
.if INTERPOLATE
		load	(r28), r4			; r4 is defined as yaw in turt.gas
.else
		loadw	(r28), r4			; r4 is defined as yaw in turt.gas
.endif
		moveta	r28,r28
		JSR_ROTY
	add r4, r31
		movefa	r9, r4				; pop r4
		movefa	r28,r28			; pop temp

; do axial accel setup in alternate registers ---------------------------------
		; check buttons
;		movefa	thePlayer, temp
.if ANALOG_STEERING
;		movei	#CAR_GAS,temp2
;		add		temp2, temp
		addqt	#(CAR_GAS-CAR_TURN), r28
		loadw	(r28), r29

		movei	#ENGINE_POWER, r3 ; 5400 4640
		imult	r3, r29
		sharq	#7, r29
		moveta	r29, r20
.else
;		movei	#CAR_CTRL,temp2
		subqt	#(CAR_GAS-CAR_CTRL), r28
;		add		temp2, temp
		load		(r28), r29

		movei	#5400, r3 ; 5400 4640
		move		r29, r24
		move		r29, r28
		shlq		#(31-FIRE_B), r28
		shlq		#(31-FIRE_C), r29
		shrq		#31, r28
		sharq	#31, r29
		add		r29, r28
		imult	r3, r28
		movei	#BRAKE_POWER, r3
		moveta	r28, r20
		shlq		#(31-FIRE_A), r24
		sharq	#31, r24
		imult	r3, r24
		moveta	r24, r21
.endif
		;figure out the brakes
		subqt	#(CAR_GAS-CAR_CTRL), r28
		load		(r28), r29

		movei	#BRAKE_POWER, r3
		shlq		#(31-FIRE_A), r29
		sharq	#31, r29
		imult	r3, r29
		shlq		#3, r29
		moveta	r29, r21

; do axial accel setup in alternate register ---------------------------------

		;change to 16.16 div
		movei	#G_DIVCTRL, r28
		moveq	#1, r29
		store	r29, (r28)

		; for wheel := 0 to 3
		moveq	#4, r24
wheelLp:
			; compute vTire ------------------------
				; load wheel posn
				movei	#(CAR_POSNS + (CAR_NUM_PNTS*6) + 6), r28	; after last point
				movefa	r30, r29
				add		r29, r28
				moveq	#12, r29	; size of wheel - twin points
				mult		r24, r29
				sub		r29, r28
				loadw	(r28), r13
				addqt	#2, r28
				loadw	(r28), r14
				addqt	#2, r28
				loadw	(r28), r15

			rorq	#16, r25
			rorq	#16, r26
			rorq	#16, r27
				move		r0, r19
				move		r1, r20
				; x velocity
				imultn	r14, r27
				imacn	r15, r26
				resmac	r28
				; y velocity
				imultn	r15, r25
				imacn	r13, r27
				resmac	r29
				; convert to radians - motibi by 12.5 (12.56637)
				shlq		#2, r28
				shlq		#2, r29
				add		r28, r19
				sub		r29, r20
				shlq		#1, r28
				shlq		#1, r29
				add		r28, r19
				sub		r29, r20
				sharq	#4, r28
				sharq	#4, r29
				add		r28, r19
				sub		r29, r20
				; z velocity
				neg		r13
				imultn	r14, r25
				imacn	r13, r26
				resmac	r28

				neg		r15
				shlq		#2, r28
				move		r2, r21
				add		r28, r21
				shlq		#1, r28
				add		r28, r21
				sharq	#4, r28
				add		r28, r21
			rorq	#16, r25
			rorq	#16, r26
			rorq	#16, r27

				; end vTire compute  ------------------------
			; compute needed lateral accel
				; normalize vTire
				move		r19, r29
				abs		r29
				move		r20, r28
				abs		r28
				or		r29, r28
				move		r21, r29
				abs		r29
				or		r29, r28
				normi	r28, r30
				addqt	#9, r30
				sha		r30, r21
				sha		r30, r19
				sha		r30, r20

			; compute lateral velocity
			imultn	r19, r10	; R dot vTire
			imacn	r20, r11
			imacn	r21, r12
			resmac	r22			; in 10.22 format?
			; compute forward velocity
			imultn	r19, r16	; F dot vTire
			imacn	r20, r17
			imacn	r21, r18
			resmac	r31			; in 10.22 format?

			neg		r30			; restore shift amount
			addqt	#12, r30		; 2 bits short of restoring matrix mults
			sha		r30, r31		; shift to 18.14 (velocity 20.12)
			addqt	#2, r30		; divide lateral by 4 (num of wheels)
			sha		r30, r22

			; compute normal force
			movei	#(CAR_SHOCKS-4), r8	; load from player struct
			movefa	r30, r19
			add		r19, r8
			move		r24, r19			; index into shock array :: player.CAR_SHOCKS[wheel]
			shlq		#2, r19
			;sharq	#2, LA				; divide needed LA by 4 (# of tires)
			add		r19, r8
			load		(r8), r23
			addqt	#(CAR_OSHOCKS-CAR_SHOCKS), r8
			load		(r8), r29		; temp2 <= previous shock position
			sub		r23, r29				; shock movement
			store	r23, (r8)
			neg		r29
			addqt	#(CAR_TIRE_SPD-CAR_OSHOCKS), r8	; get tire speed while we're here
			shlq		#1, r29
			load		(r8), r20		; tempy <= previous tire speed
			add		r29, r23
			sat24	r23					; normal force can not be negative (near maximum shock extention and velocity would produce this)
			moveq	#5, r29				; k => temp2
			mult		r29, r23				; the normal force => nf
			; compute torque to apply to tireSpeed
			movefa	r20, r29
			moveta	r31, r22
			sub		r20, r31				; difference between wheel and ground speed
			sharq	#4, r31				; half energy loss
			neg		r31
			add		r29, r31
			move		r31, r9
;			movefa	brakePower, temp2
;			add		temp2, tempy

;			movefa	thrust, FA			; this is the official attempted forward force (negated)
			; get surface properties
			move		r8, r28			; don't malumate tirePtr	
			addqt	#(CAR_SURFDATA-CAR_TIRE_SPD), r28	;
			load		(r28), r7		; groundProp <= surface drag | MUs | MUd
			; prepare LA, FA for multiplication
			move		r31, r21
			move		r22, r28
			abs		r28
			abs		r21
			or		r28, r21
			normi	r21, r29
			addqt	#9, r29
			move		r31, r21
			sha		r29, r21
			sha		r29, r28

			neg		r29		; FNe
			; compute total needed acceleration from FA and LA
			imultn	r21, r21
			imacn	r28, r28
			resmac	r3				; the square of the total attempted force

			; compute maximum static friction force
			moveq	#MUm, r21			; us - static friction coef
			and		r7, r21
			sharq	#5, r23				; turn nf into 16 bits - force is nf e 15?
			mult		r23, r21
			; compare needed lateral with max static - decide between forces
			shlq		#1, r29
			addqt	#12, r29

			; square maximum static force (temp)
			normi	r21, r19
			addqt	#9, r19
			sh		r19, r21
			neg		r19
			mult		r21, r21
			shlq		#1, r19
			addqt	#14, r19

			sh		r29, r3
			sh		r19, r21

;	move		wheel, temp2
;	subqt	#1, temp2
;	shlq		#4, temp2
;	movei	#$17040, tempx
;	add		temp2, tempx
;	store	LA, (tempx)
;	addqt	#4, tempx
;	store	want, (tempx)
;	addqt	#4, tempx
;	store	temp, (tempx)
;	nop
			; prepare LA, FA for multiplication
			move		r31, r29
			move		r22, r28
			abs		r28
			abs		r29
			normi	r28, r30
			normi	r29, r29
			addqt	#9, r30
			addqt	#9, r29
			sha		r30, r22
			sha		r29, r31

			neg		r30
			addqt	#16, r30
			neg		r29	; Fe
;			addqt	#16, temp2

			; decide between forces
			cmp		r3, r21			; cmp	neededf, maxf
			movei	#useLA, r19
			jump		HI, (r19) ;useLA -- original retail condition
;			jump		(tempx) ;useLA
			moveq	#0, r21
				moveta	r28, r28
				moveta	r29, r29
;	movei	#$17010, tempx
;	store	want, (tempx)
;	addqt	#4, tempx
				;sqrt:
					normi	r3, r29
					movei	#(sqrtTabM512), r28
					addqt	#13, r29	; size to 1K max word entries
					bset		#0, r29		; shift an even amount only
					sh		r29, r3
					neg		r29		; shift amount for return flight
					add		r28, r3
					sharq	#1, r29		; return shift is half as big
					bclr		#0, r3
					addqt	#11, r29	; scale of table
					loadw	(r3), r3
					sh		r29, r3

				shlq		#6, r3
				shrq		#8, r7		; move ud to front of surfprop word
				moveq	#MUm, r21		; ud - dynamic friction coef
				and		r7, r21
				shrq		#8, r7		; move surfdrag to front of surfprop word
				imult	r23, r21
;	store	want, (tempx)
;	addqt	#4, tempx
;	store	tempz, (tempx)
				div		r3, r21		; wanted/getting is the scaling factor
;	addqt	#4, tempx
;	store	want, (tempx)
				; bring em back
				movefa	r28, r28
				movefa	r29, r29
				shrq		#1, r21			; make result .15
				imult	r21, r22
				imult	r21, r31
				sharq	#15, r22
				sharq	#15, r31

useLA:
			; compute next tireSpeed
;			shlq		#1, attempt
			move		r31, r28
			sha		r29, r28
			sub		r28, r9		; hey, FA is normi'ed
			shlq		#4, r9
			add		r28, r9
			movefa	r22, r28
			add		r28, r9
			move		r9, r28		; axle drag
			abs		r28
			normi	r28, r19
			move		r9, r28
			addqt	#9, r19
			sha		r19, r28
			move		r28, r20
			neg		r19
			imult	r28, r28
			moveq	#3, r3
			sharq	#16, r28
			imult	r3, r19
			imult	r20, r28	; cubed
			addqt	#31, r19
			sha		r19, r28
			sub		r28, r9
			move		r9, r28		; axle drag
			sharq	#8, r28
			sub		r28, r9
			;brakes anyone?
			move	r9, r28
			abs	r9
			movefa	r21,r19
			add	r19,r9
			jr	PL, _CDLOCAL_22_637
			btst	#31, r28
				moveq	#0,r9	;don't brake beyond 0
			_CDLOCAL_22_637:
			jr	EQ, _CDLOCAL_24_641
			neg		r21	; moved from skid sound stuf
				neg	r9
			_CDLOCAL_24_641:
			;end brakes
			store	r9, (r8)			; write out next tireSpeed as FV
			addqt	#16, r29
			; skid sound stuf
			;neg		tempz	; moved up 8 lines
			addqt	#(CAR_SLIDE-CAR_TIRE_SPD), r8	; get tire speed while we're here
			store	r21, (r8)			; write out next skid amount
			; add surfdrag
			mult		r23, r7	; maximum drag force

			; FA is now the proper forward acc
			move		r16, r19	; force is along head vector
			move		r17, r20
			move		r18, r21
			imult	r31, r19
			imult	r31, r20
			imult	r31, r21
			; shift
			sha		r29, r19
			sha		r29, r20
			sha		r29, r21

			add		r19, r4		; add to total force
			add		r20, r5
			add		r21, r6

			; add thrust torque

			; LA is now the proper lateral acc
			move		r10, r19	; force is along right vector
			move		r11, r20
			move		r12, r21
			imult	r22, r19
			imult	r22, r20
			imult	r22, r21
			; shift
			sha		r30, r19
			sha		r30, r20
			sha		r30, r21

			sub		r19, r4		; add to total force
			sub		r20, r5
			sub		r21, r6

			; add gription torque
			; x torque
			imultn	r14, r21
			imacn	r15, r20
			resmac	r28

			; y torque
			neg		r15
			imultn	r13, r21
			imacn	r15, r19
			resmac	r29
.if MOI
			shlq		#MOI, r28		; shift to 16.16
			shlq		#MOI, r29		; shift to 16.16
.endif
			sub		r28, r25
			sub		r29, r26
			; z torque
			imultn	r13, r20
			imacn	r14, r19
			resmac	r28
.if MOI
			shlq		#MOI, r28		; shift to 16.16
.endif
			sub		r28, r27

			; add tire normal force
			movefa	r13, r19	; force is along up vector
			movefa	r14, r20
			movefa	r15, r21
			imult	r23, r19
			imult	r23, r20
			imult	r23, r21
			; shift
			sharq	#14, r19
			sharq	#14, r20
			sharq	#14, r21

			sub		r19, r4		; add to total force
			sub		r20, r5
			sub		r21, r6

			; add normal force torque
			; y torque
			imultn	r13, r21
			imacn	r15, r19
			resmac	r28
			; z torque
;			neg		tempx
			imultn	r13, r20
			imacn	r14, r19
			resmac	r29
.if MOI
			shlq		#MOI, r28		; shift to 16.16
			shlq		#MOI, r29		; shift to 16.16
.endif
			sub		r28, r26
			sub		r29, r27

			; x torque
			neg		r15
			;move		tempy, temp	; so that the second term is subtracted
;			neg		t2z
			imultn	r14, r21
			imacn	r15, r20
			resmac	r28
.if MOI
			shlq		#MOI, r28		; shift to 16.16
.endif
			sub		r28, r25

		; end for wheel
		btst		#0, r24
		movei	#wheelLp, r28
		jump		EQ, (r28)
		subq		#1, r24

		movefa	r16, r16		; return primary matrix to main reg
		movefa	r17, r17		; bank now that front wheels are done
		movefa	r18, r18
		movefa	r10, r10
		movefa	r11, r11
		movefa	r12, r12

		jump		NE, (r28)		; if more wheels to do
		nop

;			; load tire coord
;			; load a fake 'up' pNormal
;			; dot tire vector with normal


		; -----------------------------------------------------------------------------

		; dampen velocities and rotations
			; manhaten magnatude
			move		r25, r28
			abs		r28
			move		r27, r29
			abs		r29
			add		r29, r28
;			move		wy, temp2
;			abs		temp2
;			add		temp2, temp
			; check magnatude
			shrq		#19, r28
			jr		NE, _CDLOCAL_58_797
			nop
				sharq	#2,r25
;				sharq	#2,wy
				sharq	#2,r27
			_CDLOCAL_58_797:
		; compute new posn, roll, yaw, pitch
		movefa	r30, r28
		addqt	#CAR_VELOCITY,r28
		addqt	#8,r28
;		load		(temp), vx
;		addqt	#4,temp
;		load		(temp), vy
;		addqt	#4,temp
;		load		(temp), vz

		add		r4, r0
		add		r5, r1
		add		r6, r2

.if 1
		;;; kill small velocities
		sharq	#8,r0
		sharq	#8,r1
		sharq	#8,r2
		rorq	#24,r0
		rorq	#24,r1
		rorq	#24,r2

		;;; ditto for small rotations
;		sharq	#17,wx
		sharq	#16,r26
;		sharq	#17,wz
;		rorq	#15,wx
		rorq	#16,r26
;		rorq	#15,wz
.endif
		store	r2, (r28)
		subqt	#4,r28
		store	r1, (r28)
		subqt	#4,r28
		store	r0, (r28)

		; move position according to velocity
		movefa	r30, r28
		;addqt	#CAR_POSN,temp
		;movei	#ROT_MATRIX, temp	; load posn
		load		(r28), r19
		addqt	#4,r28
		load		(r28), r20
		addqt	#4,r28
		load		(r28), r21

		add		r0, r19
		add		r1, r20
		add		r2, r21

		store	r21, (r28)
		subqt	#4,r28
		store	r20, (r28)
		subqt	#4,r28
		store	r19, (r28)
		
		; rotate stuf
;		movefa	thePlayer, temp
;		movei	#CAR_OMEGA, temp2	; load posn
;		add		temp2, temp
		addqt	#32, r28
		addqt	#CAR_OMEGA-32, r28
		store	r25, (r28)
		addqt	#4,r28
		store	r26, (r28)
		addqt	#4,r28
		store	r27, (r28)

		;change to 32.0 div
		movei	#G_DIVCTRL, r28
		moveq	#0, r29
		store	r29, (r28)
;	movei	#$17010, temp
;	store	wx, (temp)
;	addqt	#4,temp
;	store	wy, (temp)
;	addqt	#4,temp
;	store	wz, (temp)

; ----------------------------------------------------------------------
; cleanup
; GASM REGUNDEF vx ; drive.gas:883
; GASM REGUNDEF vy ; drive.gas:884
; GASM REGUNDEF vz ; drive.gas:885
