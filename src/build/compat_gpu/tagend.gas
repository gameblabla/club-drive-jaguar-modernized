; BEGIN 68kequ.inc
; the definitions given here must agree with the table
; in gpufix.s!!!

SYMBOL		EQU	$543b0700
bgpprog       	EQU	SYMBOL+0
cgpprog       	EQU	SYMBOL+1
egpprog       	EQU	SYMBOL+2
rgpprog       	EQU	SYMBOL+3
sn       	EQU	SYMBOL+4
sqrtTabM512    	EQU	SYMBOL+5	; sqrtTab - 512
car_dat       	EQU	SYMBOL+6
player       	EQU	SYMBOL+7
screen_addr	EQU	SYMBOL+8
SKY		EQU	SYMBOL+9
atanTab		EQU	SYMBOL+10
itCar		EQU	SYMBOL+11
twoplayer	EQU	SYMBOL+12
framecnt	EQU	SYMBOL+13
gametype	EQU	SYMBOL+14
dash		EQU	SYMBOL+15
digitfont	EQU	SYMBOL+16
cmpssfont	EQU	SYMBOL+17
mapscale	EQU	SYMBOL+18
maporig		EQU	SYMBOL+19
speedfont	EQU	SYMBOL+20
scoreinc	EQU	SYMBOL+21
dotloc		EQU	SYMBOL+22
dotimg		EQU	SYMBOL+23
tnyfont		EQU	SYMBOL+24
pbprog		EQU	SYMBOL+25
showcoord	EQU	SYMBOL+26
pcprog		EQU	SYMBOL+27
debugflg	EQU	SYMBOL+28
prprog		EQU	SYMBOL+29
animateprg	EQU	SYMBOL+30
animateparam	EQU	SYMBOL+31
mbands		EQU	SYMBOL+32
gameover	EQU	SYMBOL+33
splitscrn	EQU	SYMBOL+34
gpu_do		EQU	SYMBOL+35
TPNTADDR	EQU	SYMBOL+36
ENDTPNTS	EQU	SYMBOL+37
SKYHIGH		EQU	SYMBOL+38
fps		EQU	SYMBOL+39
playspd		EQU	SYMBOL+40
; END 68kequ.inc
; BEGIN 3d.inc
loadIt	EQU	$00f03010
Overlay	EQU	G_RAM+$38

; END 3d.inc

; global register defines
; legacy REGEQU returnR => r0 ; 3dend.gas:13
; legacy REGEQU innerLoop => R27 ; 3dend.gas:14
; legacy REGEQU temp => R28 ; 3dend.gas:15
; legacy REGEQU temp2 => R29 ; 3dend.gas:16
; legacy REGEQU return => R31 ; 3dend.gas:17

; global alternate register usage
; legacy REGEQU ALTbndflags => R26 ; 3dend.gas:20
; legacy REGEQU ALTbndlist => R27 ; 3dend.gas:21
; legacy REGEQU ALTplayer => R30 ; 3dend.gas:22
; legacy REGEQU ALTband => R31 ; 3dend.gas:23

ONE_FRAME	EQU	10
INTERPOLATE	EQU	0

	ORG	Overlay
	; can use up to 3fac (described in 3dds.inc)

; BEGIN 3dds.inc
;------------------------------------------------------------------
; 3dds.inc
;	defines addresses for 3d data structures
;------------------------------------------------------------------

;PHRASE_ALIGN equ			((@1 + 7) & $fffffff8)

HUD1		equ	$60000		; player 1 heads up display
HUD2		equ	$61000		; player 2 HUD
PAUSECRY	equ	$62000		; "paused" bitmap

DS_BASE		equ	$6a200

ASCRN1		equ	$20000		; player 1 screen 1
BSCRN1		equ	$2ed80		; player 2 screen 1
ASCRN2		equ	$40000
BSCRN2		equ	$4ed80		; player 2 screen 2
ATOGGLE		equ	$60000

MARKADDR	EQU	$1fff00
LASTTIME	EQU	$1feefc
TIMEARRAY	EQU	$1ff000
DEBUG		EQU	$1ffe00

; data sizes for fixed structures (fixed in terms of global 3d coords)
MAX_VECTORS		equ	200 ; normals + verticie vectors
MAX_POINTS		equ	810;380 ; vertices
MAX_SURFS			equ	550;300 ; polygons
MAX_EDGES			equ	1200;600 ; edges
MAX_DIVIDERS		equ	550;300 ; dividing planes

; data sizes for mobile (car) structures
MAX_MVECTORS		equ	100 ; normals + verticie vectors
MAX_COLORS		equ	200  ; the only kind of colors computed ; 90
MAX_MPOINTS		equ	200 ; vertices
MAX_MSURFS		equ	90  ; trigons
MAX_MEDGES		equ	300 ; edges
MAX_MDIVIDERS		equ	100 ; dividing vectors

; player car driving data structures
; BEGIN car.inc
;------------------------------------------------------------------
; car.inc
;	defines structures for car
;	all addresses are relative
;------------------------------------------------------------------

CAR_POSN		equ	0										; x, y, z longwords of position
CAR_MATRIX	equ	12										; 3x3 matrix of words
CAR_VELOCITY	equ	(( CAR_MATRIX + 18			+ 3) & $fffffffc)	; vx, vy, vz longwords
CAR_OMEGA		equ	CAR_VELOCITY + 12				; wx, wy, wz longwords - rotational velocity
CAR_SPIN		equ	CAR_OMEGA + 12					; total absolute value of CAR_OMEGA since last time all wheels in contact
CAR_FORCE		equ	CAR_SPIN + 4					; 
CAR_TORQUE	equ	CAR_FORCE + 12					; CAR_TORQUE must immediately follow CAR_FORCE
CAR_POSNS		equ	CAR_TORQUE + 12				; x, y, z words of the 20 control points on the car
	CAR_NUM_PNTS	equ	38						; number of control points on a car
CAR_SHOCKS	equ	(( CAR_POSNS + (CAR_NUM_PNTS*6)+ 3) & $fffffffc)	; position of suspension extention for use in shock dampening
CAR_OSHOCKS	equ	CAR_SHOCKS + 16						; position of suspension extention for use in shock dampening
CAR_TIRE_SPD	equ	CAR_OSHOCKS + 16						; last known speed of wheel
CAR_SLIDE		equ	CAR_TIRE_SPD + 16				; some quantity of skid
CAR_SURFDATA	equ	CAR_SLIDE + 16					; floor properties for various wheels
CAR_CTRL		equ	CAR_SURFDATA + 16				; joystick bits
CAR_TURN		equ	CAR_CTRL + 4					; amount to rotate front tire
CAR_GAS		equ	CAR_TURN + 2					; amount of thrust
CAR_GEAR		equ	CAR_TURN + 4					; state of car's transmission
CAR_SKD_VCE	equ	CAR_GEAR + 4					; voice number of the car's skid sound

CAR_HEAD		equ	CAR_SKD_VCE + 4					; angle of car heading (beta)
CAR_ANGLE		equ	CAR_HEAD + 4					; other angles (alpha, gamma)
MAP_POS			equ	CAR_ANGLE + 4					; position of car on map

CAR_MODEL		equ	MAP_POS + 4					; pointer to car 3d model
FLOOR_MODEL		equ	CAR_MODEL+4					; pointer to band the car is in
NEW_FLOOR		equ	FLOOR_MODEL+4					; pointer to the band the car is going to be in
; the next 4 things must go together
CUR_PORTAL		equ	NEW_FLOOR+4					; current portal by which to teleport
CUR_SOUND		equ	CUR_PORTAL + 4					; sound to make when crashing
SND_VOL			equ	CUR_SOUND+4					;	volume for sound
SND_POS			equ	SND_VOL+4					;	position for sound ($7fff = left, 0 = right)

GAME_DATA		equ	SND_POS + 4					; data for game play (16 bits)
QTIME			equ	GAME_DATA + 2					; timer for playback/record
CAR_TOTFRAME		equ	QTIME + 2					; time stamp at beginning of ani cycle (value of intCount)
CAR_FRAME		equ	CAR_TOTFRAME + 4				; time for this frame
CAR_TIMER		equ	CAR_FRAME + 4					; value to display in "time" field of dashboard
WAIT_TIME		equ	CAR_TIMER + 4					; time to wait for some event
SCORE			equ	WAIT_TIME + 4					; timer ticks or spot total
PRV_SCORE		equ	SCORE + 4					; td.s assumes SCORE, PRV_SCORE, and SCOREPIX
SCOREPIX		equ	PRV_SCORE + 4					;   all come together
TIMERPIX		equ	SCOREPIX+4

QSTART			equ	TIMERPIX+4					; start of playback queue
QEND			equ	QSTART+4
QHEAD			equ	QEND+4						; pointer within playback queue
QTAIL			equ	QHEAD+4						; pointer within playback queue
QPLAY			equ	QTAIL+4						; position of playback head
QREC			equ	QPLAY+4						; position of record head

NEW_CAMERA		equ	QREC+4						; band the camera is going to be in next frame
CAMERA_MODEL		equ	NEW_CAMERA+4					; band the camera is currently in
CAMERA_POSN		equ	CAMERA_MODEL+4					; X,Y,Z (32 bits) for camera position
CAMERA_MATRIX		equ	CAMERA_POSN+12					; viewing matrix for camera
CAMERA_FLAG		equ	CAMERA_MATRIX+18				; what kind of camera to use
CAMERA_TURN		equ	CAMERA_FLAG+2					; angle to turn camera in X-Z plane

CAMLIST_BEG		equ	CAMERA_TURN+4					; start of camera list
CAMLIST_END		equ	CAMLIST_BEG+4					; end of camera list
CAMLIST_POS		equ	CAMLIST_END+4					; current position in camera list

PORTAL_ROT		equ	CAMLIST_POS+4					; rotation imposed by portal
AUTO_REW		equ	PORTAL_ROT+4					; automatic rewind is in effect
CAR_DOWN		equ	AUTO_REW + 4
CAR_QUEUE		equ	CAR_DOWN + 4					;player input queue

; - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
CAR_DS_SIZE	equ	CAR_QUEUE + (32*4) + 4						; it takes this many bytes
CAR_RADIUS	equ	$4000									; all points of the car are closer to the car center than this

QENTRYSIZ		equ	30		; 12 bytes for matrix, 4 for band, 12 for position, 2 for game data
QNUMENTRY		equ	1000		; number of entries in playback queue
QUANTUM			equ	30		; number of 300ths per recorder entry

; END car.inc
	PLAYER1				equ	DS_BASE
	PLAYER2				equ	PLAYER1 + CAR_DS_SIZE

GEO_DS_BASE		equ		(( PLAYER2 + CAR_DS_SIZE					+ 3) & $fffffffc) ;LONG ALIGN

; what the variables mean:
; GEO_BND_PTR points to the current band
; BANDS is the list of bands we should do calculations on, which is
; the union of the camera's band list and the floor's; normally the
; camera and floor are in the same band. We also stuff any extra bands
; (e.g. the cars) into this list
; The list is null terminated, and can have at most 100 entries

GEO_BND_PTR		equ	GEO_DS_BASE
CURBND			equ	GEO_BND_PTR+4			; for ren and 3dend: points to band we're currently looking at
BANDS			equ	CURBND+4			; in comp: list of bands (see above)
DISPBANDS		equ	BANDS+404			; band to be displayed, and Z value for it
								; (sorted by Z)
; addresses of computed data structs
	SEMAPHORE			equ	DISPBANDS+800
	SIDES				equ	SEMAPHORE+16			; sides of viewing area
	DRAWRECT			equ	SIDES+8				; blitter rectangle to draw in
	XCENTER				equ	DRAWRECT+4			; (X,Y) of center of screen
	YCENTER				equ	XCENTER+4
	ASPECTR				equ	YCENTER+4			; aspect ratio of viewing area
	LOOPCNT				equ	ASPECTR+4			; loop counter for GPU loops
	PWRBALLX			equ	LOOPCNT+4			; transformed (screen) X coordinate for power ball
	PWRBALLY			equ	PWRBALLX+4			; screen Y coord for power ball
	PWRBALLZ			equ	PWRBALLY+4
	PWRBALLR			equ	PWRBALLZ+4			; radius for power ball
	tEND				equ	PWRBALLR+4
	GP_STACK			equ	((tEND+7) & $fffffff8)		; phrase align

	QUEUES				equ	GP_STACK+8192			; queues for playback/record
	GEO_END				equ	QUEUES+64000

;------------------------------------------------------------------
; addresses of structures in GPU RAM

POLYGON					equ	BASE + $3f20	; room for 12 points
CORNERS					equ	BASE + $3fe0	; x,y for the four corners - TLBR

;------------------------------------------------------------------
; edge bit numbers

TOP_EDGE		equ	0
LEFT_EDGE		equ	1
BOTTOM_EDGE	equ	2
RIGHT_EDGE	equ	3

; BEGIN bndhead.inc
;
; data structure for per-band data

; Constants that are always present

BND_FLAGS	EQU	0		; flags for the band
					;	bit 0: band cannot be collided with
					;	bit 1: draw a cloudy sky with this band
					;	bit 2: band is a bonus world (don't count time, don't draw map)

					;	bit 13: (set in code): 0 if band has been visited by "comp"
					;			       1 if band is in comp list but not yet computed
					;	bit 14: (set in code): band has been clipped from view

NUM_PNTS	EQU	BND_FLAGS+4	; number of points in the band
NUM_VECTORS	EQU	NUM_PNTS+2	; number of vectors -- NOTE: this must immediately follow NUM_PNTS

NUM_DIVIDERS	EQU	NUM_VECTORS+2	; number of dividers
NUM_EDGES	EQU	NUM_DIVIDERS+2	; number of edges

NUM_CPS		EQU	NUM_EDGES+2	; number of CPs
NUM_COLORS	EQU	NUM_CPS+2	; number of entries in color table (normally 0)

;; Make sure the stuff below is long aligned
FILLER		EQU	NUM_COLORS+0	; make it NUM_COLORS+2 if stuff is inserted above

XORIG		EQU	FILLER+2	; X origin in global coordinates
YORIG		EQU	XORIG+4
ZORIG		EQU	YORIG+4
RADIUS		EQU	ZORIG+4		; square of the band's radius

PROP_LIST	EQU	RADIUS+4	; pointer to special surface properties

; static band data

DIVIDER_LIST	EQU	PROP_LIST+4
EDGE_LIST	EQU	DIVIDER_LIST+4
PNT_LIST	EQU	EDGE_LIST+4
SURF_LIST	EQU	PNT_LIST+4
SURFS_END	EQU	SURF_LIST+4
TREE		EQU	SURFS_END+4
TEXTURES	EQU	TREE+4
COLOR_LIST	EQU	TEXTURES+4	; colors for dynamic coloring (if applicable)
CAMERA		EQU	COLOR_LIST+4	; pointer to camera list (if applicable)

; pointers to allocated global memory

ROTPNT_LIST	EQU	CAMERA+4	; pointer to rotated points
tVECTORS	EQU	ROTPNT_LIST+4
tCOLORS		EQU	tVECTORS+4
tEDGES		EQU	tCOLORS+4
tDIVIDERS	EQU	tEDGES+4
tCLOSE_LIST	EQU	tDIVIDERS+4
tPNTS		EQU	tCLOSE_LIST+4
tPOLYS		EQU	tPNTS+4

; statistics about this band
BND_MATRIX	EQU	tPOLYS+4		; pointer to matrix for rotating band
tNUM_EXTRAS	EQU	BND_MATRIX+4		; extra points added when rendering
tINITED		EQU	tNUM_EXTRAS+4		; flag: set to 1 if the bnd is initialized, 0 if not, 2 if memory allocated but not inited
USE_COUNT	EQU	tINITED+2		; number of times band is used (if 0, allocated memory may be freed)

; finally: the list of bands which must be drawn when a
; car is in this band. This list will usually be non-empty,
; since the band itself should be drawn!
; the list is 0 terminated

BND_LIST	EQU	USE_COUNT+2



;
; Flags used in polygon structures
; the first 12 bits of the "numsides" word for each polygon are flags, used as follows:
; 	(the "fXXX" macros are masks for or'ing; the "bXXX" macros are the corresponding bits
;	for btst)

fGLASS		EQU	$8000			; flag for transparent polygon
bGLASS		EQU	15

fTEXTURE	EQU	$4000			; flag for texture mapped polygon (?)
bTEXTURE	EQU	14

fFLASH		EQU	$2000			; flag for flashing objects (in general, this
bFLASH		EQU	13			; means the object's color must be computed)

fSPSURF		EQU	$1000			; flag for special surfaces
bSPSURF		EQU	12

mSPSURF		EQU	$0f00			; up to 16 special surfaces per model

fNOCOLLIDE	EQU	$0080			; object can't be collided with
bNOCOLLIDE	EQU	7

fNODRAW		EQU	$0040			; don't draw object
bNODRAW		EQU	6

;
; offsets for polygon special surface structure
; crash.gas assumes that this is 32 bytes long
;
PORTAL_BND	EQU	0			; band associated with a portal, or 0 if not a portal
PORTAL_X	EQU	PORTAL_BND+4
PORTAL_Y	EQU	PORTAL_X+4
PORTAL_Z	EQU	PORTAL_Y+4
SP_SOUND	EQU	PORTAL_Z+4
SURF_PROP	EQU	SP_SOUND+4
POWER_UP	EQU	SURF_PROP+4
PROTATE		EQU	POWER_UP+4		; sine and cosine of rotation angle for portal

;
; world startup structure
;
STARTP1		EQU	0			; player 1 starting band, x, y, z (4*4 bytes)
STARTH1		EQU	16			; player 1 starting angle (2 bytes)
STARTP2		EQU	18			; player 2 starting band, x, y, z (4*4 bytes)
STARTH2		EQU	34			; player 2 starting angle (2 bytes)
MSCALE		EQU	36			; map scale (y then x: 2*2 bytes)
MCENTER		EQU	40			; map center (y then x: 2*2 bytes)
STARTANIM	EQU	44			; pointer to animation function info, or 0
STARTDOTS	EQU	48			; 64 (band, x, y, z) quadruples for powerball locations
; END bndhead.inc

; END 3dds.inc

; BEGIN time.gas
;
; definition for timing macros:
;
; StartTimer addr:	starts a timer running
;	uses: temp, temp2
;
; SaveTimer addr:	saves the timer value into a specific memory location
;	uses: temp, temp2
;
; RestoreTimer addr:	restarts a timer previously saved by SaveTimer
;	uses:	temp, temp2

.if 0

MACRO	StartTimer
	moveq	#1,r28
	movei	#PIT0,r29
	neg	r28
	store	r28,(r29)
ENDM

MACRO	SaveTimer
	movei	#PIT0,r29
	load	(r29),r28
	movei	#\1+TIMEARRAY,r29
	rorq	#16,r28
	neg	r28
	store	r28,(r29)
ENDM

MACRO	RestoreTimer
	movei	#\1,r29
	load	(r29),r28
	movei	#PIT0,r29
	neg	r28
	rorq	#16,r28
	store	r28,(r29)
ENDM

MACRO	Mark
	movei	#MARKADDR,r29
	moveq	#\1,r28
	store	r28,(r29)
ENDM

.else

MACRO	StartTimer
	nop
ENDM

MACRO	SaveTimer
	nop
ENDM

MACRO	RestoreTimer
	nop
ENDM

MACRO	Mark
	nop
ENDM

.endif

; END time.gas

	MACRO nopCity
		nop
		nop
		nop
		nop
		nop
		nop
		nop
		nop
		nop
		nop
	ENDM
	MACRO cutItOut
		moveq	#\1, r29
		movei	#(SEMAPHORE+8), r27
		movei	#thatsAllFolks, r28
		jump		(r28)
		store	r29, (r27)
	ENDM
	MACRO JSR_ROTY	; rotate the matrix in r10-r18 about the y-axis by r4
; legacy REGEQU half => r7 ; 3dend.gas:55
; legacy REGEQU sin => r22 ; 3dend.gas:56
; legacy REGEQU cos => r23 ; 3dend.gas:57
; legacy REGEQU pi2 => r24 ; 3dend.gas:58
; legacy REGEQU sintbl => r25 ; 3dend.gas:59
; legacy REGEQU cosRout => r26 ; 3dend.gas:60
; legacy REGEQU sinRout => r1 ; 3dend.gas:61

		; push some registers
		moveta	r0, r20
		moveta	r7, r21
		moveta	r22, r22
		moveta	r23, r23
		moveta	r24, r24
		moveta	r25, r25
		moveta	r26, r26
		moveta	r1, r27

		moveq	#1,r7
		movei	#sine,r1
		shlq		#13,r7		; Half of One ($2000)
		movei	#cosine,r26
		moveq	#4,r24
		movei	#sn,r25
		shlq		#7,r24			; RPI2 = Pi/2 ($40 in Brads)
.if INTERPOLATE
		shlq	#16,r24
.endif
		movei	#doYaw,r28
		move		PC,r0
		jump		(r28)
		addq		#6,r0	; Determine Return Address
	nop
	nop
		; pop some registers
		movefa	r20, r0
		movefa	r21, r7
		movefa	r22, r22
		movefa	r23, r23
		movefa	r24, r24
		movefa	r25, r25
		movefa	r26, r26
		movefa	r27, r1

; GASM REGUNDEF half ; 3dend.gas:99
; GASM REGUNDEF sin ; 3dend.gas:100
; GASM REGUNDEF cos ; 3dend.gas:101
; GASM REGUNDEF pi2 ; 3dend.gas:102
; GASM REGUNDEF sintbl ; 3dend.gas:103
; GASM REGUNDEF cosRout ; 3dend.gas:104
; GASM REGUNDEF sinRout ; 3dend.gas:105
	ENDM
; code start ----------------------------------------------------------------

; r0-r3 are scratch registers for outer loop
; legacy REGEQU gl_curbnd => R0 ; 3dend.gas:110
; legacy REGEQU gl_bndlist => R1 ; 3dend.gas:111
; legacy REGEQU gl_player => R2 ; 3dend.gas:112

	StartTimer	$18
;
; do everything N/10 times, where N is the number of 300ths of a second elapsed since last time
;
	movei	#player,r2
	load	(r2),r2
.if TAGGAME
	movei	#WAIT_TIME,r28
	add	r2,r28
	load	(r28),r28
	movei	#eAllDone,r29
	cmpq	#0,r28
	jump	NE,(r29)
	nop
.endif
;**	movei	#CAR_FRAME,temp
;**	add	gl_player,temp
	moveta	r2,r30
;**	load	(temp),temp
;**
;**	subq	#ONE_FRAME,temp
;**
;**; clamp between 10 (30 fps) and 60 (5 fps)
;**	movei	#60,temp2
;**	cmp	temp2,temp
;**	jr	MI,shortenough
;**	nop
;**		move	temp2,temp
;**shortenough:
;**
;**	movei	#LOOPCNT,temp2
;**	store	temp,(temp2)		; save elapsed frames

frameloop:
	;pull CAR_TURN and CAR_GAS from CAR_QUEUE input queue until empty
; legacy REGEQU theQueue => r0 ; 3dend.gas:149

	movei	#eAllDone,r27
	movei	#CAR_QUEUE,r0
	movefa	r30, r2
	add		r2,r0
	loadw	(r0),r28	;tail
	addqt	#2,r0
	loadw	(r0),r29	;head
	cmp		r28,r29		;if not empty
	move		r0,r28		;compute datum address in temp
	jump		EQ, (r27)
	addqt	#2,r28			;move to start of data elements
		add		r29,r28	;addr of head
		addqt	#4,r29		;advance head
		load		(r28),r28	;get datum
		bclr		#5,r29		;wrap
		storew	r29,(r0)	;store new head
		movei	#CAR_TURN,r29
		add		r2,r29
		store	r28,(r29)	;put datum in current CAR_TURN,CAR_GAS
;**	3$:
; GASM REGUNDEF theQueue ; 3dend.gas:171

; BEGIN carrot.gas
; BEGIN rot.inc
;- Rotation register defines ----------------------------------------------

; rotation matrix
; legacy REGEQU m0 => R0 ; rot.inc:4
; legacy REGEQU m1 => R1 ; rot.inc:5
; legacy REGEQU m2 => R2 ; rot.inc:6
; legacy REGEQU m3 => R3 ; rot.inc:7
; legacy REGEQU m4 => R4 ; rot.inc:8
; legacy REGEQU m5 => R5 ; rot.inc:9
; legacy REGEQU m6 => R6 ; rot.inc:10
; legacy REGEQU m7 => R7 ; rot.inc:11
; legacy REGEQU m8 => R8 ; rot.inc:12

; legacy REGEQU xo => R9 ; rot.inc:14
; legacy REGEQU yo => R10 ; rot.inc:15
; legacy REGEQU zo => R11 ; rot.inc:16

; computed data
; legacy REGEQU resultX => R12 ; rot.inc:19
; legacy REGEQU resultY => R13 ; rot.inc:20
; legacy REGEQU resultZ => R14 ; rot.inc:21

; pointers
; legacy REGEQU source => R15 ; rot.inc:24
; legacy REGEQU dest => R16 ; rot.inc:25
; legacy REGEQU dest2 => R17 ; rot.inc:26
; legacy REGEQU dest3 => R18 ; rot.inc:27
