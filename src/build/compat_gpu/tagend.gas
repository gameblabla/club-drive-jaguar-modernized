; Rotate and transform the car control points
; (from car space to global space)
; adding the car origin gets done in "crash", so
; don't do it here

	; read in rotation matrix (optimize for space)
	movei	#player,r29
	load	(r29),r28
	movei	#CAR_POSNS,r16
	add	r28,r16

	moveq	#(CAR_MATRIX), r15
	add	r28,r15

	loadw	(r15), r0
	addqt	#2, r15
	loadw	(r15), r1
	addqt	#2, r15
	loadw	(r15), r2
	addqt	#2, r15
	loadw	(r15), r3
	addqt	#2, r15
	loadw	(r15), r4
	addqt	#2, r15
	loadw	(r15), r5
	addqt	#2, r15
	loadw	(r15), r6
	addqt	#2, r15
	loadw	(r15), r7
	addqt	#2, r15
	loadw	(r15), r8

	movei	#car_dat, r15
	movei	#CAR_NUM_PNTS,r19

	move		r16, r17
	move		r16, r18
	subqt	#6, r16
	subqt	#4, r17
	subqt	#2, r18

	movei	#_CDLOCAL_10_45, r27
	loadw	(r15),r20
_CDLOCAL_10_45:
	; get data
	addqt	#6, r16
	addqt	#2, r15
	addqt	#6, r17
	loadw	(r15), r21
	addqt	#2, r15
	addqt	#6, r18
	loadw	(r15), r22

	; do multiply by matrix transpose
	imultn	r0, r20	;
	imacn	r3, r21	;
	imacn	r6, r22	;
	resmac	r12	;
	addqt	#2, r15
	sharq	#14, r12
	storew	r12, (r16)

	imultn	r1, r20	;
	imacn	r4, r21	;
	imacn	r7, r22	;
	resmac	r13	;
	sharq	#14, r13

	imultn	r2, r20	;
	imacn	r5, r21	;
	imacn	r8, r22	;
	resmac	r14	;
	storew	r13, (r17)
	sharq	#14, r14

	subq		#1, r19
	storew	r14, (r18)
	jump		NE, (r27)
	loadw	(r15), r20

