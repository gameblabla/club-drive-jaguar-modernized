;					loadw	(pnt), t2y
;					addqt	#2, pnt	; to z
;					sub		tempy, t2y
;					loadw	(pnt), t2z
;
;					addqt	#2, flr	; advance to normal num
;					sub		tempz, t2z
;					loadw	(flr), pnt
;					mult		six, pnt
;					add		normals, pnt
;					loadw	(pnt), t3x
;					addqt	#2, pnt	; to y
;					loadw	(pnt), t3y
;					addqt	#2, pnt	; to z
;					loadw	(pnt), t3z
;
;;	movei	#$17038, return
;;	store	t2x, (return)
;;	nop
;;	addqt	#16, return
;;	store	t2y, (return)
;;	nop
;;	addqt	#16, return
;;	store	t2z, (return)
;;	nop
;;	movei	#$17030, return
;;	store	t3x, (return)
;;	nop
;;	addqt	#16, return
;;	store	t3y, (return)
;;	nop
;;	addqt	#16, return
;;	store	t3z, (return)
;;	nop
;;	nop
;					imultn	t2x, t3x	;
;					imacn	t2y, t3y	;
;					imacn	t2z, t3z	;
;					resmac	t2x		;
;					btst		#31, t2x
;					jr		EQ, thisExOK
;					nop
;					;subq		#1, temp2
;						; we are NOT in this flours' space (<= British spelling of floor)
;						; try next field
;;						subqt	#4, flr		; back up to FLR_NEXT field
;;						loadw	(flr), flr	; load address of next floor
;;						or		flr, flr		; check edge type - is there a floor or a wall there?
;;	cutItOut $1e
;						movefa	ta3, temp		; ta3 contains doCrash:
;						jump		(temp)	; crash
;;						;jump		EQ, (temp)	; crash
;						nop
;;						; no crash
;;						store	flr, (flrs)	; save for future use
;;						movefa	ta1, temp		; ta1 contains fndflr:
;;						jump		(temp)
;;						nop
;;
;					thisExOK:	; we are INSIDE this normal
;					subq		#1, temp2
;					movefa	ta2, temp	; ta2 = chkEx:
;;					jump		NE, (temp)
;					addqt	#4, flr	; advance two records to exit info
;					
;
;				; floor checks out
;			; add normal force
;			
;			; compute normal force scalar
;			; compute gription vector
;;			sub	vx, fx
;			; crash force?
;
;		; sum body point forces
;			; crash force?
;			; add normal force
;			; drag gription vector
;		nextCPoint:
;		movefa	aFlrs, flrs	; get address of next points floor ptr
;	; store new current floor
;		addqt	#4, flrs		; next control points last used floor
;		movefa	numCPpoints, temp
;		subq		#1, temp
;		movefa	ta5, temp2	; ta5 = sumPnts:
;		moveta	temp, numCPpoints
;;		jump		NE, (temp2)
;		movefa	temp, temp	; get address of next point coords
.if 0
		; fake shock set
		movefa	thePlayer, r28
		addqt	#4, r28
		load		(r28), r29			; car y posn
		movei	#$475000, r28			; starting y from mkmat
		sub		r28, r29
		movei	#$8000, r28
		add		r28, r29
		sat16	r29				; trim to shock len
		movei	#CAR_SHOCKS, r28		; store in struct
		movefa	thePlayer, tempx
		add		tempx, r28
		storew	r29, (r28)


				sharq	#31, LA			; preserve sign somehow
				bset		#0, LA
				moveq	#MUd, tempz		; ud - dynamic friction coef
				imult	tempz, LA			; restore sign (result is still 16 bit)
				imult	nf, LA
;				moveq	#0, le
				move		LA, le
				abs		le
				normi	le, le
				addqt	#9, le
				sha		le, LA
				neg		le
				addqt	#16, le

.endif

