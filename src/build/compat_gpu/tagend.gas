; GASM REGUNDEF xrite ; turt.gas:546
; GASM REGUNDEF yrite ; turt.gas:547
; GASM REGUNDEF zrite ; turt.gas:548
; GASM REGUNDEF xdown ; turt.gas:549
; GASM REGUNDEF ydown ; turt.gas:550
; GASM REGUNDEF zdown ; turt.gas:551
; GASM REGUNDEF xhead ; turt.gas:552
; GASM REGUNDEF yhead ; turt.gas:553
; GASM REGUNDEF zhead ; turt.gas:554
; GASM REGUNDEF xposn ; turt.gas:555
; GASM REGUNDEF yposn ; turt.gas:556
; GASM REGUNDEF zposn ; turt.gas:557

; GASM REGUNDEF sin ; turt.gas:559
; GASM REGUNDEF cos ; turt.gas:560
; GASM REGUNDEF cosRout ; turt.gas:561
; GASM REGUNDEF sinRout ; turt.gas:562

;;*======================================================================*
