	movei	#dotloc,r29
	load	(r29),r28
	addqt	#4,r29
	cmpq	#0,r28
	movei	#noballs,r29
	jump	EQ,(r29)
	nop

	movefa	r27,r15
	movei	#CAMERA_POSN,r28
	add	r28,r15
	load		(r15), r9
	addq	#4, r15
	load		(r15), r10
	addq	#4, r15
	load		(r15), r11
	addq	#4, r15

	loadw	(r15), r0
	addqt	#2, r15
	loadw	(r15), r1
	addqt	#2, r15
	loadw	(r15), r2
	addqt	#2, r15
	loadw	(r15), r3
	addqt	#2, r15
	loadw	(r15), r4
	addqt	#2, r15
	loadw	(r15), r5
	addqt	#2, r15
	loadw	(r15), r6
	addqt	#2, r15
	loadw	(r15), r7
	addqt	#2, r15
	loadw	(r15), r8

	movei	#dotloc,r15
	addqt	#4,r15
	load	(r15),r20
	addqt	#4,r15
	load	(r15),r21
	addqt	#4,r15
	load	(r15),r22
	sub	r9,r20
	sub	r10,r21
	sub	r11,r22

	movei	#PWRBALLX,r16

	; make 16 bits
	move		r20, r28
	abs		r28
	move		r21, r29
	abs		r29
	or		r29, r28
	move		r22, r29
	abs		r29
	or		r29, r28
	normi	r28, r29
	addqt	#9, r29
	sha		r29, r20
	sha		r29, r21
	sha		r29, r22
	neg		r29
	addqt	#12, r29

	; do multiply
	imultn	r3, r20	;
	imacn	r4, r21	;
	imacn	r5, r22	;
	resmac	r13	;
	sha		r29, r13	; back to 17.15

	imultn	r0, r20	;
	imacn	r1, r21	;
	imacn	r2, r22	;
	resmac	r12	;
	sha		r29, r12	; back to 17.15

	imultn	r6, r20	;
	imacn	r7, r21	;
	imacn	r8, r22	;
	resmac	r14	;
	sha		r29, r14	; back to 17.15

; do perspective calculations
; legacy REGEQU Dm => r0 ; rotdot.gas:93
; legacy REGEQU De => r1 ; rotdot.gas:94
; legacy REGEQU ze => r2 ; rotdot.gas:95
; legacy REGEQU D => r3 ; rotdot.gas:96
; legacy REGEQU xe => r4 ; rotdot.gas:97
; legacy REGEQU ye => r5 ; rotdot.gas:98
; legacy REGEQU tempz => r6 ; rotdot.gas:99

	movei	#277, r0
	normi	r0,r1
	subqt	#8,r1
	sh	r1,r0
	neg	r1
	subqt	#16,r1

	movei	#XCENTER,r28
	load	(r28),r20
	addqt	#4,r28
	load	(r28),r21

	btst	#31,r14
	movei	#storeit,r29
	jump	NE,(r29)
	normi	r14,r2

	move	r14,r6

	addqt	#6,r2
	sh	r2,r6
	move	r0,r3
	div	r6,r3

	add	r1,r2
	move	r12,r28
	move	r13,r29
	abs	r28
	abs	r29
	normi	r28,r4
	normi	r29,r5
	addqt	#9,r4
	addqt	#9,r5
	sha	r4,r12
	sha	r5,r13
	neg	r4
	neg	r5
	add	r2,r4
	add	r2,r5

	imult	r3,r12
	imult	r3,r13
	sha	r4,r12
	sha	r5,r13
	add	r20,r12
	add	r21,r13
storeit:
	movei	#PWRBALLX,r16
	store	r12,(r16)
	addqt	#4,r16
	store	r13,(r16)
	addqt	#4,r16
	store	r14,(r16)
	addqt	#4,r16
	subqt	#12,r2
	sha	r2,r3
	store	r3,(r16)

noballs:
