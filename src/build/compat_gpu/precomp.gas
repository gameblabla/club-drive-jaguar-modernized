; legacy REGEQU x => R20 ; rot.inc:30
; legacy REGEQU y => R21 ; rot.inc:31
; legacy REGEQU z => R22 ; rot.inc:32

; legacy REGEQU xaz => R20 ; rot.inc:34
; legacy REGEQU yaz => R21 ; rot.inc:35
; legacy REGEQU ze => R22 ; rot.inc:36

; legacy REGEQU rightSd => R23 ; rot.inc:38
; legacy REGEQU bottomSd => R24 ; rot.inc:39

; legacy REGEQU dataHi => R25 ; rot.inc:41
; legacy REGEQU sectors => R26 ; rot.inc:42

;innerLoop	REGEQU	R27

