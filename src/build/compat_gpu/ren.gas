		jump	EQ,(r4)
		nop
		shrq	#16,r13
		jump	EQ,(r4)
		nop
		shlq	#16,r14
; figure out step value here, based on xcount
; while we're at it, scale sourcex and sourcey
		move	r13,r17
		move	r15,r21
		normi	r15,r22
		addqt	#9,r22
		sha	r22,r21
		mult	r21,r17
