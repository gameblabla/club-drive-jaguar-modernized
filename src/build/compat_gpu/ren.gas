	load	(r29),r1
	addqt	#4,r29
	load	(r29),r28
	addqt	#4,r29
	cmpq	#1,r28			; if Z < 1, don't draw it
	jump	MI,(r4)
	nop

		load	(r29),r3
		movei	#96,r28
		mult	r28,r3
		move	r0,r7
		move	r1,r8
		sub	r3,r0
		sub	r3,r1
		add	r3,r7
		add	r3,r8
		move	r7,r29
		sub	r0,r29
		jump	MI,(r4)
		nop
