		div	r29,r15		; figure out increment, as a 16.16 number
		movei	#DRAWRECT,r29
		load	(r29),r11
.if 0
		movei	#$8000,r28
.else
		moveq	#0,r28
		bset	#15,r28
.endif
		add	r28,r0
		add	r28,r1
		add	r28,r7
		add	r28,r8
		move	r11,r12
		shlq	#16,r11
		shrq	#16,r12
		shlq	#16,r12

		cmpq	#0,r0
		jr	PL,plusx
		moveq	#0,r5
			move	r0,r5
			moveq	#0,r0
			neg	r5
plusx:
		cmpq	#0,r1
		jr	PL,plusy
		moveq	#0,r6
			move	r1,r6
			moveq	#0,r1
			neg	r6
plusy:
		cmp	r11,r7
		jr	MI,okx
		nop
			move	r11,r7

okx:		cmp	r12,r8
		jr	MI,oky
		nop
			move	r12,r8
oky:
		move	r7,r13
		move	r8,r14
		sub	r0,r13
		jump	MI,(r4)
		nop
