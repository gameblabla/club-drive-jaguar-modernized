		sha	r22,r6
		or	r14,r13
		neg	r17
; for now, "step" has the X step, and "inc" the Y step
; break inc up into fractional and integer parts
		move	r15,r16
		shrq	#16,r15
		shlq	#16,r16
		shrq	#16,r16
; break "step" up into fractional and integer parts
		move	r17,r18
		shrq	#16,r17
		shlq	#16,r18
		shrq	#16,r18
; now merge the Y step in with "step"
		move	r15,r28
		move	r16,r29
		shlq	#16,r28
		shlq	#16,r29
		or	r28,r17
		or	r29,r18
; figure out starting pixel values, based on sourceX and sourceY
		move	r5,r20
		move	r5,r19
		shlq	#16,r20
		shrq	#16,r19
		shrq	#16,r20
		move	r6,r29
		shrq	#16,r6
		shlq	#16,r29
		shlq	#16,r6
		or	r29,r20
		or	r6,r19

; wait for the blitter to become free
_CDLOCAL_10_176:
		load	(r24),r28
		btst	#0,r28
		jr	EQ,_CDLOCAL_10_176
		nop
; set up blitter windows
; source is the current power ball image
		movei	#dotimg,r28
		load	(r28),r28
		move	r26,r29
		store	r28,(r29)
		addqt	#4,r29		; move to A1_FLAGS
		movei	#PITCH1|PIXEL16|WID96|XADDINC,r28
		store	r28,(r29)
		addqt	#8,r29		; move to A1_PIXEL
		store	r19,(r29)
		addqt	#4,r29		; move to A1_STEP
		store	r17,(r29)
		addqt	#4,r29		; move to A1_FSTEP
		store	r18,(r29)
		addqt	#4,r29		; move to A1_FPIXEL
		store	r20,(r29)
		addqt	#4,r29		; move to A1_INC
		store	r15,(r29)
		addqt	#4,r29		; move to A1_FINC
		store	r16,(r29)
		movei	#B_COUNT,r29
		store	r13,(r29)

; destination is the current screen
		movei	#A2_PIXEL,r29
		shrq	#16,r1
		shrq	#16,r0
		shlq	#16,r1
		or	r1,r0
		store	r0,(r29)
		movei	#screen_addr,r28
		load	(r28),r25
		movei	#A2_BASE,r29
		store	r25,(r29)
		movei	#PITCH1|PIXEL16|WID320|XADDPIX,r28
		addqt	#4,r29		; move to A2_FLAGS
		store	r28,(r29)
		movei	#A2_STEP,r29
		move	r13,r28
		neg	r28
		shlq	#16,r28
		shrq	#16,r28
		bset	#16,r28		; set Y step to 1
		store	r28,(r29)
		moveq	#0,r28
;;		movei	#$AA1CAA1C,temp		; background color
		movei	#B_PATD,r29
		store	r28,(r29)
		addqt	#4,r29
		store	r28,(r29)

		movei	#SRCEN|UPDA1F|UPDA1|UPDA2|DSTA2|DCOMPEN|LFU_AN|LFU_A,r28

		store	r28,(r24)
		nop
; wait for blitter to finish
_CDLOCAL_20_238:
		load	(r24),r28
		btst	#0,r28
		jr	EQ,_CDLOCAL_20_238
		nop
;
; restore register windows
;

	move	r26,r29
	store	r25,(r29)
	movei	#PITCH1|PIXEL16|WID320|XADDPHR,r28
	addqt	#4,r29			; move to A1_FLAGS
	store	r28,(r29)

ret_dot:
	moveq	#0,r28
	store	r28,(r23)
	RTS_TREE

