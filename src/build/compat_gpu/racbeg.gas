; GASM REGUNDEF m0 ; rotc.inc:3
; GASM REGUNDEF m1 ; rotc.inc:4
; GASM REGUNDEF m2 ; rotc.inc:5
; GASM REGUNDEF m3 ; rotc.inc:6
; GASM REGUNDEF m4 ; rotc.inc:7
; GASM REGUNDEF m5 ; rotc.inc:8
; GASM REGUNDEF m6 ; rotc.inc:9
; GASM REGUNDEF m7 ; rotc.inc:10
; GASM REGUNDEF m8 ; rotc.inc:11
; GASM REGUNDEF xo ; rotc.inc:12
; GASM REGUNDEF yo ; rotc.inc:13
; GASM REGUNDEF zo ; rotc.inc:14
; GASM REGUNDEF resultX ; rotc.inc:15
; GASM REGUNDEF resultY ; rotc.inc:16
; GASM REGUNDEF resultZ ; rotc.inc:17
; GASM REGUNDEF source ; rotc.inc:18
; GASM REGUNDEF dest ; rotc.inc:19
