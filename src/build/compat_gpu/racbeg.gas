	JSR_DIGIT
	subqt	#8,r8

; now blit the '.'
	moveq	#DIGIT_PERIOD,r5
	JSR_DIGIT
	subqt	#4,r8

; ones digit for the seconds
	moveq	#10,r9
	div	r9,r6
	or	r6,r6
	load	(r7),r5
	nop
	btst	#31,r5
	jr	EQ,_CDLOCAL_22_369
	nop
		add	r9,r5
_CDLOCAL_22_369:
	JSR_DIGIT
	subqt	#8,r8

; tens digit for seconds
	move	r6,r5
	JSR_DIGIT
	subqt	#8,r8
; ':'
	moveq	#DIGIT_COLON,r5
	movei	#60,r9
	div	r9,r4	; set curtimer to hours
	JSR_DIGIT
	subqt	#4,r8

; ones digit of minutes
	load	(r7),r6
	nop
	btst	#31,r6
	jr	EQ,_CDLOCAL_23_391
	nop
