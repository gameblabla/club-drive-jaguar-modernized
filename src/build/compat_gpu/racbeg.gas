	nop
	btst	#31,r5
	jr	EQ,_CDLOCAL_24_401
	nop
		add	r9,r5
_CDLOCAL_24_401:
	JSR_DIGIT
	subqt	#8,r8

; tens digit of minutes
	move	r6,r5
	JSR_DIGIT
	subqt	#8,r8

.if NEVERHUNDS = 0
	btst	#31,r13
	jr	NE,blithour
	nop
		subqt	#4,r8
		movei	#docompass,r28
		jump	(r28)
		nop
.endif

blithour:
; ':'
	moveq	#DIGIT_COLON,r5
	JSR_DIGIT
	subqt	#4,r8
; hours
	move	r4,r5
	JSR_DIGIT
	subqt	#8,r8

