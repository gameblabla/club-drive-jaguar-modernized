showtime:
.endif

; only do the hundredths digit if there is room
	movei	#60,r13
	sub	r4,r13
.if NEVERHUNDS = 0
; now: never do the hundredths digit
	jr	MI,nohunds
	nop

	JSR_DIGIT
	subqt	#8,r8

.endif

nohunds:
	div	r9,r6
; pick up the 10ths digit
	or	r6,r6
	load	(r7),r5
	nop
	btst	#31,r5
	jr	EQ,_CDLOCAL_21_350
	nop
		add	r9,r5
