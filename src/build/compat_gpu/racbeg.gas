; blit the digit represented by "digit" to
; the screen, in pixel mode
; assumes that B_PATD and B_DSTD are already set up with the
; correct colours (foreground color in B_PATD, background
; in B_DSTD)
; also assumes that A*_BASE, A*_FLAGS
; (A2 is source bitmap, 1 bit per pixel character data
;  A1 is the destination)
; 
; that "coords" contains the (Y,X) coordinates
; (Y in high word, X in low)
; that "count" has the (Y,X) count (ditto)
; and that "digitw" has the amount to shift "digit" by
; to index into the font (e.g. "3" for an 8 bit wide
; character)
; Registers trashed: temp, temp2, tempptr
;
blitdig:

_CDLOCAL_79_978:
	load	(r14),r28			; see if the blitter is ready
	btst	#0,r28
	jr	EQ,_CDLOCAL_79_978
	nop

	move	r5,r28			; load up the digit pattern data
	sha	r2,r28

	movei	#A2_PIXEL,r11
	store	r28,(r11)

	movei	#A1_PIXEL,r11
	store	r8,(r11)

	movei	#B_COUNT,r29
	store	r12,(r29)

	movei	#UPDA1|UPDA2|SRCEN|PATDSEL|BCOMPEN|BKGWREN,r28
	jump	(r31)
	store	r28,(r14)				; starts the blitter

;
; hexdump: dump the number in "vx" out to the screen, in hex
;
hexdump:
	moveq	#15,r6
	moveq	#8,r9
hexloop:
	move	r19,r5
	and	r6,r5
	shrq	#4,r19
	JSR_DIGIT
	subqt	#8,r8
	subq	#1,r9
	movei	#hexloop,r29
	jump	NE,(r29)
	nop
	RTS_HEX

