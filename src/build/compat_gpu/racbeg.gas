; GASM REGUNDEF y ; rotc.inc:24
; GASM REGUNDEF z ; rotc.inc:25
; GASM REGUNDEF xaz ; rotc.inc:26
; GASM REGUNDEF yaz ; rotc.inc:27
; GASM REGUNDEF ze ; rotc.inc:28
