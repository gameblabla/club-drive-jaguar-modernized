	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)
	movei	#$7fc07fc0,r28
	movei	#B_PATD,r29
	store	r28,(r29)
	addqt	#4,r29
	store	r28,(r29)

	movei	#$00000030,r8
	movei	#$00180010,r12
	moveq	#11,r5		; "mph"
	JSR_DIGIT
	subqt	#16,r8

; grab the remainder of the divide as the number of ones
	or	r21,r21
	load	(r7),r5
	btst	#31,r5
	jr	EQ,_CDLOCAL_10_731
	nop
		add	r9,r5
_CDLOCAL_10_731:

	div	r9,r21

; first digit
	JSR_DIGIT
	subqt	#16,r8

	or	r21,r21
	load	(r7),r5
	btst	#31,r5
	jr	EQ,_CDLOCAL_20_745
	nop
		add	r9,r5
_CDLOCAL_20_745:

; second digit
	cmpq	#0,r5
	jr	NE,_CDLOCAL_25_755
	nop
	cmpq	#0,r21
	jr	NE,_CDLOCAL_25_755
	nop
		moveq	#10,r5
_CDLOCAL_25_755:
	JSR_DIGIT
	subqt	#16,r8

; third digit
	cmpq	#9,r21
	jr	MI,vzOK
	move	r21,r5
		moveq	#9,r5
vzOK:

	cmpq	#0,r5
	jr	NE,_CDLOCAL_35_770
	nop
		moveq	#10,r5
