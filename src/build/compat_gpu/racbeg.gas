;;;	include	"sky2.gas"
; BEGIN ortho.gas
;
; code for orthogonalizing the matrix
;

; legacy REGEQU roll => r7 ; ortho.gas:5
; legacy REGEQU ptr => r8 ; ortho.gas:6
; legacy REGEQU half => r9 ; ortho.gas:7

; legacy REGEQU xrite => r10 ; ortho.gas:9
; legacy REGEQU yrite => r11 ; ortho.gas:10
; legacy REGEQU zrite => r12 ; ortho.gas:11
; legacy REGEQU xdown => r13 ; ortho.gas:12
; legacy REGEQU ydown => r14 ; ortho.gas:13
; legacy REGEQU zdown => r15 ; ortho.gas:14
; legacy REGEQU xhead => r16 ; ortho.gas:15
; legacy REGEQU yhead => r17 ; ortho.gas:16
; legacy REGEQU zhead => r18 ; ortho.gas:17
; legacy REGEQU xposn => r19 ; ortho.gas:18
; legacy REGEQU yposn => r20 ; ortho.gas:19
; legacy REGEQU zposn => r21 ; ortho.gas:20

ORTHOGONALIZE	EQU	1

.if ORTHOGONALIZE
;
; load up the matrix
;
	movei	#player,r29
	load	(r29),r28
	addqt	#CAR_MATRIX,r28
	move	r28,r8

		loadw	(r28),r10		; Fetch Turtle into registers
		addq		#2,r28
		loadw	(r28),r13
		addq		#2,r28
		loadw	(r28),r16
		addq		#2,r28
		loadw	(r28),r11
		addq		#2,r28
		loadw	(r28),r14
		addq		#2,r28
		loadw	(r28),r17
		addq		#2,r28
		loadw	(r28),r12
		addq		#2,r28
		loadw	(r28),r15
		addq		#2,r28
		loadw	(r28),r18


;
; Do Gram-Schmidt orthogonalization on the matrix
;
	movei	#G_DIVCTRL,r29	; make 16.16 division
	moveq	#1,r28
	store	r28,(r29)

	imultn	r10,r10
	imacn	r11,r11
	imacn	r12,r12
	resmac	r28
;	abs	temp
; "temp" is now the magnitude of col 1, squared. This is close to being 1; if we assume that the error is x, then
; using (1+x)^2 = 1+2x+x^2, and assuming x to be small, we can find x to be approximately (temp-1)/2
; (this is quicker than finding the square root)
	moveq	#1,r9
	shlq	#13,r9		; make "half" = 1/2 (in 14 bits)
	move	r9,r7		; and "roll" = 1 (in 28 bits)
	shlq	#15,r7
	sub	r7,r28
	sharq	#1,r28			; divide by 2
	add	r7,r28		; add 1 again

	move	r7,r19		; find 1/(1+x) for the (inverse of) the magnitude of row 1
	div	r28,r19

	shlq	#16,r13			; sign extend col 2
	shlq	#16,r14
	shlq	#16,r15
	sharq	#16,r13
	sharq	#16,r14
	sharq	#16,r15

; multiply col 1 by the inverse of its magnitude
	normi	r19,r28
	addqt	#9,r28
	sha	r28, r19
	imult	r19,r10
	imult	r19,r11
	imult	r19,r12
	neg	r28
	addqt	#16,r28
	sha	r28,r10
	sha	r28,r11
	sha	r28,r12
; make col2 = col2 - (col2.col1)col1
	move	r10,r19
	move	r11,r20
	move	r12,r21
	imultn	r13,r10
	imacn	r14,r11
	imacn	r15,r12
	resmac	r28
	sharq	#14,r28
	imult	r28,r19
	imult	r28,r20
	imult	r28,r21
	sharq	#14,r19
	sharq	#14,r20
	sharq	#14,r21
	sub	r19,r13
	sub	r20,r14
	sub	r21,r15
; normalize col2; again, assume that it's almost normal already, so we can use the
; square root shortcut above

	imultn	r13,r13
	imacn	r14,r14
	imacn	r15,r15
	resmac	r28
	abs	r28

	sub	r7,r28		; roll still contains a 28 bit "1" (from above)
	sharq	#1,r28			; divide by 2
	add	r7,r28		; add 1 again

	move	r7,r20		; find 1/(1+x) for the (inverse of) the magnitude of row 1
	div	r28,r20

	shlq	#16,r16			; sign extend col 3 while we're waiting for the divide
	shlq	#16,r17
	shlq	#16,r18
	sharq	#16,r16
	sharq	#16,r17
	sharq	#16,r18

; finish normalizing row 2
	normi	r20,r28
	addqt	#9,r28
	sha	r28,r20
	imult	r20,r13
	imult	r20,r14
	imult	r20,r15
	neg	r28
	addqt	#16,r28
	sha	r28,r13
	sha	r28,r14
	sha	r28,r15

.if 0
; finally, calculate col 3 to be col3-(col3.col1)col1-(col3.col2)col2

	imultn	r16,r10
	imacn	r17,r11
	imacn	r18,r12
	resmac	r28
	sharq	#14,r28
	imultn	r16,r13
	imacn	r17,r14
	imacn	r18,r15
	resmac	r29
	sharq	#14,r29
	move	r10,r19
	move	r11,r20
	move	r12,r21
	imult	r28,r19
	imult	r28,r20
	imult	r28,r21
	sharq	#14,r19
	sharq	#14,r20
	sharq	#14,r21
	sub	r19,r16
	sub	r20,r17
	sub	r21,r18

	move	r13,r19
	move	r14,r20
	move	r15,r21
	imult	r29,r19
	imult	r29,r20
	imult	r29,r21
	sharq	#14,r19
	sharq	#14,r20
	sharq	#14,r21
	sub	r19,r16
	sub	r20,r17
	sub	r21,r18
;
; finally, normalize col 3
;
	imultn	r16,r16
	imacn	r17,r17
	imacn	r18,r18
	resmac	r28
	abs	r28

	sub	r7,r28		; roll still contains a 28 bit "1" (from above)
	sharq	#1,r28			; divide by 2
	add	r7,r28		; add 1 again

	move	r7,r21		; find 1/(1+x) for the (inverse of) the magnitude of row 1
	div	r28,r21

	normi	r21,r28
	addqt	#9,r28
	sha	r28,r21
	imult	r21,r16
	imult	r21,r17
	imult	r21,r18
	neg	r28
	addqt	#16,r28
	sha	r28,r16
	sha	r28,r17
	sha	r28,r18

.else
; calculate col. 3 as col. 1 X col. 2

	move	r13,r19
	move	r14,r20
	move	r15,r21
	neg	r19
	neg	r20
	neg	r21
	imultn	r11,r15
	imacn	r12,r20
	resmac	r16
	imultn	r12,r13
	imacn	r10,r21
	resmac	r17
	imultn	r10,r14
	imacn	r11,r19
	resmac	r18
	sharq	#14,r16
	sharq	#14,r17
	sharq	#14,r18
.endif
;
; finally, normalize col 3
;
	imultn	r16,r16
	imacn	r17,r17
	imacn	r18,r18
	resmac	r28
	abs	r28

	sub	r7,r28		; roll still contains a 28 bit "1" (from above)
	sharq	#1,r28			; divide by 2
	add	r7,r28		; add 1 again

	move	r7,r21		; find 1/(1+x) for the (inverse of) the magnitude of row 1
	div	r28,r21

	normi	r21,r28
	addqt	#9,r28
	sha	r28,r21
	imult	r21,r16
	imult	r21,r17
	imult	r21,r18
	neg	r28
	addqt	#16,r28
	sha	r28,r16
	sha	r28,r17
	sha	r28,r18

	movei	#G_DIVCTRL,r29	; make 16.16 division
	moveq	#0,r28
	store	r28,(r29)

	storew	r10,(r8)
	addq	#2,r8
	storew	r13,(r8)
	addq	#2,r8
	storew	r16,(r8)
	addq	#2,r8
	storew	r11,(r8)		; Write back turtle
	addq	#2,r8
	storew	r14,(r8)
	addq	#2,r8
	storew	r17,(r8)
	addq	#2,r8
	storew	r12,(r8)
	addq	#2,r8
	storew	r15,(r8)
	addq	#2,r8
	storew	r18,(r8)
.endif

; GASM REGUNDEF roll ; ortho.gas:290
; GASM REGUNDEF half ; ortho.gas:291
; GASM REGUNDEF xrite ; ortho.gas:292
; GASM REGUNDEF yrite ; ortho.gas:293
; GASM REGUNDEF zrite ; ortho.gas:294
; GASM REGUNDEF xdown ; ortho.gas:295
; GASM REGUNDEF ydown ; ortho.gas:296
; GASM REGUNDEF zdown ; ortho.gas:297
; GASM REGUNDEF xhead ; ortho.gas:298
; GASM REGUNDEF yhead ; ortho.gas:299
; GASM REGUNDEF zhead ; ortho.gas:300
; GASM REGUNDEF xposn ; ortho.gas:301
; GASM REGUNDEF yposn ; ortho.gas:302
; GASM REGUNDEF zposn ; ortho.gas:303

; END ortho.gas

	SaveTimer	4

; jump to the first part of the renderer (the computations)
		movei	#pcprog,r28
		movei	#loadIt, r29
		jump		(r29)
		nop

; halt the GPU --------------------------------------------------------------
thatsAllFolks:
; stolen code
		movei	#G_CTRL, r29
		load		(r29), r28
		bclr #0, r28
		bset #1, r28
		store	r28, (r29)

_CDLOCAL_10_119:	jr	_CDLOCAL_10_119
		nop


; END 3dbeg.gas
