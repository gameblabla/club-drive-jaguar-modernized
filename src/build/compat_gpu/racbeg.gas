;	load	(temp),vx
;	addqt	#4,temp
;	load	(temp),vy
;	addqt	#4,temp
;	load	(temp),vz
;
;	abs	vx
;	abs	vy
;	abs	vz
;
;; sort the x,y,z components in ascending order
;	cmp	vx,vy
;	jr	PL,5$
;	nop
;		move	vx,temp
;		move	vy,vx
;		move	temp,vy
;5$:
;	cmp	vy,vz
;	jr	PL,15$
;	nop
;		move	vz,temp
;		move	vy,vz
;		move	temp,vy
;15$:
;
;	shrq	#2,vx
;	shrq	#2,vy
;	add	vx,vz
;	add	vy,vz

	movei	#CAR_TIRE_SPD,r28
	add	r0,r28
	load	(r28),r21
	abs	r21
	shrq	#13, r21

; now vz contains the (approximate) car speed
; scale it to something sensible
;	shrq	#11,vz
	movei	#SPEED_SCALE,r28
	mult	r28,r21
	shrq	#15,r21

;
; finally, get the digits and blit them up into
; the appropriate HUD
;
	moveq	#10,r9
	div	r9,r21

_CDLOCAL_20_668:
	load	(r14),r28	; wait for the blit
	btst	#0,r28
