; BEGIN portrot.gas
;
; portrot.gas: do portal dependent rotations
;
; legacy REGEQU sin => R0 ; portrot.gas:4
; legacy REGEQU cos => R1 ; portrot.gas:5
; legacy REGEQU msin => R2 ; portrot.gas:6
; legacy REGEQU srcx => R3 ; portrot.gas:7
;srcy	REGEQU	R4
; legacy REGEQU srcz => R5 ; portrot.gas:9
; legacy REGEQU destx => R6 ; portrot.gas:10
;desty	REGEQU	R7
; legacy REGEQU destz => R8 ; portrot.gas:12
; legacy REGEQU thePlayer => R9 ; portrot.gas:13

	movefa	r27,r9
	movei	#PORTAL_ROT,r29
	add	r9,r29
	load	(r29),r0
	movei	#noport,r27
	cmpq	#0,r0
	jump	EQ,(r27)
	nop

	moveq	#0,r28
	store	r28,(r29)	; zero the portal rotation

; we have to rotate the velocity vector and the car's rotation matrix by the matrix
;	cos	0	-sin
;	0	1	0
;	sin	0	cos
; where "sin" is the high 16 bits of PORTAL_ROT, and "cos" is the low 16 bits

	move	r0,r1
	sharq	#16,r0
	move	r0,r2
	neg	r2

; first, do velocity (a 20.12 number, but it can't get very big...)
	movei	#CAR_VELOCITY,r29
	add	r9,r29
	load	(r29),r3
	addqt	#8,r29
	load	(r29),r5
	subqt	#8,r29
	sharq	#10,r3
	sharq	#10,r5

	imultn	r1,r3
	imacn	r2,r5
	resmac	r6
	imultn	r0,r3
	imacn	r1,r5
	resmac	r8
	sharq	#4,r6
	sharq	#4,r8
	store	r6,(r29)
	addqt	#8,r29
	store	r8,(r29)

; next, do the matrix (0.14 numbers, all of them)

	move	r9,r29
	addqt	#CAR_MATRIX,r29

	loadw	(r29),r3
	addqt	#12,r29
	loadw	(r29),r5
	subqt	#12,r29

	imultn	r1,r3
	imacn	r2,r5
	resmac	r6
	imultn	r0,r3
	imacn	r1,r5
	resmac	r8
	sharq	#14,r6
	sharq	#14,r8
	storew	r6,(r29)
	addqt	#12,r29
	storew	r8,(r29)
	subqt	#10,r29

	loadw	(r29),r3
	addqt	#12,r29
	loadw	(r29),r5
	subqt	#12,r29

	imultn	r1,r3
	imacn	r2,r5
	resmac	r6
	imultn	r0,r3
	imacn	r1,r5
	resmac	r8
	sharq	#14,r6
	sharq	#14,r8
	storew	r6,(r29)
	addqt	#12,r29
	storew	r8,(r29)
	subqt	#10,r29

	loadw	(r29),r3
	addqt	#12,r29
	loadw	(r29),r5
	subqt	#12,r29

	imultn	r1,r3
	imacn	r2,r5
	resmac	r6
	imultn	r0,r3
	imacn	r1,r5
	resmac	r8
	sharq	#14,r6
	sharq	#14,r8
	storew	r6,(r29)
	addqt	#12,r29
	storew	r8,(r29)

noport:

