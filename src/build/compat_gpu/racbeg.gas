; legacy REGEQU bdorot => r24 ; othcarrt.gas:4

MACRO	JSR_DOBND
	move	PC,r31
	jump	(r24)
	addqt	#6,r31
ENDM

MACRO RTS_DOBND
	jump	(r31)
	nop
ENDM

;
; rotate all mobile bands' data points and vectors
; so that we can do collision detection properly
;
	movei	#norotting,r23
	movei	#dorot,r24
.if 0
	movei	#player,r29
	load	(r29),r16
	movei	#PLAYER1,r28
	cmp	r29,r16
	movei	#norotting,r28
	jump	NE,(r28)
	nop
.endif

	movei	#PLAYER1+CAR_MODEL,r16
	load	(r16),r16
	JSR_DOBND

	movei	#PLAYER2+CAR_MODEL,r16
	load	(r16),r16
	JSR_DOBND

	movei	#mbands,r16
	load	(r16),r16
	cmpq	#0,r16
	jump	EQ,(r23)
	nop
	JSR_DOBND

.if 1
	movei	#mbands,r16
	addqt	#8,r16				; mbands is a magic symbol
	or	r16,r16
	load	(r16),r16
	cmpq	#0,r16
	jump	EQ,(r23)
	nop
	JSR_DOBND
.endif

	jump	(r23)
	nop

;
; enter with "dest" == band to rotate
;

dorot:
	movei	#(BND_MATRIX), r15
	add	r16, r15
	load	(r15),r15
	nop
	or	r15,r15

	loadw	(r15), r0
	addqt	#2, r15
	loadw	(r15), r1
	addqt	#2, r15
	loadw	(r15), r2
	addqt	#2, r15
	loadw	(r15), r3
	addqt	#2, r15
	loadw	(r15), r4
	addqt	#2, r15
	loadw	(r15), r5
	addqt	#2, r15
	loadw	(r15), r6
	addqt	#2, r15
	loadw	(r15), r7
	addqt	#2, r15
	loadw	(r15), r8


; we have to replace the car points with transformed versions of these

	moveq	#NUM_PNTS, r28
	add	r16,r28
	loadw	(r28),r19
	addqt	#2,r28
	loadw	(r28),r29
	add	r29,r19		; numPnts is actually the number of points + number of vectors

	movei	#PNT_LIST,r28
	add	r16,r28		; now "temp" points to the pointer to the car's points
	load	(r28),r15		; now "source" points to the car points

	movei	#ROTPNT_LIST,r28
	add	r16,r28
	load	(r28),r17		; now dest2 points at the rotated point list
	nop

	move	r17, r16
	move	r17, r18

	subqt	#6, r16
	subqt	#4, r17
	subqt	#2, r18

	movei	#_CDLOCAL_20_118, r27
	loadw	(r15),r20
_CDLOCAL_20_118:
	; get data
	addqt	#6, r16
	addqt	#2, r15
	addqt	#6, r17
	loadw	(r15), r21
	addqt	#2, r15
	addqt	#6, r18
	loadw	(r15), r22

; do multiply, by the transpose (i.e. inverse) of the matrix
	imultn	r0, r20	;
	imacn	r3, r21	;
	imacn	r6, r22	;
	resmac	r12	;
	addqt	#2, r15
	sharq	#14, r12
	storew	r12, (r16)

	imultn	r1, r20	;
	imacn	r4, r21	;
	imacn	r7, r22	;
	resmac	r13	;
	sharq	#14, r13

	imultn	r2, r20	;
	imacn	r5, r21	;
	imacn	r8, r22	;
	resmac	r14	;
	storew	r13, (r17)
	sharq	#14, r14


	subq		#1, r19
	storew	r14, (r18)
	jump		NE, (r27)
	loadw	(r15), r20

	or	r20,r20			; make sure the last load is done

	RTS_DOBND

norotting:

; BEGIN rotc.inc
