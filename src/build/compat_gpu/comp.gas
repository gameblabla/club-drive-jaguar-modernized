rotVects:
	move		r16, r17
	move		r16, r18
	subqt	#6, r16
	subqt	#4, r17
	subqt	#2, r18
	movei	#_CDLOCAL_10_20, r27
_CDLOCAL_10_20:
	; get data
	addqt	#6, r16
	addqt	#2, r15
	addqt	#6, r17
	loadw	(r15), r21
	addqt	#2, r15
	addqt	#6, r18
	loadw	(r15), r22

	; do multiply
	imultn	r0, r20	;
	imacn	r1, r21	;
	imacn	r2, r22	;
	resmac	r12	;
	addqt	#2, r15
	sharq	#14, r12
	storew	r12, (r16)

	imultn	r3, r20	;
	imacn	r4, r21	;
	imacn	r5, r22	;
	resmac	r12	;
	sharq	#14, r12

	imultn	r6, r20	;
	imacn	r7, r21	;
	imacn	r8, r22	;
	resmac	r13	;
	storew	r12, (r17)
	sharq	#14, r13

	subq		#1, r19
	storew	r13, (r18)
	jump		NE, (r27)
	loadw	(r15), r20

	jump		(r31)
	cmp r20,r20 ;kills last read

