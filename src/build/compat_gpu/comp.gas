					;				tPolys[i*3  ] = (int)(vx >> ve);
					;				tPolys[i*3+1] = (int)(vy >> ve);
					;				tPolys[i*3+2] = (int)(vz >> ve);
	movefa	r0,r28
	movefa	r1,r31
	movefa	r2,r29

	sha	r30,r28
	sha	r30,r31
	sha	r30,r29

	moveq	#6,r30
