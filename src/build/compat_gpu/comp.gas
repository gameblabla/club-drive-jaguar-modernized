	movefa	r31,r21

	movei	#mtp_done,r25


	movei	#BND_MATRIX,r22
	add	r21,r22
	loadw	(r22),r22		; check for matrix

	movei	#tINITED,r29		; is this band already initialized properly?
	add	r21,r29
	loadw	(r29),r28

	cmpq	#0,r22			; is this a rotating band?
	jr	NE,initit		; if so, always initialize
	nop

	btst	#0,r28			; otherwise, check for being already inited
	jump	NE,(r25)		; and branch accordingly
	nop

initit:
	moveq	#1,r23			; set bit 0 of the tINITED flags
	storew	r23,(r29)

	load	(r21),r28		; get band flags
	btst	#0,r28			; collisions possible?
	jump	NE,(r25)		; no: skip everything else
	nop

	movei	#G_DIVCTRL,r29
	moveq	#0,r28
	store	r28,(r29)

	moveq	#NUM_CPS,r29		; numCPs = bnd->numcps
	add	r21,r29
	loadw	(r29),r7
	nop

	movei	#ROTPNT_LIST,r29		; normals = bnd->points+3*bnd->numpnts
	add	r21,r29
	load	(r29),r0
	moveq	#NUM_PNTS,r29
	add	r21,r29
	loadw	(r29),r29
	moveq	#6,r28
	mult	r28,r29
	move	r0,r3		; points = bnd->points - 3
	add	r29,r0
	subqt	#6,r3

	movei	#DIVIDER_LIST,r29	; dividers = bnd->dividers
	add	r21,r29
	load	(r29),r1

	movei	#EDGE_LIST,r29	; edges = bnd->edges
	add	r21,r29
	load	(r29),r2

	movei	#tPOLYS,r29		; tPolys = bnd->tpolys + 5
	add	r21,r29
	load	(r29),r5
	nop
	addqt	#10,r5

	movei	#SURF_LIST,r29	; polyBase = polys = bnd->surfs
	add	r21,r29
	load	(r29),r4
	moveq	#0,r9
	move	r4,r6

					;	for (cp=0; cp<numCPs; cp++) {

	cmp	r7,r9
	jump	PL,(r25)		; outerLoop still contains mtp_done
	nop

	movei	#forlp,r25
	movei	#endforlp,r26
	movei	#innerfor,r27

forlp:
	loadw	(r4),r10	;		while ((numSides = (*polys++) & 0x0f) != 0) {
	addqt	#2,r4
	moveq	#15,r28
