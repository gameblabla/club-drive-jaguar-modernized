minz:
	cmp	r24,r29
	jr	MI,donemax
	nop
		moveta	r24,r10

donemax:

	addqt	#1,r8
	cmp	r10,r8		; } end of inner for loop
	jump	MI,(r27)
	nop


					;			/* find center */
					;			tPolys[-3] = (int)(avgX /= numSides);
	movefa	r7,r14
	movefa	r6,r22
	movefa	r9,r15
	movefa	r8,r23
	movefa	r31,r16
	movefa	r10,r24

	add	r22,r14				; max and min were already divided by 2 (see above),
	add	r23,r15				; so this really does find the average of max and min
	add	r24,r16				;( median of points )

	move	r5,r29
	subqt	#6,r29

	storew	r14,(r29)
	addqt	#2,r29

	storew	r15,(r29)		;			tPolys[-2] = (int)(avgY /= numSides);
	addqt	#2,r29
					;			tPolys[-1] = (int)(avgZ /= numSides);

	storew	r16,(r29)


					;			/* find radius */
					;			/* (actually, approximate it using the min and max stuff we found above)
	movefa	r7,r22
	movefa	r9,r23
	movefa	r31,r24
	shlq	#1,r22
	shlq	#1,r23
	shlq	#1,r24
	sub	r14,r22
	sub	r15,r23
	sub	r16,r24
	abs	r22
	abs	r23
	abs	r24	
	movei	#$80,r28			; $80 == car radius (before squaring); correct for this
	add	r28,r22
	add	r28,r23
	add	r28,r24

	imultn	r22,r22
	imacn	r23,r23
	imacn	r24,r24
	resmac	r20

					;			*((long *)(tPolys-5)) = maxDistance + CAR_RADIUS;
;	movei	#2*CAR_RADIUS,temp
;	add	temp,maxDistance

	move	r5,r29
	subqt	#10,r29
	rorq	#16,r20
	storew	r20,(r29)
	addqt	#2,r29
	rorq	#16,r20
	storew	r20,(r29)
					;			tPolys += 5 + (3*numSides);  /* don't bother long aligning */
	moveq	#6,r29
	mult	r10,r29
	addqt	#10,r29
	add	r29,r5
					;			polys += 1 + numSides;
	add	r10,r4
	add	r10,r4
	addqt	#2,r4

	jump	(r25)		;	}	/* end of while loop */
	nop
endforlp:
	addqt	#1,r9
enterloop:
	cmp	r7,r9
	jump	MI,(r25)
	nop

mtp_done:

	moveta	r21,r31

; GASM REGUNDEF normals ; mktp.gas:453
; GASM REGUNDEF edges ; mktp.gas:454
; GASM REGUNDEF points ; mktp.gas:455
; GASM REGUNDEF polys ; mktp.gas:456
; GASM REGUNDEF tPolys ; mktp.gas:457
; GASM REGUNDEF polyBase ; mktp.gas:458
; GASM REGUNDEF numCPs ; mktp.gas:459
; GASM REGUNDEF i ; mktp.gas:460
; GASM REGUNDEF cp ; mktp.gas:461
; GASM REGUNDEF numSides ; mktp.gas:462
; GASM REGUNDEF nx ; mktp.gas:463
; GASM REGUNDEF ny ; mktp.gas:464
; GASM REGUNDEF nz ; mktp.gas:465
; GASM REGUNDEF avgX ; mktp.gas:466
; GASM REGUNDEF avgY ; mktp.gas:467
; GASM REGUNDEF avgZ ; mktp.gas:468
; GASM REGUNDEF pnt ; mktp.gas:469
; GASM REGUNDEF pntLast ; mktp.gas:470
; GASM REGUNDEF distance ; mktp.gas:471
; GASM REGUNDEF maxDistance ; mktp.gas:472
; GASM REGUNDEF bnd ; mktp.gas:473
; GASM REGUNDEF pnt0 ; mktp.gas:474
; GASM REGUNDEF pnt1 ; mktp.gas:475
; GASM REGUNDEF pnt2 ; mktp.gas:476
; GASM REGUNDEF outerLoop ; mktp.gas:477
; GASM REGUNDEF endLoop ; mktp.gas:478
; GASM REGUNDEF temp3 ; mktp.gas:479
; GASM REGUNDEF temp1 ; mktp.gas:480
; GASM REGUNDEF vx ; mktp.gas:481
; GASM REGUNDEF vy ; mktp.gas:482
; GASM REGUNDEF vz ; mktp.gas:483
; GASM REGUNDEF ALTpnt0 ; mktp.gas:484
; GASM REGUNDEF ALTpnt1 ; mktp.gas:485
; GASM REGUNDEF ALTpnt2 ; mktp.gas:486
; GASM REGUNDEF ALTminx ; mktp.gas:487
; GASM REGUNDEF ALTmaxx ; mktp.gas:488
; GASM REGUNDEF ALTminy ; mktp.gas:489
; GASM REGUNDEF ALTmaxy ; mktp.gas:490
; GASM REGUNDEF ALTminz ; mktp.gas:491
; GASM REGUNDEF ALTmaxz ; mktp.gas:492
; END mktp.gas
; BEGIN bf.gas
;----------------------------------------------------------------------------
;	bf.gas
;		Back Face tests bunches of normals for polygon culling and object
;	ordering.
;		Also computes "closeness" to the car's coordinate (which may
;	differ from the eye coordinate).
;
; NOTE: all calculations are done in world coordinates, before points are transformed
;----------------------------------------------------------------------------
; legacy REGEQU px => R0 ; bf.gas:10
; legacy REGEQU py => R1 ; bf.gas:11
; legacy REGEQU pz => R2 ; bf.gas:12
; legacy REGEQU nx => R3 ; bf.gas:13
; legacy REGEQU ny => R4 ; bf.gas:14
; legacy REGEQU nz => R5 ; bf.gas:15
; legacy REGEQU dividers => R6 ; bf.gas:16
; legacy REGEQU vectors => R7 ; bf.gas:17
; legacy REGEQU points => R8 ; bf.gas:18
; legacy REGEQU tDividers => R9 ; bf.gas:19
; legacy REGEQU numNorms => R10 ; bf.gas:20
; legacy REGEQU six => R11 ; bf.gas:21
; legacy REGEQU radius => r11 ; bf.gas:22
; legacy REGEQU xe => R12 ; bf.gas:23
; legacy REGEQU tempZ => R13 ; bf.gas:24
; legacy REGEQU ze => R14 ; bf.gas:25
; legacy REGEQU normal => R15 ; bf.gas:26
; legacy REGEQU posn => R16 ; bf.gas:27
; legacy REGEQU closeList => R17 ; bf.gas:28

; legacy REGEQU ex => R18 ; bf.gas:30
; legacy REGEQU ey => R19 ; bf.gas:31
; legacy REGEQU ez => R20 ; bf.gas:32

; legacy REGEQU ox => R21 ; bf.gas:34
; legacy REGEQU oy => R22 ; bf.gas:35
; legacy REGEQU oz => R23 ; bf.gas:36

; legacy REGEQU p2x => R24 ; bf.gas:38
; legacy REGEQU p2y => R25 ; bf.gas:39
; legacy REGEQU p2z => R26 ; bf.gas:40


; REGISTERS R27-R31 reserved

	moveq	#6, r11
	movefa	r31,r29
	movei	#ROTPNT_LIST, r8
	add	r29,r8
	load	(r8),r8
	moveq	#NUM_PNTS, r7
	add	r29,r7
	loadw	(r7),r7
	movei	#tDIVIDERS, r9
	add	r29,r9
	load	(r9),r9
	movei	#DIVIDER_LIST, r28
	add	r29,r28
	load	(r28), r6
	moveq	#NUM_DIVIDERS, r28
	add	r29,r28
	loadw	(r28), r10
	movei	#XORIG,r28
	add	r29,r28
	load	(r28),r0		; get center of current band
	addqt	#4,r28
	load	(r28),r1
	addqt	#4,r28
	load	(r28),r2

	movei	#tCLOSE_LIST, r17
	add	r29,r17
	load	(r17),r17

; load up eye and car coordinates
	movefa	r20,r21
	movefa	r21,r22
	movefa	r22,r23
	movefa	r23,r18
	movefa	r24,r19
	movefa	r25,r20

; adjust by band center
	sub	r0,r18
	sub	r1,r19
	sub	r2,r20

	sub	r0,r21
	sub	r1,r22
	sub	r2,r23

	mult	r11,r7
	add	r8,r7

	movei	#bfLoop, r27
	load		(r6), r15
bfLoop:
	addqt	#4,r6

	move		r15, r16	; split into two vector addresses
	shrq		#16, r16

	mult		r11, r15
	mult		r11, r16
	add		r7, r15
	add		r8, r16

	loadw	(r16), r0		; get plane point (0.16)
	addqt	#2, r16
	loadw	(r16),r1
	addqt	#2,r16
	loadw	(r16),r2
	shlq	#16,r0			; convert to 20.12
	shlq	#16,r1
	shlq	#16,r2
	sharq	#4,r0
	sharq	#4,r1
	sharq	#4,r2
	move	r0,r24
	move	r1,r25
	move	r2,r26

	sub	r18,r0
	sub	r19,r1
	sub	r20,r2
	sub	r21,r24
	sub	r22,r25
	sub	r23,r26

	move		r0, r29
	move		r1, r28
	abs		r29
  	abs		r28
	move		r2, r13
	abs		r13
	or		r29, r28
							loadw	(r15), r3	; get vector (0.15)
	or		r13, r28
							addqt	#2, r15
	normi	r28, r12
							loadw	(r15), r4
	addqt	#9, r12
							addqt	#2, r15
	sha		r12, r0
	sha		r12, r1
							loadw	(r15), r5
	sha		r12, r2	;na na


	imultn	r0, r3		; dot product of two vectors
	imacn	r1, r4
	imacn	r2, r5
	resmac	r0

	shrq		#31, r0		; store sign bit
	storeb	r0, (r9)

	; compute closeness to car
	move		r24, r29
	move		r25, r28
	abs		r29
	abs		r28
	move		r26, r13
	abs		r13
	or		r29, r28
	or		r13, r28
	normi	r28,r12
	addqt	#9,r12

	sha	r12,r24
	sha	r12,r25
	sha	r12,r26

	imultn	r24, r3		; dot product of two vectors
	imacn	r25, r4
	imacn	r26, r5
	resmac	r24


	neg		r12
	addqt	#21, r12		; 20.12x0.15 ->20.0, then *$40; so 15+12-6
	sha		r12, r24

	abs		r24
	sat16	r24

	storew	r24, (r17)
	addqt	#2, r17
	subq		#1, r10
	addqt	#1, r9
	jump		NE, (r27)
	load	(r6),r15

	cmp	r15,r15	; clear final load

; legacy REGEQU bndflags => r15 ; bf.gas:195
; legacy REGEQU dist => r24 ; bf.gas:196
; legacy REGEQU goclip => r25 ; bf.gas:197

; GASM REGUNDEF normal ; bf.gas:199
; GASM REGUNDEF p2x ; bf.gas:200
; GASM REGUNDEF p2y ; bf.gas:201
; GASM REGUNDEF p2z ; bf.gas:202

;
; now check the band's distance to the viewing planes
;
	movefa	r31,r29
	nop
	load	(r29),r15	; get the band flags
	movei	#XORIG,r28
	add	r28,r29
	load	(r29),r21	; put the band's origin in (ox,oy,oz)
	bclr	#14,r15	; clear the "clip behind" flag
	addqt	#4,r29
	load	(r29),r22
	addqt	#4,r29
	load	(r29),r23
	addqt	#4,r29
	load	(r29),r11	; and band's radius in "radius"
;
; get camera position into (ex,ey,ez)
;
	movefa	r27,r29
	movei	#CAMERA_FLAG,r28
	add	r28,r29
	movefa	r23,r18
	movefa	r24,r19
	movefa	r25,r20
;
; make sure (ox,oy,oz) for band position is relative to the eye
; and is an integer
;
	sharq	#12,r21
	sharq	#12,r22
	sharq	#12,r23
	sharq	#12,r18
	sharq	#12,r19
	sharq	#12,r20
	sub	r18,r21
	sub	r19,r22
	sub	r20,r23

	movei	#doclip,r25
	loadw	(r29),r28		; get CAMERA_FLAG
	movei	#CAR_MODEL,r29
	cmpq	#0,r28			; is it the inside the cockpit view?
	jr	NE,_CDLOCAL_10_255
	nop
		movefa	r27,r28
		add	r28,r29
		load	(r29),r29	; is this the car's model?
		movefa	r31,r28
		cmp	r29,r28
		jump	EQ,(r25)	; yes -- clip it away
		nop
_CDLOCAL_10_255:

;
; normalize (ox,oy,oz) to (0.16)
;
	move	r21,r28
	move	r22,r29
	abs	r28
	abs	r29
	or	r29,r28
	move	r23,r29
	abs	r29
	or	r29,r28
	normi	r28,r12
	addqt	#9,r12
	sha	r12,r21
	sha	r12,r22
	sha	r12,r23
	neg	r12
	addqt	#14,r12			; we'll be multiplying by 0.14 numbers
;
; see if band is directly behind
;
	movefa	r13,r3
	movefa	r16,r4
	movefa	r19,r5

	imultn	r21,r3
	imacn	r22,r4
	imacn	r23,r5
	resmac	r24			; gives us a (signed) distance to the plane

	cmpq	#0,r24			; if distance is positive, band is in front of plane -> no clipping
	jr	PL,noclip1
	nop
		sha	r12,r24
		moveq	#0,r28
		abs	r24
		bset	#15,r28
		cmp	r28,r24		; if backwards distance >= $8000, always clip
		jump	PL,(r25)
		nop
		mult	r24,r24
		cmp	r11,r24		; if backwards distance < radius, we can't clip
		jump	PL,(r25)
		nop
noclip1:
;
; next try at a 30 degree angle
;
	movei	#$6ed9,r28			; sqrt(3)/2, in 0.15
	imult	r28,r3
	imult	r28,r4
	imult	r28,r5
	sharq	#15,r3
	sharq	#15,r4
	sharq	#15,r5
	movefa	r11,r0
	movefa	r14,r1
	movefa	r17,r2
	shlq	#16,r0				; sign extend...
	shlq	#16,r1
	shlq	#16,r2
	sharq	#17,r0				; and divide by 2
	sharq	#17,r1
	sharq	#17,r2
	sub	r0,r3
	sub	r1,r4
	sub	r2,r5

; now do the dot product

	imultn	r21,r3
	imacn	r22,r4
	imacn	r23,r5
	resmac	r24			; gives us a (signed) distance to the plane

	cmpq	#0,r24			; if distance is positive, band is in front of plane -> no clipping
	jr	PL,noclip2
	nop
		sha	r12,r24
		moveq	#0,r28
		abs	r24
		bset	#15,r28
		cmp	r28,r24		; if backwards distance >= $8000, always clip
		jump	PL,(r25)
		nop
		mult	r24,r24
		cmp	r11,r24		; if backwards distance < radius, we can't clip
		jump	PL,(r25)
		nop
noclip2:

; finally try the other 30 degree angle
	shlq	#1,r0
	shlq	#1,r1
	shlq	#1,r2
	add	r0,r3
	add	r1,r4
	add	r2,r5

	imultn	r21,r3
	imacn	r22,r4
	imacn	r23,r5
	resmac	r24			; gives us a (signed) distance to the plane

	cmpq	#0,r24			; if distance is positive, band is in front of plane -> no clipping
	jr	PL,noclip3
	nop
		sha	r12,r24
		moveq	#0,r28
		abs	r24
		bset	#15,r28
		cmp	r28,r24		; if backwards distance >= $8000, always clip
		jump	PL,(r25)
		nop
		mult	r24,r24
		cmp	r11,r24		; if backwards distance < radius, we can't clip
		jump	PL,(r25)
		nop
noclip3:

	jr	storeit
	nop
doclip:
		bset	#14,r15			; set the "clip" flag		
storeit:
		movefa	r31,r29
		bclr	#13,r15		; clear the "put in list" flag
		store	r15,(r29)


; register cleanup ----------------------------------------------------
; GASM REGUNDEF px ; bf.gas:389
; GASM REGUNDEF py ; bf.gas:390
; GASM REGUNDEF pz ; bf.gas:391
; GASM REGUNDEF nx ; bf.gas:392
; GASM REGUNDEF ny ; bf.gas:393
; GASM REGUNDEF nz ; bf.gas:394
; GASM REGUNDEF dividers ; bf.gas:395
; GASM REGUNDEF vectors ; bf.gas:396
; GASM REGUNDEF points ; bf.gas:397
; GASM REGUNDEF tDividers ; bf.gas:398
; GASM REGUNDEF numNorms ; bf.gas:399
; GASM REGUNDEF six ; bf.gas:400
; GASM REGUNDEF xe ; bf.gas:401
; GASM REGUNDEF tempZ ; bf.gas:402
; GASM REGUNDEF ze ; bf.gas:403
; GASM REGUNDEF bndflags ; bf.gas:404
; GASM REGUNDEF posn ; bf.gas:405
; GASM REGUNDEF dataHi ; bf.gas:406
; GASM REGUNDEF closeList ; bf.gas:407
; GASM REGUNDEF dist ; bf.gas:408
; GASM REGUNDEF finish ; bf.gas:409
; GASM REGUNDEF radius ; bf.gas:410
; GASM REGUNDEF goclip ; bf.gas:411
; END bf.gas
;
; the rest of the calculations can be skipped if the band is "far enough" behind
; the viewing plane
;
	movefa	r31,r28
	load	(r28),r28
	movei	#comploop,r29
	btst	#14,r28
	jump	NE,(r29)
	nop
;
; save tPNTS for this band
;
	movefa	r31,r28
	movei	#tPNTS,r29
	add	r28,r29
	movefa	r26,r28
	nop
	store	r28,(r29)

; BEGIN rot.gas
; Rotation Matrix Multiply

; BEGIN rot.inc
;- Rotation register defines ----------------------------------------------

; rotation matrix
; legacy REGEQU m0 => R0 ; rot.inc:4
; legacy REGEQU m1 => R1 ; rot.inc:5
; legacy REGEQU m2 => R2 ; rot.inc:6
; legacy REGEQU m3 => R3 ; rot.inc:7
; legacy REGEQU m4 => R4 ; rot.inc:8
; legacy REGEQU m5 => R5 ; rot.inc:9
; legacy REGEQU m6 => R6 ; rot.inc:10
; legacy REGEQU m7 => R7 ; rot.inc:11
; legacy REGEQU m8 => R8 ; rot.inc:12

; legacy REGEQU xo => R9 ; rot.inc:14
; legacy REGEQU yo => R10 ; rot.inc:15
; legacy REGEQU zo => R11 ; rot.inc:16

; computed data
; legacy REGEQU resultX => R12 ; rot.inc:19
; legacy REGEQU resultY => R13 ; rot.inc:20
; legacy REGEQU resultZ => R14 ; rot.inc:21

; pointers
; legacy REGEQU source => R15 ; rot.inc:24
; legacy REGEQU dest => R16 ; rot.inc:25
; legacy REGEQU dest2 => R17 ; rot.inc:26
; legacy REGEQU dest3 => R18 ; rot.inc:27
; legacy REGEQU numPnts => R19 ; rot.inc:28

; legacy REGEQU x => R20 ; rot.inc:30
; legacy REGEQU y => R21 ; rot.inc:31
; legacy REGEQU z => R22 ; rot.inc:32

; legacy REGEQU xaz => R20 ; rot.inc:34
; legacy REGEQU yaz => R21 ; rot.inc:35
; legacy REGEQU ze => R22 ; rot.inc:36

; legacy REGEQU rightSd => R23 ; rot.inc:38
; legacy REGEQU bottomSd => R24 ; rot.inc:39

; legacy REGEQU dataHi => R25 ; rot.inc:41
; legacy REGEQU sectors => R26 ; rot.inc:42

;innerLoop	REGEQU	R27

;---------------------------------------------------------------------------

; END rot.inc
;;- Rotation register defines ----------------------------------------------
;
;; rotation matrix
;m0		REGEQU	R0	; matrix[0]		| m0 m1 m2 |
;m1		REGEQU	R1	; matrix[1]		| m3 m4 m5 |
;m2		REGEQU	R2	; matrix[2]		| m6 m7 m8 |
;m3		REGEQU	R3	; matrix[3]
;m4		REGEQU	R4	; matrix[4]
;m5		REGEQU	R5	; matrix[5]
;m6		REGEQU	R6	; matrix[6]
;m7		REGEQU	R7	; matrix[7]
;m8		REGEQU	R8	; matrix[8]
;
;xo		REGEQU	R9	; origin coords for translation
;yo		REGEQU	R10
;zo		REGEQU	R11
;
;; computed data
;resultX	REGEQU	R12
;resultY	REGEQU	R13
;resultZ	REGEQU	R14
;
;; pointers
;source	REGEQU	R15
;dest		REGEQU	R16
;dest2	REGEQU	R17
;dest3	REGEQU	R18
;numPnts	REGEQU	R19
;
;x		REGEQU	R20	; original data
;y		REGEQU	R21
;z		REGEQU	R22
;
;xaz		REGEQU	R20	; edge computed data
;yaz		REGEQU	R21
;ze		REGEQU	R22
;
;rightSd	REGEQU	R23	; slopes of the edge of the view cone
;bottomSd	REGEQU	R24
;
;dataHi	REGEQU	R25
;sectors	REGEQU	R26
;
;;innerLoop	REGEQU	R27
;
;;---------------------------------------------------------------------------

	; read in rotation matrix (optimize for space)
	movefa	r23,r9
	movefa	r24,r10
	movefa	r25,r11
;		sharq	#12, xo
;		sharq	#12, yo
;		sharq	#12, zo

	movefa	r11,r0
	movefa	r14,r1
	movefa	r17,r2

	movefa	r12,r3
	movefa	r15,r4
	movefa	r18,r5

	movefa	r13,r6
	movefa	r16,r7
	movefa	r19,r8

	movei	#matLoop, r27
	movefa	r31,r29
	movei	#ROTPNT_LIST, r28
	add	r29,r28
	load		(r28), r15
.if 0
	movei	#tPNTS, r16
	add	r29,r16
	load	(r16),r16
.else
	movefa	r26,r16
.endif
	movei	#NUM_PNTS, r28
	add	r29,r28
	loadw	(r28), r19

	; take into account the origin of the .bnd
	movei	#XORIG,r28
	add	r29,r28
	load	(r28),r17		; don't need dest2 yet, so use it as scratch...
	addqt	#4,r28
	sub	r17,r9
	load	(r28),r17
	addqt	#4,r28
	sub	r17,r10
	load	(r28),r17
	sub	r17,r11

.if 0
	; compute rightSd, bottomSd
	movei	#18927, r23
	movei	#5619, r24
;	movei	#18151, rightSd
;	movei	#8245, bottomSd
.else
	movei	#SIDES,r24			; sides depend on number of players
	load	(r24),r23
	addqt	#4,r24
	load	(r24),r24
.if DOSCALE
	sharq	#1,r23
	sharq	#1,r24
.endif
.endif

	; compute the 3 starting dests
	move		r16, r17
	move		r16, r18
	subqt	#32, r16
	subqt	#24, r17
	subqt	#16, r18

	; shift to 18.14 with sign extend
;	shlq		#16, xo
;	shlq		#16, yo
;	shlq		#16, zo
;	sharq	#2, xo
;	sharq	#2, yo
;	sharq	#2, zo

	movei	#G_HIDATA, r25
	loadw	(r15), r20
matLoop:
	; get data
	addqt	#32, r16
	addqt	#2, r15
	addqt	#32, r17
	loadw	(r15), r21
	addqt	#2, r15
	addqt	#32, r18
	loadw	(r15), r22

	; subtract car posn
	shlq		#16, r20
	shlq		#16, r21
	sharq	#4, r20
	sharq	#4, r21
	sub		r9, r20
	sub		r10, r21
	shlq		#16, r22
	sharq	#4, r22
	sub		r11, r22
	; make 16 bits
	move		r20, r28
	abs		r28
	move		r21, r29
	abs		r29
	or		r29, r28
	move		r22, r29
	abs		r29
	or		r29, r28
	normi	r28, r29
	addqt	#9, r29
;	moveq	#12, temp2	
	sha		r29, r20
	sha		r29, r21
	sha		r29, r22
	neg		r29
	addqt	#12, r29

	; do multiply
	imultn	r3, r20	;
	imacn	r4, r21	;
	imacn	r5, r22	;
	resmac	r13	;
	sha		r29, r13	; back to 17.15
	addqt	#2, r15
;	add		yo, resultY	; translate
	store	r13, (r25)

	imultn	r0, r20	;
	imacn	r1, r21	;
	imacn	r2, r22	;
	resmac	r12	;
	sha		r29, r12	; back to 17.15
;	add		xo, resultX	; translate
	storep	r12, (r16)

	imultn	r6, r20	;
	imacn	r7, r21	;
	imacn	r8, r22	;
	resmac	r14	;
	sha		r29, r14	; back to 17.15
;	add		zo, resultZ	; translate

	move		r14, r21	; for normi only
	move		r14, r20
	abs		r21
	normi	r21, r22
	addq		#9, r22		; leave one for sign bit
	sha		r22, r20
	neg		r22
	move		r20, r21
.if DOSCALE
	addqt	#14,r22
.else
	addqt	#15, r22		; add exp of Sd's
.endif
	imult	r23, r20
	imult	r24, r21

	sha		r22, r20		; align with resultX, Y
	sha		r22, r21
	; set sectors
	cmp		r12, r20
	moveq	#0, r26
	jr		PL, noRight
	neg		r20
	bset		#RIGHT_EDGE, r26
noRight:
	cmp		r20, r12
	jr		PL, noLeft
	neg		r20
	bset		#LEFT_EDGE, r26
noLeft:
	cmp		r13, r21
	jr		PL, noBottom
	neg		r21
	bset		#BOTTOM_EDGE, r26
noBottom:
	cmp		r21, r13 
	jr		PL, noTop
	neg		r21
	bset		#TOP_EDGE, r26
noTop:

	store	r14, (r25)
	storep	r26, (r17)

	store	r21, (r25)
	subq		#1, r19
	storep	r20, (r18)
	jump		NE, (r27)
	loadw	(r15), r20

; vector section -----------------------------------------------------------
	cmp r20,r20	; wait for last load

	movefa	r31,r29
	movei	#tVECTORS, r16
	add	r29,r16
	load	(r16), r16
	movei	#NUM_VECTORS, r28
	add	r29,r28
	loadw	(r28), r19
	JSR_ROT

; BEGIN rotc.inc
