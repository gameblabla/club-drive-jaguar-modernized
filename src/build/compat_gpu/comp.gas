	bset	#13,r28
	store	r28,(r3)
	store	r3,(r1)
	jr	_CDLOCAL_10_196
	addqt	#4,r1

_CDLOCAL_20_209:

;
; if the camera is different from the floor, add its list, too
;
	movei	#CAMERA_MODEL,r29
