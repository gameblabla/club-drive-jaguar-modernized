negative:
	shlq	#2,r28
positive:
	add	r2,r28
	loadw	(r28),r17
	mult	r29,r17

	move	r17,r29		;				avgX += points[pnt];
	add	r3,r29

	loadw	(r29),r22
	addqt	#2,r29
	loadw	(r29),r23		;				avgY += points[pnt+1];
	addqt	#2,r29
