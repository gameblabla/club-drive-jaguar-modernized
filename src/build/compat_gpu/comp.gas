;-------------------------------------------------------------------
; this is a test
;	phrase read
;		loadp	(source), x	; memory access #1 -----------
;		addqt	#8, source
;		.several (4?)
;		move		x, y			; waits for phrase load
;		load		(dataHi), z	; grab upper word
;		loadp	(source), y2	; memory access #2 -----------
;		addqt	#8, source
;		move		y2, z2		; waits for phrase load
;		load		(dataHi), x3	; grab upper word
;		loadp	(source), z3	; memory access #3 -----------
;		addqt	#8, source
;		move		z3, x4		; waits for phrase load
;		load		(dataHi), y4	; grab upper word
;-------------------------------------------------------------------
; set up first vert
;		move		z, x2
;		;and		lowMask, x	; mult throws out anyway
;		;and		lowMask, z	; ditto
;		shrq		#16, y
;
;
; convert to float - adds 6 instructs - ~50% to rot
;		normi	result, exp
;		add		#, exp
;		sha		exp, result
;		neg		exp
;		; pack
;		and		lowMask, result
;		shlq		#16, exp
;		or		exp, result
;
;
;
; END rot.gas
; BEGIN shade.gas
; Shade.gas - compute lighting
;
;
; The following types of lighting are supported
; Lighting based on world lights:
;	0: ordinary dynamic lighting: "vector" is the normal vector index, "ambient" the base color, "diffuse" the amount that can be
;					added based on the dot product of the normal and the light direction
;	1: brake light: same as 0, except that if the player's brakes are on, intensity is set to 0xff (maximum)
;
; Lighting based on time ("timestamp") in 300ths of a second:
;	2: flashing light: "vector" is divided into 4 nybbles t,x,y,z, and then the color is computed as
;		color = ((timestamp >> x) % y) == z ? diffuse : ambient
;	   t (the highest nybble) is currently unused and should be left as 0
;	3: pulsing light: ambient is the base color, and its intensity is calculated as:
;		intensity = ambient intensity + abs((((timestamp/16) % vector) - vector/2)) * diffuse 
;
;- Shading loop register defines ----------------------------------------------

; blitter data
; legacy REGEQU ix => R0 ; shade.gas:20
; legacy REGEQU iy => R1 ; shade.gas:21
; legacy REGEQU iz => R2 ; shade.gas:22

; legacy REGEQU snx => R3 ; shade.gas:24
; legacy REGEQU sny => R4 ; shade.gas:25
; legacy REGEQU snz => R5 ; shade.gas:26

; addresses
; legacy REGEQU vectorList => R6 ; shade.gas:29
; legacy REGEQU colorList => R7 ; shade.gas:30
; legacy REGEQU lightList => R8 ; shade.gas:31
; legacy REGEQU light => R9 ; shade.gas:32

; counters
; legacy REGEQU numLights => R10 ; shade.gas:35
; legacy REGEQU lightCounter => R11 ; shade.gas:36
; legacy REGEQU numColors => R12 ; shade.gas:37

; legacy REGEQU result => R13 ; shade.gas:39
; legacy REGEQU vector => R14 ; shade.gas:40
; legacy REGEQU sum => R15 ; shade.gas:41

; legacy REGEQU tColorList => R16 ; shade.gas:43
; legacy REGEQU six => R17 ; shade.gas:44
; legacy REGEQU ambient => R18 ; shade.gas:45
; legacy REGEQU diffuse => R19 ; shade.gas:46

; global .bnd pointer
; legacy REGEQU geoband => R20 ; shade.gas:49

; legacy REGEQU type => R21 ; shade.gas:51
; legacy REGEQU thePlayer => R22 ; shade.gas:52
; legacy REGEQU branch => R23 ; shade.gas:53

;innerLoop	REGEQU	R27
;---------------------------------------------------------------------------

; BEGIN joypad.inc
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Header File: JOYPAD.INC
;              Jaguar Joypad Equates
;
; NOTICE: This file has been incorporated into JAGUAR.INC. This file
;         is for compatibility reasons only. You should be using
;	   JAGUAR.INC instead.
        

; END joypad.inc

; read color data

		moveq	#6, r17
		movefa	r31,r20
		movei	#tCOLORS, r16
		add	r20, r16
		load	(r16), r16

	; use global vectors
	movei	#ROTPNT_LIST, r28
	add	r20,r28
	load		(r28), r6
	movei	#NUM_PNTS, r28
	add	r20,r28
	loadw	(r28), r29
	mult		r17, r29
	add		r29, r6

		subqt	#2, r16		; ready to preincrement
		movei	#COLOR_LIST, r28
		add	r20,r28
		load		(r28), r7
		movei	#LIGHTS, r8

		movei	#NUM_COLORS, r28
		add	r20,r28
		moveq	#2, r10			; stand in
		loadw	(r28), r12
		movei	#outLLoop, r27
		movei	#endIt,r28
		cmpq	#0,r12
		jump	EQ,(r28)
		nop
outLLoop:
		loadw	(r7),r21
		addqt	#2,r7
		loadw	(r7), r14
		addqt	#2, r7
		loadw	(r7), r18
		addqt	#2, r7
		loadw	(r7), r19

		cmpq	#2,r21
		movei	#timestuff,r29
		jump	PL,(r29)
		nop

		imult	r17, r14
		add		r6, r14

		loadw	(r14), r3
		addqt	#2, r14
;	cmp snx,snx
		loadw	(r14), r4
		addqt	#2, r14
;	cmp sny,sny
		loadw	(r14), r5

		move		r10, r11
		move		r8, r9
		moveq	#0, r15
inLLoop:
			load		(r9), r0
			addqt	#4, r9
			load		(r9), r1
			addqt	#4, r9
			load		(r9), r2
			addqt	#4, r9

			imultn	r2, r5	;
			imacn	r1, r4	;
			imacn	r0, r3	;
			resmac	r13	;


			sharq	#15, r13
			sat16	r13
			subq		#1, r11
			jr		NE, inLLoop
			add		r13, r15

		shrq	#2,r15				; divide sum by 4 to avoid overflow
		mult	r15, r19
		addqt	#2, r16
		move	r18,r28
		shrq	#13,r19			; make up for earlier division by 4
		shlq	#24,r28			; extract the intensity
		shrq	#8,r18
		shrq	#24,r28
		add	r19,r28
		shlq	#8,r18
		sat8	r28
		movei	#stowIt,r23
		cmpq	#1,r21
		jump	NE,(r23)
		nop
	; a brake light
			movefa	r27,r22
			movei	#CAR_MODEL,r29
			add	r22,r29
			load	(r29),r29
			cmp	r20,r29		; drawing our own car?
			jr	EQ,_CDLOCAL_10_165			; yes
			nop
			movei	#(PLAYER1^PLAYER2),r29
			xor	r29,r22
_CDLOCAL_10_165:
			movei	#CAR_CTRL,r29
			add	r22,r29
			load	(r29),r29
			btst	#FIRE_A,r29		; brake on?
			jump	EQ,(r23)
			nop
				movei	#$ff,r28	; max intensity
stowIt:
		or		r28, r18
		subq		#1, r12
		storew	r18, (r16)

		jump		NE, (r27)
		addqt	#2, r7
		movei	#endIt,r29
		jump	(r29)
		nop
timestuff:
		movei	#framecnt,r28
		addqt	#2,r16
		load	(r28),r28
		cmpq	#2,r21
		movei	#pulsing,r29
		jump	NE,(r29)
		nop
flashing:
		move	r14,r0
		move	r14,r1
		move	r14,r2
		shlq	#20,r0
		shlq	#24,r1
		shlq	#28,r2
		shrq	#28,r0
		shrq	#28,r1
		shrq	#28,r2
		sha	r0,r28
		div	r1,r28
		movei	#G_REMAIN,r29
		or	r28,r28
		load	(r29),r29		; get remainder
		cmpq	#0,r29
		jr	PL,_CDLOCAL_10_210
		nop
			add	r1,r29
_CDLOCAL_10_210:
		cmp	r2,r29
		jr	NE,stowAmbient
		nop
			move	r19,r18
stowAmbient:
		subq	#1,r12
		storew	r18,(r16)
		jump	NE,(r27)
		addqt	#2,r7

	movei	#endIt,r29
	jump	(r29)
	nop

pulsing:
		shrq	#4,r28			; divide by 16 (so we've got roughly 20ths of a second)
		div	r14,r28
		movei	#G_REMAIN,r29
		or	r28,r28
		load	(r29),r29		; get remainder
		cmpq	#0,r29
		jr	PL,_CDLOCAL_10_235
		nop
			add	r14,r29
_CDLOCAL_10_235:
		shrq	#1,r14
		sub	r14,r29
		abs	r29
		mult	r19,r29
		move	r18,r28
		shlq	#24,r28
		shrq	#8,r18
		shrq	#24,r28
		shlq	#8,r18
		add	r29,r28
		sat8	r28
		movei	#stowAmbient,r29
		jump	(r29)
		or	r28,r18

;
; data storage
; the longs are word-swapped because of a GASM bug
;
	.align 4
LIGHTS:
	; Original GASM/LTXCONV emitted word-swapped longs for this table.
	; Modern RMAC does not: represent retail halfword order explicitly.
	dc.w	$0000,$13fd,$ffff,$880f,$0000,$27fb
	dc.w	$0000,$0000,$ffff,$fc77,$ffff,$e032

endIt:

; GASM REGUNDEF geoband ; shade.gas:265

; END shade.gas
; BEGIN clp.gas
;----------------------------------------------------------------------------
;	clip.gas
;		Edge cut computations
;
;----------------------------------------------------------------------------

; edge cut --------------------------------------------------------------

; legacy REGEQU edges => R0 ; clp.gas:9
; legacy REGEQU points => R1 ; clp.gas:10
; legacy REGEQU tEdges => R2 ; clp.gas:11
; legacy REGEQU a => R3 ; clp.gas:12
; legacy REGEQU b => R4 ; clp.gas:13
; legacy REGEQU xa => R5 ; clp.gas:14
; legacy REGEQU ya => R6 ; clp.gas:15
; legacy REGEQU za => R7 ; clp.gas:16
; legacy REGEQU xaza => R8 ; clp.gas:17
; legacy REGEQU yaza => R9 ; clp.gas:18
; legacy REGEQU xb => R10 ; clp.gas:19
; legacy REGEQU yb => R11 ; clp.gas:20
; legacy REGEQU zb => R12 ; clp.gas:21
; legacy REGEQU xazb => R13 ; clp.gas:22
; legacy REGEQU yazb => R14 ; clp.gas:23
; legacy REGEQU dataHi => R15 ; clp.gas:24
; legacy REGEQU numEdges => R16 ; clp.gas:25
; legacy REGEQU qa => R17 ; clp.gas:26
; legacy REGEQU qb => R18 ; clp.gas:27
; legacy REGEQU oldab => R19 ; clp.gas:28
; legacy REGEQU numTPoints => R20 ; clp.gas:29
; legacy REGEQU sectorA => R21 ; clp.gas:30
; legacy REGEQU sectorX => R22 ; clp.gas:31
; legacy REGEQU ta => R23 ; clp.gas:32
; legacy REGEQU tb => R24 ; clp.gas:33

; legacy REGEQU fillTEdge => R25 ; clp.gas:35
; legacy REGEQU fillEEdge => R26 ; clp.gas:36

; legacy REGEQU sliceA => R30 ; clp.gas:38
; legacy REGEQU sliceB => R31 ; clp.gas:39

; alternate register storage
; legacy REGEQU endAInsert => R0 ; clp.gas:42
; legacy REGEQU endBInsert => R1 ; clp.gas:43
; legacy REGEQU skpLeft => R2 ; clp.gas:44
; legacy REGEQU skpTop => R3 ; clp.gas:45
; legacy REGEQU skpBottom => R4 ; clp.gas:46
; legacy REGEQU skpRight => R5 ; clp.gas:47

	nop
		;change to 16.16 div
		movei	#G_DIVCTRL, r28
		moveq	#1, r29
		store	r29, (r28)

		nop
		movefa	r31,r29
		moveq	#NUM_EDGES, r28
		add	r29,r28
		loadw	(r28), r16
		movei	#EDGE_LIST, r28
		add	r29,r28
		load		(r28), r0
.if 0
		movei	#tPNTS, r1
		add	r29,r1
		load		(r1),r1
.else
		movefa	r26,r1
.endif
		subqt	#24, r1	; move to sector-z record[-1]

		movei	#tEDGES, r2
		add	r29,r2
		load		(r2),r2
		moveq	#NUM_PNTS, r28
		add	r29,r28
		loadw	(r28), r20
		addqt	#1, r20	; the list starts from 1

		movei	#didAInsert, r28
		moveta	r28, r0
		movei	#didBInsert, r28
		moveta	r28, r1
		movei	#doneRInsert, r28
		moveta	r28, r5
		movei	#doneBInsert, r28
		moveta	r28, r4
		movei	#doneLInsert, r28
		moveta	r28, r2
		movei	#doneTInsert, r28
		moveta	r28, r3

		movei	#edgeGone, r26
		movei	#G_HIDATA, r15
		movei	#clipLp, r27
		movei	#donePack, r25
clipLp:
		load		(r0), r4
		addqt	#4, r0
		move		r4, r19
		move		r4, r3
		shrq		#16, r3
		shlq		#16, r4
		shlq		#5, r3		; make into point address - size to phrase
		shrq		#11, r4
		add		r1, r3
		add		r1, r4
		; get sectors
		loadp	(r3), r21	; read sector, zs
		subqt	#8, r3		; move to x-y record
		move		r21, r28
		load		(r15), r7

		; get the rest of point a while we're here(in this page) - xa, ya, xaz, yaz
		loadp	(r3), r5		; get x-y
		addqt	#16, r3	; move to xaz-yaz record
	cmp	r5, r28
		load		(r15), r6
		loadp	(r3), r8
	cmp	r8, r28
		load		(r15), r9
		; now switch to point b page
		loadp	(r4), r22	; read sector, zs
		subqt	#8, r4		; move to x-y record
		and		r22, r28	; and sectorA, sectorB (is the edge trivially off screen)
		moveq	#0, r24		; set initial endpoints
		jump		NE, (r26)	; not alive (zero out edge)
		xor		r21, r22	; sector cross bits
			moveq	#0, r23		; set initial endpoints
			jump		EQ, (r25)	; if any crossings to compute, compute 'em
			bset		#16, r24		; set initial endpoints
				; finish reading point b
				load		(r15), r12

				loadp	(r4), r10		; get x-y
				addqt	#16, r4	; move to xaz-yaz record
				cmp r10, r28	;--- sync for hidata
				load		(r15), r11
				loadp	(r4), r13
				cmp r13, r28	;--- sync for hidata
				load		(r15), r14
				; cut this one? right ----------------------------
				btst		#RIGHT_EDGE, r22
				movefa	r5, r28
				jump	EQ, (r28)	;nextClip
					; compute the t
					move	r5, r17
					sub	r8, r17
					move	r17, r18	;*
					sub	r10, r18
					abs	r17
					add	r13, r18
					abs	r18		;*
					; normalize - turn result from 16.16 div into a 0.15 result
					shlq	#1, r18	; this is OK because qb was a signed long before the abs and will now only be used by div(unsigned)
					div	r18, r17	;*
					; insert result
					btst	#RIGHT_EDGE, r21
					jr	EQ, bIsBad
					nop	; cause we gota wait for the div anyway
						cmp	r23, r17		; if ta<qa then ta=qa
						jr	CS, doneRInsert
						nop
							move		r17, r23
							moveq	#(1<<RIGHT_EDGE), r30
						jr	doneRInsert
					bIsBad:
						cmp	r24, r17		; if tb>qa then tb=qa
						jr	CC, doneRInsert
						nop
							move		r17, r24
							moveq	#(1<<RIGHT_EDGE), r31
					doneRInsert:
				; cut this one? left -----------------------------
				btst		#LEFT_EDGE, r22
				movefa	r2, r28
				jump	EQ, (r28)	;nextClip
					; compute the t
					move	r5, r17
					add	r8, r17
					move	r17, r18	;*
					sub	r10, r18
					abs	r17
					sub	r13, r18
					abs	r18		;*
					; normalize
					shlq	#1, r18
					div	r18, r17	;*
					; insert result
					btst	#LEFT_EDGE, r21
					jr	EQ, bIsBadL
					nop	; cause we gota wait for the div anyway
						cmp	r23, r17		; if ta<qa then ta=qa
						jr	CS, doneLInsert
						nop
							move		r17, r23
							moveq	#(1<<LEFT_EDGE), r30
						jr	doneLInsert
					bIsBadL:
						cmp	r24, r17		; if tb>qa then tb=qa
						jr	CC, doneLInsert
						nop
							move		r17, r24
							moveq	#(1<<LEFT_EDGE), r31
					doneLInsert:
				; cut this one? bottom ---------------------------
				btst		#BOTTOM_EDGE, r22
				movefa	r4, r28
				jump	EQ, (r28)	;nextClip
					; compute the t
					move	r6, r17
					sub	r9, r17
					move	r17, r18	;*
					sub	r11, r18
					abs	r17
					add	r14, r18
					abs	r18		;*
					; normalize
					shlq	#1, r18
					div	r18, r17	;*
					; insert result
					btst	#BOTTOM_EDGE, r21
					jr	EQ, bIsBadB
					nop	; cause we gota wait for the div anyway
						cmp	r23, r17		; if ta<qa then ta=qa
						jr	CS, doneBInsert
						nop
							move		r17, r23
							moveq	#(1<<BOTTOM_EDGE), r30
						jr	doneBInsert
					bIsBadB:
						cmp	r24, r17		; if tb>qa then tb=qa
						jr	CC, doneBInsert
						nop
							move		r17, r24
							moveq	#(1<<BOTTOM_EDGE), r31
					doneBInsert:
				; cut this one? top ------------------------------
				btst		#TOP_EDGE, r22
				movefa	r3, r28
				jump	EQ, (r28)	;nextClip
					; compute the t
					move	r6, r17
					add	r9, r17
					move	r17, r18	;*
					sub	r11, r18
					abs	r17
					sub	r14, r18
					abs	r18		;*
					; normalize
					shlq	#1, r18
					div	r18, r17	;*
					; insert result
					btst	#TOP_EDGE, r21
					jr	EQ, bIsBadT
					nop	; cause we gota wait for the div anyway
						cmp	r23, r17		; if ta<qa then ta=qa
						jr	CS, doneTInsert
						nop
							move		r17, r23
							moveq	#(1<<TOP_EDGE), r30
						jr	doneTInsert
					bIsBadT:
						cmp	r24, r17		; if tb>qa then tb=qa
						jr	CC, doneTInsert
						nop
							move		r17, r24
							moveq	#(1<<TOP_EDGE), r31
					doneTInsert:
					;fix 'a' cutItOut - change ta=8000 to 7fff
					shlq		#1, r23
					sat16	r23
					shrq		#1, r23
														;btst		#15, ta
														;jr		EQ, weCheckedIt10
														;nop
														;	cutItOut 10
														;weCheckedIt10:
														;btst		#15, tb
														;jr		EQ, weCheckedIt11
														;nop
														;	cutItOut 11
														;weCheckedIt11:
				; test edge existance and zero out if offscreen
				cmp		r23, r24
				jump		MI, (r26)	; not alive (zero out edge)
					; next instr wont hurt
				; compute new point coords
					; reuse some newly worthless registers
; legacy REGEQU edx => r8 ; clp.gas:290
; legacy REGEQU edy => r9 ; clp.gas:291
; legacy REGEQU edz => r13 ; clp.gas:292

; legacy REGEQU wx => r14 ; clp.gas:294
; legacy REGEQU wy => r17 ; clp.gas:295
; legacy REGEQU wz => r18 ; clp.gas:296
					; normalize dx, dy, dz
					sub		r5, r10
					sub		r6, r11
					move		r10, r28
					abs		r28
					move		r11, r29
					abs		r29
					normi	r28, r8
					normi	r29, r9
					addqt	#9, r8
					addqt	#9, r9
					sha		r8, r10
					sha		r9, r11
					neg		r8

					sub		r7, r12
					neg		r9
					move		r12, r28
					abs		r28
					normi	r28, r13
					addqt	#15, r9
					addqt	#9, r13
					addqt	#15, r8
					sha		r13, r12
					neg		r13
					; test sectors
					move		r22, r29
					xor		r21, r29	; is point b bad?
					movefa	r1, r28
					jump		EQ, (r28)
					addqt	#15, r13
						move		r20, r4	; get new b
						shrq		#16, r19	; move over rover to strip b
						addqt	#1, r20	; the list gets bigger
						shlq		#16, r19	; realign
						or		r4, r19
						shlq		#5, r4		; size of point struct
						add		r1, r4		; add tPoints start

						move		r12, r18
						imult	r24, r18
						sha		r13, r18
						add		r7, r18
						store	r18, (r15)
						storep	r31, (r4)
						subqt	#8, r4

						move		r11, r17		; compute new x,y,z
						move		r10, r14
						imult	r24, r17
						imult	r24, r14
						sha		r9, r17
						sha		r8, r14
						add		r6, r17
						add		r5, r14
						store	r17, (r15)
						storep	r14, (r4)
						didBInsert:
					or		r21, r21	; is point a bad?
					movefa	r0, r28
					jump		EQ, (r28)
					move		r20, r3		; get new a
						shlq		#16, r19	; move over rover to allow insertion of new a
						addqt	#1, r20	; the list gets bigger
						or		r3, r19
						rorq		#16, r19	; realign
						shlq		#5, r3		; size of point struct
						add		r1, r3		; add tPoints start

						imult	r23, r12		; compute new x,y,z
						sha		r13, r12
						add		r7, r12
						store	r12, (r15)
						storep	r30, (r3)
						subqt	#8, r3

						imult	r23, r11
						imult	r23, r10
						sha		r9, r11
						sha		r8, r10
						add		r6, r11
						add		r5, r10
						store	r11, (r15)
						storep	r10, (r3)
						didAInsert:
donePack:
		; pack ta,tb
		shlq		#16, r23
		or		r24, r23
		; store a,b
		store	r22, (r15)
		subq		#1, r16
		storep	r19, (r2)
		addqt	#8, r2		; t record
		store	r23, (r2)
		jump		NE, (r27)
		addqt	#8, r2		; next tEDGE
		jr		edgesDone
edgeGone:	; an alternate end to this loop
		; store a,b as NULL
		store	r22, (r15)
		moveq	#0, r19
		subq		#1, r16
		storep	r19, (r2)
		jump		NE, (r27)
		addqt	#16, r2		; next tEDGE

edgesDone:
		; write final number of tPoints
		subqt	#1, r20

		movefa	r31,r29
		movei	#tNUM_EXTRAS, r28
		add	r29,r28
		storew	r20, (r28)

		; update tPNTS array
		movefa	r26,r28
		shlq	#5,r20		; multiply by 32
		add	r20,r28
		moveta	r28,r26

		; check for overflow of TPNTs array
		movei	#ENDTPNTS,r29
		cmp	r28,r29
		jr	PL,nooflow
		nop
			cutItOut 20

nooflow:
		;change from 16.16 div
		movei	#G_DIVCTRL, r28
		moveq	#0, r29
		store	r29, (r28)
; - heap -----------------------------------------------------------
;					; set up for cut
;					move		xa, qa
;					move		xb, qb
;					; compute the t
;					sub	xaza, qa
;					sub	xazb, qb
;					move	qa, qaza
;					sub	qb, qaza
;					; normalize
;					abs	qa
;					abs	qaza

;						neg	qaza
;						neg	qazb
;				; compute the t
;				sub	qaza, qa
;				sub	qazb, qb
;				move	qa, qaza
;				sub	qb, qaza
;				; normalize
;				abs	qa
;				abs	qaza
;				div	qaza, qa
;				; insert
;				btst	#1, sectorA
;				jr	EQ, bIsBad
;				nop
;					cmp	a, qa
;					jr	, aIsOk
;					nop
;						move	qa, a
;					aIsOK:
;
;				bIsBad:
;					cmp	b, qa
;					jr	, bIsOk
;					nop
;						move	qa, b
;					bIsOK:
;
;
;

; END clp.gas
; BEGIN 3to2.gas
; 3to2.gas - performs perspective calculation

; legacy REGEQU x => R0 ; 3to2.gas:3
; legacy REGEQU y => R1 ; 3to2.gas:4
; legacy REGEQU z => R2 ; 3to2.gas:5
; legacy REGEQU xe => R3 ; 3to2.gas:6
; legacy REGEQU ye => R4 ; 3to2.gas:7
; legacy REGEQU ze => R5 ; 3to2.gas:8
; legacy REGEQU Dm => R6 ; 3to2.gas:9
; legacy REGEQU De => R7 ; 3to2.gas:10
; legacy REGEQU D => R8 ; 3to2.gas:11
; legacy REGEQU xCenter => R9 ; 3to2.gas:12
; legacy REGEQU yCenter => R10 ; 3to2.gas:13


; legacy REGEQU pnt => R11 ; 3to2.gas:16
; legacy REGEQU dataHi => R12 ; 3to2.gas:17
; legacy REGEQU numPnts => R13 ; 3to2.gas:18
; legacy REGEQU skipIt => R14 ; 3to2.gas:19
; legacy REGEQU aspect => R15 ; 3to2.gas:20
; legacy REGEQU sectors => R16 ; 3to2.gas:21

; legacy REGEQU numExtras => R17 ; 3to2.gas:23

; legacy REGEQU high => R18 ; 3to2.gas:25
; legacy REGEQU wide => R19 ; 3to2.gas:26
; legacy REGEQU fixH => R20 ; 3to2.gas:27
; legacy REGEQU fixW => R21 ; 3to2.gas:28
; legacy REGEQU backIn => R22 ; 3to2.gas:29

;innerLoop	REGEQU	R27

		nop
		nop
	movei	#around, r14

	movefa	r31,r29
	movei	#tPNTS, r11
	add	r29,r11
	load	(r11),r11
	movei	#G_HIDATA, r12

	movei	#XCENTER,r10
	load	(r10),r9
	addqt	#4,r10
	load	(r10),r10

	movei	#277, r6		; distance from camera to screen - defines FOV
	normi	r6, r7
	subqt	#8, r7		; normalize to 32-bit
	sh		r7, r6
	neg		r7
	subqt	#16, r7	; result in 16.16 format
;	movei	#$ab800000, Dm					; should come from window
;	moveq	#6, De ; 7

.if DOASPECT
	movei	#ASPECTR,r15
	load	(r15),r15
.else
	movei	#$7fff, r15	;782a 78ea
.endif

	movei	#NUM_PNTS, r28
	add		r29,r28
	loadw	(r28), r13

	movei	#tNUM_EXTRAS, r28
	add		r29,r28
	loadw	(r28), r17
	sub		r13, r17

	move		r9, r19
	subqt	#1, r19
	move		r10, r18
	subqt	#1, r18
	movei	#bound1, r21
	movei	#bound2, r20
	movei	#thereOKwithMe, r22

	loadp	(r11), r0
	movei	#perLoop, r27
perLoop:
	; get data
	addqt	#8, r11
		cmp	r0,r0
	load		(r12), r1
	loadp	(r11), r16
	or		r16, r16	; check validity
	load		(r12), r2
	; do it
	jump		NE, (r14) ; don't do behinds
	addqt		#16, r11
		normi	r2, r5		;
		addq		#6, r5	; normalize to 17-bit
		sh		r5, r2	;
		move		r6 ,r8
		div		r2, r8

		add		r7, r5
		move		r0, r28
		move		r1, r29
		abs		r28
		abs		r29
		normi	r28, r3
		normi	r29, r4
		addq		#9, r3
		addq		#9, r4
		sha		r3, r0
		sha		r4, r1
.if DOASPECT
.if DOSCALE
		imult	r15,r0
		sharq	#15,r0
.endif
		imult	r15, r1
		sharq	#15, r1
.endif
		neg		r3
		neg		r4
		add		r5, r3
		add		r5, r4

		imult	r8, r0
		imult	r8, r1
		sha		r3, r0
		sha		r4, r1
		add		r9, r0
		add		r10, r1
		store	r0, (r12)
		storep	r1, (r11)
;				btst		#LEFT_EDGE, sectors
;				jr		EQ, around
;				nop
;					cutItOut $1f
around:
	subq		#1, r13
;	subq		#1, numExtras
	addqt	#8, r11
	jump		NE, (r27) ; perLoop
	loadp	(r11), r0
;		cutItOut 9
; now do the extras -------------------------------------------------------------
	or		r17, r17	; are there any to do?
	movei	#dnPersp, r28
	jump		EQ, (r28)
	cmp r0,r0	; wait for the load to complete

	movei	#ePerLoop, r27
ePerLoop:
	; get data
	addqt	#8, r11
		cmp	r0,r0
	load		(r12), r1
	load		(r11), r2
	; do it
	addqt		#16, r11

	normi	r2, r5		;
	addq		#6, r5	; normalize to 17-bit
	sh		r5, r2	;
	move		r6 ,r8
	div		r2, r8

	add		r7, r5
	move		r0, r28
	move		r1, r29
	abs		r28
	abs		r29
	normi	r28, r3
	normi	r29, r4
	addq		#9, r3
	addq		#9, r4
	sha		r3, r0
	sha		r4, r1
.if DOASPECT
	imult	r15, r1
	sharq	#15, r1
.endif
	neg		r3
	neg		r4
	add		r5, r3
	add		r5, r4

	imult	r8, r0
	imult	r8, r1
	sha		r3, r0
	sha		r4, r1
	; test edges
	move		r0, r28
	move		r1, r29
	abs		r28
	abs		r29
	cmp		r19, r28
	jump		PL, (r21)
	cmp		r18, r29
	jump		PL, (r20)

thereOKwithMe:
	add		r9, r0
	add		r10, r1
	store	r0, (r12)
	storep	r1, (r11)

	subq		#1, r17
	addqt	#8, r11
	jump		NE, (r27) ; ePerLoop
	loadp	(r11), r0

; all done ------------------------------------------------------------------
	movei	#dnPersp, r28
	jump		(r28)
	cmp r0,r0	; wait for the load to complete

	; fix off screen "bad" coords
bound1:	; bound x coord
	btst		#31, r0	; is it negative?
	move		r9, r0
	jump		EQ, (r22)
	subqt	#31, r0	; roll it back to onscreen
		neg	r0	; sign fix
		jump	(r22)
		nop
		
bound2:	; bound y coord
	btst		#31, r1	; is it negative?
	move		r10, r1
	jr		EQ, _CDLOCAL_10_230
	subqt	#31, r1	; roll it back to onscreen
		neg	r1	; sign fix
_CDLOCAL_10_230:
	jump		(r22)
	add		r9, r0
dnPersp:	; exit the module
;		nop
;		nop
;		nop
;		nop
;		nop
;		nop

; cleanup
; GASM REGUNDEF x ; 3to2.gas:243
; GASM REGUNDEF y ; 3to2.gas:244
; GASM REGUNDEF z ; 3to2.gas:245
; GASM REGUNDEF xe ; 3to2.gas:246
; GASM REGUNDEF ye ; 3to2.gas:247
; GASM REGUNDEF ze ; 3to2.gas:248
; GASM REGUNDEF Dm ; 3to2.gas:249
; GASM REGUNDEF De ; 3to2.gas:250
; GASM REGUNDEF D ; 3to2.gas:251
; GASM REGUNDEF xCenter ; 3to2.gas:252
; GASM REGUNDEF yCenter ; 3to2.gas:253
; GASM REGUNDEF pnt ; 3to2.gas:254
; GASM REGUNDEF dataHi ; 3to2.gas:255
; GASM REGUNDEF numPnts ; 3to2.gas:256
; GASM REGUNDEF skipIt ; 3to2.gas:257
; GASM REGUNDEF aspect ; 3to2.gas:258
; GASM REGUNDEF sectors ; 3to2.gas:259
;
;
;
;
;
;
;
; END 3to2.gas
; BEGIN edge.gas
;----------------------------------------------------------------------------
;	edge.gas
;		Edge cut and slope computations
;
;----------------------------------------------------------------------------

; edge stuf(v) --------------------------------------------------------------

;edges	REGEQU	R0
; legacy REGEQU points => R1 ; edge.gas:10
; legacy REGEQU tEdges => R2 ; edge.gas:11
; legacy REGEQU a => R3 ; edge.gas:12
; legacy REGEQU b => R4 ; edge.gas:13
; legacy REGEQU xa => R5 ; edge.gas:14
; legacy REGEQU ya => R6 ; edge.gas:15
; legacy REGEQU xb => R7 ; edge.gas:16
; legacy REGEQU yb => R8 ; edge.gas:17
; legacy REGEQU destHi => R9 ; edge.gas:18
; legacy REGEQU numEdges => R10 ; edge.gas:19
; legacy REGEQU theSign => R11 ; edge.gas:20

;innerLoop	REGEQU	r27

	nop
	nop
		movefa	r31,r29
		movei	#NUM_EDGES, r28
		add	r29,r28
		loadw	(r28), r10

		movei	#tPNTS, r1
		add	r29,r1
		load		(r1),r1
		movei	#tEDGES, r2
		add	r29,r2
		load		(r2),r2

		subqt	#8, r1	; move to 2d-coords record[-1]
		;change to 16.16 div
		movei	#G_DIVCTRL, r28
		moveq	#1, r29
		store	r29, (r28)

		movei	#G_HIDATA, r9
		movei	#edgeLp, r27

		addqt	#4, r2
edgeLp:
		load		(r2), r3
		addqt	#8, r2
		move		r3, r4
		shlq		#16, r4
		shrq		#16, r3
		shrq		#11, r4

		shlq		#5, r3		; make into point address - size to phrase
		add		r1, r4
		add		r1, r3
		loadp	(r4), r8		; read point
	cmp r8,r8
		load		(r9), r7
		loadp		(r3), r6
		sub		r6, r8		; compute deltas
		load		(r9), r5
		sub		r5, r7
		; compute sloop using div
		; store sign
		move		r8, r11
		xor		r7, r11

		abs		r8
		abs		r7

;		shrq		#10, yb	; until 16.16 div is available
;		shlq		#6, xb
		div		r8, r7
		; restore sign

		btst		#31, r11
		jr		EQ, noNeg
		nop
		neg		r7
noNeg:		
		subq		#1, r10
		store	r7, (r2)
		jump		NE, (r27)
		addqt	#8, r2		; next tEDGE

		;change from 16.16 div
;		movei	#G_DIVCTRL, temp
		moveq	#0, r29
		store	r29, (r28)

;
; GASM REGUNDEF edges ; edge.gas:95
; GASM REGUNDEF numEdges ; edge.gas:96
; GASM REGUNDEF theSign ; edge.gas:97
; GASM REGUNDEF destHi ; edge.gas:98
;
;
;
; END edge.gas

	movei	#comploop,r28
	jump	(r28)
	nop

comploopend:


	SaveTimer	$08

	; if there are animation routines, load them
	movei	#animateprg,r28
	load	(r28),r28
	movei	#loadIt,r29
	cmpq	#0,r28
	jump	NE,(r29)
	nop
	; load pre-rendering routines
	movei	#prprog, r28
	jump		(r29)
	nop

; BEGIN subscomp.gas
;
;	SUBROUTINE AREA for beginning overload module
;
; rotVects
;; -----------------------------------------------------------------------
; vector rotate subroutine ----------------------------------------------
;	args:
	; dest	- destination address
	; temp	- number of vectors to rotate
	; source	- source address

; BEGIN rot.inc
;- Rotation register defines ----------------------------------------------

; rotation matrix
; legacy REGEQU m0 => R0 ; rot.inc:4
; legacy REGEQU m1 => R1 ; rot.inc:5
; legacy REGEQU m2 => R2 ; rot.inc:6
; legacy REGEQU m3 => R3 ; rot.inc:7
; legacy REGEQU m4 => R4 ; rot.inc:8
; legacy REGEQU m5 => R5 ; rot.inc:9
; legacy REGEQU m6 => R6 ; rot.inc:10
; legacy REGEQU m7 => R7 ; rot.inc:11
; legacy REGEQU m8 => R8 ; rot.inc:12

; legacy REGEQU xo => R9 ; rot.inc:14
; legacy REGEQU yo => R10 ; rot.inc:15
; legacy REGEQU zo => R11 ; rot.inc:16

; computed data
; legacy REGEQU resultX => R12 ; rot.inc:19
; legacy REGEQU resultY => R13 ; rot.inc:20
; legacy REGEQU resultZ => R14 ; rot.inc:21

; pointers
; legacy REGEQU source => R15 ; rot.inc:24
; legacy REGEQU dest => R16 ; rot.inc:25
; legacy REGEQU dest2 => R17 ; rot.inc:26
; legacy REGEQU dest3 => R18 ; rot.inc:27
; legacy REGEQU numPnts => R19 ; rot.inc:28

; legacy REGEQU x => R20 ; rot.inc:30
; legacy REGEQU y => R21 ; rot.inc:31
; legacy REGEQU z => R22 ; rot.inc:32

; legacy REGEQU xaz => R20 ; rot.inc:34
; legacy REGEQU yaz => R21 ; rot.inc:35
; legacy REGEQU ze => R22 ; rot.inc:36

