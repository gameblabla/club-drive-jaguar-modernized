	addqt	#2,r29
	loadw	(r29),r13		;			nz = normals[i+2];

	nop
					;			pntLast = 3 * edges[2*(polys[0]&0x7fff) + ((polys[0]<0) ? 1:0)];
	loadw	(r4),r28
	moveq	#6,r29
	btst	#15,r28
	jr	EQ,nega0
	bclr	#15,r28
		shlq	#2,r28
		jr	posi0
		addqt	#2,r28
nega0:
	shlq	#2,r28
posi0:
	add	r2,r28
	loadw	(r28),r18
