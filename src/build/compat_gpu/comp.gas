; legacy REGEQU i => r8 ; mktp.gas:12
; legacy REGEQU cp => r9 ; mktp.gas:13
; legacy REGEQU numSides => r10 ; mktp.gas:14
; legacy REGEQU nx => r11 ; mktp.gas:15
; legacy REGEQU ny => r12 ; mktp.gas:16
; legacy REGEQU nz => r13 ; mktp.gas:17
; legacy REGEQU avgX => r14 ; mktp.gas:18
; legacy REGEQU avgY => r15 ; mktp.gas:19
; legacy REGEQU avgZ => r16 ; mktp.gas:20
