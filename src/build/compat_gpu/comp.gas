; legacy REGEQU pntLast => r18 ; mktp.gas:22
; legacy REGEQU distance => r19 ; mktp.gas:23
; legacy REGEQU maxDistance => r20 ; mktp.gas:24
; legacy REGEQU bnd => r21 ; mktp.gas:25
; legacy REGEQU pnt0 => r22 ; mktp.gas:26
; legacy REGEQU pnt1 => r23 ; mktp.gas:27
; legacy REGEQU pnt2 => r24 ; mktp.gas:28
; legacy REGEQU outerLoop => r25 ; mktp.gas:29
; legacy REGEQU endLoop => r26 ; mktp.gas:30
; regs r27-r29 reserved for global use
; legacy REGEQU temp3 => r30 ; mktp.gas:32
; legacy REGEQU temp1 => r31 ; mktp.gas:33
; alternate register usage
; legacy REGEQU vx => r0 ; mktp.gas:35
; legacy REGEQU vy => r1 ; mktp.gas:36
; legacy REGEQU vz => r2 ; mktp.gas:37
; legacy REGEQU ALTpnt0 => r3 ; mktp.gas:38
; legacy REGEQU ALTpnt1 => r4 ; mktp.gas:39
; legacy REGEQU ALTpnt2 => r5 ; mktp.gas:40
; legacy REGEQU ALTminx => r6 ; mktp.gas:41
; legacy REGEQU ALTmaxx => r7 ; mktp.gas:42
