	moveq	#0,r15
	moveq	#0,r16

	moveq	#0,r8			;			for (i=0; i<numSides; i++) {
innerfor:

	move	r8,r28
	shlq	#1,r28
	add	r4,r28		;				pnt = 3 * edges[2*(polys[i]&0x7fff) + ((polys[i]>=0) ? 1:0)];
	loadw	(r28),r28
	moveq	#6,r29
	btst	#15,r28
	jr	NE,negative
	bclr	#15,r28
		shlq	#2,r28
		jr	positive
