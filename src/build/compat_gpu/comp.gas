; BEGIN mktp.gas
;
; Calculate edge normals for newly created world
;
; legacy REGEQU normals => r0 ; mktp.gas:4
; legacy REGEQU dividers => r1 ; mktp.gas:5
; legacy REGEQU edges => r2 ; mktp.gas:6
; legacy REGEQU points => r3 ; mktp.gas:7
; legacy REGEQU polys => r4 ; mktp.gas:8
; legacy REGEQU tPolys => r5 ; mktp.gas:9
; legacy REGEQU polyBase => r6 ; mktp.gas:10
