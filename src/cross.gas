Loop_01_15:
		Get_Pixels2
		Get_15_01
		store	outpix,(g_hi)
		storep	outpix2,(dest)
		addq		#4,pic1_adr				;go to next pixel
		addq		#4,pic2_adr				;go to next pixel
		cmp		pic1_end,pic1_adr			;see if at end address yet
		jump		NE,(jump_table_addr)		;if not, change next pixel
		addq		#8,dest					;go to next pixel (this can be here instead of NOP)
		Reloop
	
Loop_00_16:
		Get_Pixels2
		store	Pixel_a,(g_hi)
		storep	Pixel_a2,(dest)
		addq		#4,pic1_adr				;go to next pixel
		addq		#4,pic2_adr				;go to next pixel
		cmp		pic1_end,pic1_adr			;see if at end address yet
		jr		NE,Loop_00_16				;if not, change next pixel
		addq		#8,dest					;go to next pixel (this can be here instead of NOP)
		Reloop


.phrase
jmp_table:

dc.w (Loop_16_00 & $ffff), (Loop_16_00 >> 16)
dc.w (Loop_15_01 & $ffff), (Loop_15_01 >> 16)
dc.w (Loop_14_02 & $ffff), (Loop_14_02 >> 16)
dc.w (Loop_13_03 & $ffff), (Loop_13_03 >> 16)
dc.w (Loop_12_04 & $ffff), (Loop_12_04 >> 16)
dc.w (Loop_11_05 & $ffff), (Loop_11_05 >> 16)
dc.w (Loop_10_06 & $ffff), (Loop_10_06 >> 16)
dc.w (Loop_09_07 & $ffff), (Loop_09_07 >> 16)
dc.w (Loop_08_08 & $ffff), (Loop_08_08 >> 16)
dc.w (Loop_07_09 & $ffff), (Loop_07_09 >> 16)
dc.w (Loop_06_10 & $ffff), (Loop_06_10 >> 16)
dc.w (Loop_05_11 & $ffff), (Loop_05_11 >> 16)
dc.w (Loop_04_12 & $ffff), (Loop_04_12 >> 16)
dc.w (Loop_03_13 & $ffff), (Loop_03_13 >> 16)
dc.w (Loop_02_14 & $ffff), (Loop_02_14 >> 16)
